    private static string GetExtraQuantityText(PendingExtraSelection selection) => selection.CycleStep switch
    {
        1 => "ΠΟΛΥ",
        2 => "ΠΑΡΑ ΠΟΛΥ",
        3 => "ΛΙΓΟ",
        _ => ""
    };

    private static string GetExtraSelectionText(PendingExtraSelection selection)
    {
        var parts = new List<string>();
        if (selection.Mode is "Χωρίς" or "Μόνο") parts.Add(selection.Mode.ToUpperInvariant());
        var quantity = GetExtraQuantityText(selection);
        if (!string.IsNullOrWhiteSpace(quantity)) parts.Add(quantity);
        return string.Join(" · ", parts);
    }

    private string BuildExtraNote(ExtraOption extra, PendingExtraSelection selection)
    {
        var modePrefix = selection.Mode switch
        {
            "Χωρίς" => "ΧΩΡΙΣ ",
            "Μόνο" => "ΜΟΝΟ ",
            _ => ""
        };
        var quantityPrefix = GetExtraQuantityText(selection);
        if (!string.IsNullOrWhiteSpace(quantityPrefix)) quantityPrefix += " ";
        return $"{modePrefix}{quantityPrefix}{extra.Name}";
    }

