    .invoice-pin-box .invoice-actions {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 20px;
    }

    .invoice-pin-box .invoice-submit-btn {
        width: 100%;
        min-height: 46px;
        padding: 10px 15px;
        border: 0;
        border-radius: 10px;
        background: #1f2a44;
        color: #fff;
        font-size: .93rem;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(31,42,68,.17);
        transition: all .15s ease;
    }

        .invoice-pin-box .invoice-submit-btn:hover {
            background: #172137;
            transform: translateY(-1px);
        }

    .invoice-pin-box .invoice-back-btn {
        align-self: center;
        margin-top: 1px;
    }

    @@media (max-width: 560px) {
        .pin-box.invoice-pin-box {
            width: calc(100vw - 20px);
            padding: 20px;
        }

        .invoice-pin-box .invoice-grid {
            grid-template-columns: 1fr;
        }
    }

    .send-btn.sending,
    .send-btn:disabled.sending {
        background: #a9a9a9 !important;
        color: #ffffff !important;
        cursor: not-allowed;
        opacity: 1;
    }

        .send-btn.sending:hover,
        .send-btn:disabled.sending:hover {
            background: #a9a9a9 !important;
            transform: none;
        }

    .table-order-page {
        width: 100vw;
        min-height: calc(100vh - 70px);
        margin-left: calc(50% - 50vw);
        padding: 18px;
        box-sizing: border-box;
        background:
            radial-gradient(ellipse at 10% 0%, rgba(255,255,255,.70), transparent 38%),
            linear-gradient(135deg,
                color-mix(in srgb, var(--order-page-bg, #eaf1fb) 22%, #edf4ff),
                color-mix(in srgb, var(--order-page-bg, #eaf1fb) 22%, #dce9f8));
        position: relative;
    }

    .table-order-page > h2 { color:#172b4d; letter-spacing:-.025em; }
    .table-order-page .category-panel,
    .table-order-page .products-panel-header,
    .table-order-page .order-panel {
        border:1px solid rgba(207,220,239,.9);
        box-shadow:0 6px 18px rgba(33,58,94,.09);
    }
    .table-order-page .category-panel,
    .table-order-page .products-panel-header,
    .table-order-page .order-panel { border-radius:14px; }
    .table-order-page .menu-item-btn {
        border-color:#d7e1ef;
        border-radius:12px;
        box-shadow:0 4px 12px rgba(33,58,94,.07);
        transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .table-order-page .menu-item-btn:hover {
        transform:translateY(-1px);
        border-color:#9eb4d5;
        box-shadow:0 7px 16px rgba(33,58,94,.12);
    }
    .table-order-page .menu-item-btn { touch-action:pan-y; user-select:none; -webkit-user-select:none; }

    .order-background-menu {
        position: fixed;
        z-index: 6000;
        width: 280px;
        background: #fff;
        border: 1px solid #d8dde6;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 12px 35px rgba(0,0,0,.22);
    }

        .order-background-menu h4 {
            margin: 0 0 12px;
        }

    .order-background-field {
        margin: 10px 0;
    }

        .order-background-field label {
            display: block;
            font-size: .82rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .order-background-field input[type=color] {
            width: 100%;
            height: 44px;
            border: 1px solid #ccd2dc;
            border-radius: 9px;
            padding: 3px;
            cursor: pointer;
        }

    .order-background-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

        .order-background-actions button {
            flex: 1;
            min-height: 42px;
            border: 0;
            border-radius: 9px;
            font-weight: 700;
            cursor: pointer;
        }

    .order-background-reset {
        background: #eef1f5;
        color: #263246;
    }

    .order-background-save {
        background: #1f2a44;
        color: #fff;
    }


    /* POS layout: categories left, products center, order right */
    html, body {
        overflow-x: hidden;
    }

    .table-order-page {
        width: 100vw;
        max-width: 100vw;
        min-height: calc(100dvh - 52px);
        margin-left: calc(50% - 50vw);
        padding: 18px;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    @@media (min-width: 821px) {
        .table-order-page {
            height: calc(100dvh - 62px);
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .table-order-page > .nav-button,
        .table-order-page > h2 { flex: 0 0 auto; }

        .order-layout {
            flex: 1 1 auto;
            min-height: 0;
            align-items: stretch;
            overflow: hidden;
        }

        .category-panel,
        .products-panel,
        .order-panel {
            height: auto;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        .category-panel { position: static; align-self: start; }
        .order-panel { max-height: none; }

        .category-choice { min-height: 42px; padding: 7px 10px; }
        .products-panel .item-grid { gap: 7px; }
        .menu-item-card, .extra-tile-wrap {
            width: clamp(112px, calc(128px * var(--tile-scale,1)), 256px);
        }
        .menu-item-card .menu-item-btn, .extra-tile-wrap > .menu-item-btn {
            min-height: calc(68px * var(--tile-scale,1));
        }
    }

    .order-layout {
        display: grid !important;
        grid-template-columns: minmax(190px, min(var(--category-panel-width, 190px), calc(100vw - 380px))) minmax(0, 1fr) 330px !important;
        gap: 14px;
        align-items: start;
    }

    .category-panel {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        background: rgba(255,255,255,.94);
        border-radius: 12px;
        padding: 10px;
        box-sizing: border-box;
        position: sticky;
        top: 12px;
        overflow: visible;
        height: fit-content;
        align-self: start;
    }

    .category-panel-title {
        margin: 2px 6px 9px;
        font-size: .82rem;
        font-weight: 800;
        color: #586174;
        text-transform: uppercase;
    }

    .category-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        height: auto;
        min-height: 0;
        justify-content: flex-start;
    }

    .category-choice {
        box-sizing: border-box;
        max-width: 100%;
        min-height: 48px;
        padding: 10px 12px;
        border: 1px solid #d7dce5;
        border-radius: 9px;
        background: #fff;
        color: #202736;
        font: inherit;
        font-weight: 800;
        text-align: left;
        cursor: pointer;
        transition: .15s ease;
    }

        .category-choice:hover {
            border-color: #1f2a44;
        }

        .category-choice.active {
            background: #1f2a44;
            color: #fff;
            border-color: #1f2a44;
        }

    .products-panel {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .products-panel-header {
        margin: 0 0 10px;
        padding: 10px 12px;
        background: rgba(255,255,255,.94);
        border-radius: 10px;
        font-weight: 800;
        color: #202736;
    }
    .products-panel-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .category-extra-trigger { display:flex; align-items:center; gap:8px; min-height:42px; padding:9px 16px; border:0; border-radius:10px; background:#1f2a44; color:#fff; font:inherit; font-weight:800; cursor:pointer; }
    .category-extra-trigger span { font-size:.83rem; font-weight:600; opacity:.82; }
    .order-extra-trigger { width:100%; justify-content:center; margin:0 0 12px; }
    .products-extra-footer {
        position: sticky;
        bottom: 0;
        z-index: 5;
        display: flex;
        flex: 0 0 auto;
        justify-content: center;
        margin-top: auto;
        padding: 12px 0 max(4px, env(safe-area-inset-bottom));
        background: linear-gradient(180deg, rgba(234,241,251,0), rgba(234,241,251,.96) 35%);
    }
    .products-extra-trigger { width:100%; min-height:52px; justify-content:center; align-self:stretch; border:2px solid #1f2a44; background:#fff; color:#1f2a44; box-shadow:0 4px 14px rgba(31,42,68,.18); }
    .products-extra-trigger:hover { background:#1f2a44; color:#fff; }
    .item-comment-overlay { position:fixed; inset:0; z-index:10001; display:flex; align-items:center; justify-content:center; padding:18px; background:rgba(17,24,39,.58); box-sizing:border-box; }
    .item-comment-dialog { width:min(560px,100%); padding:24px; border:1px solid #e1e7f0; border-radius:18px; background:#fff; color:#202736; box-shadow:0 24px 70px rgba(12,20,36,.25); box-sizing:border-box; }
    .item-comment-dialog h3 { margin:0 0 6px; color:#1f2a44; }
