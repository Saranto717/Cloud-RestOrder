    private void DropMenuItem(int targetId)
    {
        if (!layoutEditing || draggedMenuItemId is not int draggedId || !itemsByCategory.TryGetValue(selectedCategoryId, out var list)) return;
        var ordered = list.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name).ToList();
        var from = ordered.FindIndex(x => x.Id == draggedId);
        var to = ordered.FindIndex(x => x.Id == targetId);
        if (from >= 0 && to >= 0 && from != to)
        {
            // A tile dropped onto another tile exchanges positions with it.
            (ordered[from], ordered[to]) = (ordered[to], ordered[from]);
            for (var i = 0; i < ordered.Count; i++) ordered[i].DisplayOrder = i;
            itemsByCategory[selectedCategoryId] = ordered;
        }
        draggedMenuItemId = null;
        layoutSelectedMenuItemId = null;
    }

    private void DropExtra(int targetId)
    {
        if (!extrasLayoutEditing || draggedExtraId is not int draggedId) return;
        var ordered = allExtras.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name).ToList();
        var from = ordered.FindIndex(x => x.Id == draggedId);
        var to = ordered.FindIndex(x => x.Id == targetId);
        if (from >= 0 && to >= 0 && from != to)
        {
            // Match the products layout: dropping onto a tile swaps the pair.
            (ordered[from], ordered[to]) = (ordered[to], ordered[from]);
            for (var i = 0; i < ordered.Count; i++) ordered[i].DisplayOrder = i;
            allExtras = ordered;
        }
        draggedExtraId = null;
        layoutSelectedExtraId = null;
    }

    private async Task SaveLayoutAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var menuItems = itemsByCategory.Values.SelectMany(x => x).DistinctBy(x => x.Id).ToList();
        var menuIds = menuItems.Select(x => x.Id).ToHashSet();
        var savedMenuItems = await db.MenuItems.Where(x => menuIds.Contains(x.Id)).ToListAsync();
        foreach (var item in menuItems)
        {
            var saved = savedMenuItems.FirstOrDefault(x => x.Id == item.Id);
            if (saved is not null) { saved.DisplayOrder = item.DisplayOrder; saved.TileScale = item.TileScale; }
        }
        await db.SaveChangesAsync();
        layoutEditing = false;
        originalMenuLayout.Clear();
    }

    private async Task SaveExtraLayoutAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var extraIds = allExtras.Select(x => x.Id).ToHashSet();
        var savedExtras = await db.ExtraOptions.Where(x => extraIds.Contains(x.Id)).ToListAsync();
        foreach (var extra in allExtras)
        {
            var saved = savedExtras.FirstOrDefault(x => x.Id == extra.Id);
            if (saved is not null) { saved.DisplayOrder = extra.DisplayOrder; saved.TileScale = extra.TileScale; }
        }
        await db.SaveChangesAsync();
        extrasLayoutEditing = false;
        originalExtraLayout.Clear();
    }

    private void CancelLayoutEditing()
    {
        foreach (var item in itemsByCategory.Values.SelectMany(x => x).DistinctBy(x => x.Id))
            if (originalMenuLayout.TryGetValue(item.Id, out var original)) { item.DisplayOrder = original.Order; item.TileScale = original.Scale; }
        foreach (var key in itemsByCategory.Keys.ToList())
            itemsByCategory[key] = itemsByCategory[key].OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name).ToList();
        layoutEditing = false;
        originalMenuLayout.Clear();
        draggedMenuItemId = null;
    }

    private void CancelExtraLayoutEditing()
    {
        foreach (var extra in allExtras)
            if (originalExtraLayout.TryGetValue(extra.Id, out var original)) { extra.DisplayOrder = original.Order; extra.TileScale = original.Scale; }
        allExtras = allExtras.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name).ToList();
        extrasLayoutEditing = false;
        originalExtraLayout.Clear();
        draggedExtraId = null;
    }

