            .Where(i => selectedOrderItemIds.Contains(i.Id) && !i.IsCancelled && RemainingQuantityForItem(i) > 0)
            .ToList();
        if (selected.Count == 0) return;

        var active = order.Items.Where(i => !i.IsCancelled && RemainingQuantityForItem(i) > 0).ToList();
        if (selected.Count == 1)
        {
            BeginCancelItem(selected[0]);
            return;
        }

        if (selected.Count == active.Count)
        {
            selectionMode = false;
            selectedOrderItemIds.Clear();
            BeginCancelWholeOrder();
            return;
        }

        selectedCancellationQuantities = selected.ToDictionary(i => i.Id, RemainingQuantityForItem);
        selectedCancellationError = null;
        showSelectedCancelModal = true;
