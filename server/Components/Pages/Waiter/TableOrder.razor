    private bool showLeaveTableConfirm;
    private bool leavingTable;
    private bool allowLeaveTableNavigation;
    private IDisposable? locationChangingRegistration;
    private string? leaveTableError;
    private bool tableTransferBusy;
    private int tableTransferTargetId;
    private string? tableTransferMessage;
    private TableTransfer? pendingTableTransfer;
    private List<RestaurantTable> tableTransferTargets = new();
    private HashSet<int> occupiedTransferTargets = new();
    private CancellationTokenSource? menuItemLongPressCts;
    private long? menuItemLongPressPointerId;
    private int? suppressedMenuItemClickId;
    private DateTime suppressedMenuItemClickUntilUtc;

    protected override void OnInitialized()
    {
        locationChangingRegistration = Nav.RegisterLocationChangingHandler(HandleInternalNavigation);
    }

    private void RequestLeaveTable()
    {
        if (RequiresLeaveConfirmation)
        {
            leaveTableError = null;
            showLeaveTableConfirm = true;
            return;
        }

        Nav.NavigateTo("/waiter", forceLoad: true);
    }

    private ValueTask HandleInternalNavigation(LocationChangingContext context)
    {
        if (allowLeaveTableNavigation || !RequiresLeaveConfirmation)
            return ValueTask.CompletedTask;

        var target = Nav.ToBaseRelativePath(context.TargetLocation).Split('?', '#')[0].Trim('/');
        var current = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        if (string.Equals(target, current, StringComparison.OrdinalIgnoreCase))
            return ValueTask.CompletedTask;

        context.PreventNavigation();
        leaveTableError = null;
        showLeaveTableConfirm = true;
        StateHasChanged();
        return ValueTask.CompletedTask;
    }

    public void Dispose()
    {
        locationChangingRegistration?.Dispose();
        locationChangingRegistration = null;
        menuItemLongPressCts?.Cancel();
    }

    private async Task HandleMenuItemClickAsync(MenuItem item)
    {
        if (suppressedMenuItemClickId == item.Id && DateTime.UtcNow <= suppressedMenuItemClickUntilUtc)
        {
            suppressedMenuItemClickId = null;
            return;
        }

        suppressedMenuItemClickId = null;
        if (layoutEditing)
        {
            SelectMenuItemForLayout(item.Id);
            return;
        }

        await HandleMenuItemTap(item);
    }

    private void IgnoreMenuItemContextMenu() { }

    private async Task HandleMenuItemPointerDownAsync(MenuItem item, PointerEventArgs e)
    {
        if (layoutEditing) return;

        // Desktop right-click remains a quick way to open the comment box.
        if (e.PointerType == "mouse")
        {
            if (e.Button == 2)
                await OpenItemCommentAsync(item);
            return;
        }

        if (e.PointerType is not ("touch" or "pen")) return;

        menuItemLongPressCts?.Cancel();
        var cancellation = new CancellationTokenSource();
        menuItemLongPressCts = cancellation;
        menuItemLongPressPointerId = e.PointerId;

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(550), cancellation.Token);
            if (layoutEditing || !ReferenceEquals(menuItemLongPressCts, cancellation)) return;

            // Mobile browsers may synthesize a click after the long press; consume it so
            // the product is not added before the comment is entered.
            suppressedMenuItemClickId = item.Id;
            suppressedMenuItemClickUntilUtc = DateTime.UtcNow.AddSeconds(2);
            await OpenItemCommentAsync(item);
        }
        catch (OperationCanceledException)
        {
            // A short tap, scroll, or released pointer cancels the long-press action.
        }
        finally
        {
            if (ReferenceEquals(menuItemLongPressCts, cancellation))
            {
                menuItemLongPressCts = null;
                menuItemLongPressPointerId = null;
            }
            cancellation.Dispose();
        }
    }

    private void CancelMenuItemLongPress(PointerEventArgs e)
    {
        if (menuItemLongPressPointerId != e.PointerId || menuItemLongPressCts is null) return;
        var cancellation = menuItemLongPressCts;
        menuItemLongPressCts = null;
        menuItemLongPressPointerId = null;
        cancellation.Cancel();
    }

    private void CancelLeaveTable()
    {
        if (leavingTable) return;
        showLeaveTableConfirm = false;
        leaveTableError = null;
    }

    private async Task ConfirmLeaveTableAsync()
    {
        if (leavingTable) return;
        leavingTable = true;
        leaveTableError = null;
        try
        {
            using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
            if (!await EnsureCurrentTableAvailable())
            {
                leaveTableError = "Δεν είναι δυνατή η έξοδος όσο εκκρεμεί μεταφορά τραπεζιού.";
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            if (isTakeAwayMode && HasSentTakeAwayItems)
            {
                leaveTableError = "Τα είδη έχουν ήδη σταλεί. Ολοκλήρωσε την πληρωμή και την απόδειξη πριν φύγεις.";
                return;
            }
            var pendingItems = await db.OrderItems
                .Where(i => i.OrderId == order.Id && !i.IsPrinted && !i.IsCancelled)
                .ToListAsync();
            db.OrderItems.RemoveRange(pendingItems);
            if (isTakeAwayMode)
            {
                var draftOrder = await db.Orders.Include(o => o.Payments)
                    .FirstOrDefaultAsync(o => o.Id == order.Id && o.Status == OrderStatus.Open);
                if (draftOrder is not null && draftOrder.Payments.Count == 0 && draftOrder.FiscalStatus == FiscalStatus.NotIssued)
                    db.Orders.Remove(draftOrder);
                var takeAwayTable = await db.Tables.FindAsync(TableId);
                if (takeAwayTable is { IsTakeAway: true } && !await db.Orders.AnyAsync(o => o.RestaurantTableId == TableId && o.Id != order.Id))
                    db.Tables.Remove(takeAwayTable);
            }
            await db.SaveChangesAsync();

            showLeaveTableConfirm = false;
            allowLeaveTableNavigation = true;
            Nav.NavigateTo("/waiter", forceLoad: true);
        }
        catch
        {
            leaveTableError = "Δεν ολοκληρώθηκε η διαγραφή. Παραμένεις στο τραπέζι· δοκίμασε ξανά.";
        }
        finally
        {
            leavingTable = false;
        }
    }

    private async Task<bool> EnsureCurrentTableAvailable()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        pendingTableTransfer = await db.TableTransfers.AsNoTracking().FirstOrDefaultAsync(t =>
            t.Stage != TableTransferStage.Completed && t.Stage != TableTransferStage.Rejected &&
            (t.SourceTableId == TableId || t.TargetTableId == TableId));
        if (pendingTableTransfer is not null)
        {
            tableTransferMessage = pendingTableTransfer.LastError;
            showTableTransferModal = true;
            return false;
        }
        if (!await db.Orders.AnyAsync(o => o.Id == order.Id && o.RestaurantTableId == TableId && o.Status == OrderStatus.Open))
        {
            Nav.NavigateTo("/waiter");
            return false;
        }
        return true;
    }

    private async Task BeginTableTransfer()
    {
        if (!await EnsureCurrentTableAvailable()) return;
        tableTransferMessage = null;
        Nav.NavigateTo($"/waiter?transferFrom={TableId}&transferOrder={order.Id}");
    }

    private async Task ConfirmTableTransfer()
    {
        if (tableTransferBusy || tableTransferTargetId <= 0) return;
        tableTransferBusy = true;
        try { await HandleTransferResult(await Transfers.MoveAllAsync(order.Id, tableTransferTargetId, currentUserId)); }
        catch (Exception) { tableTransferMessage = "Η μεταφορά δεν επιβεβαιώθηκε λόγω σφάλματος σύνδεσης ή αποθήκευσης. Ανανέωσε τη σελίδα και έλεγξε τυχόν εκκρεμή μεταφορά πριν συνεχίσεις."; }
        finally { tableTransferBusy = false; }
    }

    private async Task RecheckTableTransfer()
    {
        if (tableTransferBusy || pendingTableTransfer is null) return;
        tableTransferBusy = true;
        try { await HandleTransferResult(await Transfers.RecheckAsync(pendingTableTransfer.Id)); }
        catch (Exception) { tableTransferMessage = "Δεν ολοκληρώθηκε ο επανέλεγχος. Η εκκρεμής μεταφορά διατηρείται· δοκίμασε τον επανέλεγχο ξανά όταν αποκατασταθεί η σύνδεση."; }
        finally { tableTransferBusy = false; }
    }

    private async Task HandleTransferResult(TableTransferResult result)
    {
        tableTransferMessage = result.Message;
        if (result.Success) { Nav.NavigateTo($"/waiter/table/{result.TargetTableId}", forceLoad: true); return; }
        if (result.Pending && result.TransferId is not null)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            pendingTableTransfer = await db.TableTransfers.AsNoTracking().FirstOrDefaultAsync(t => t.Id == result.TransferId);
        }
        else if (pendingTableTransfer is not null)
        {
            var wasSource = pendingTableTransfer.SourceTableId == TableId;
            pendingTableTransfer = null;
            if (!wasSource) { Nav.NavigateTo("/waiter"); return; }
            await BeginTableTransfer(); tableTransferMessage = result.Message;
        }
    }

    private static List<PrinterStation> GetCategoryPrinters(MenuCategory? category)
    {
        if (category is null) return new List<PrinterStation>();

        var stations = category.PrinterStations?.ToList() ?? new List<PrinterStation>();
        if (category.PrinterStation is not null && stations.All(s => s.Id != category.PrinterStation.Id))
            stations.Add(category.PrinterStation);

        return stations.DistinctBy(s => s.Id).ToList();
    }

