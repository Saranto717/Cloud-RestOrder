            margin-top: 0 !important;
            box-sizing: border-box;
            height: 100% !important;
            max-height: 100% !important;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden !important;
            overscroll-behavior: contain;
        }

        .order-panel > h3,
        .order-panel > .total,
        .order-panel > button,
        .order-panel > .order-action-row,
        .order-panel > .order-action-stack,
        .order-panel > .order-comment-box,
        .order-panel > .action-button-color-hint {
            flex: 0 0 auto;
        }

        .order-panel > .order-list {
            flex: 2 1 190px;
            min-height: 150px;
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

        /* Give sent order batches a useful, always visible area in the POS sidebar. */
        .order-panel { padding: 10px !important; }
        .order-panel > .total { margin: 5px 0 8px; }
        .order-panel > .send-btn,
        .order-panel > button.order-action-btn,
        .order-panel > .order-action-row,
        .order-panel > .order-action-stack { margin-top: 4px !important; }
        .order-panel > .send-btn,
        .order-panel > button.order-action-btn,
        .order-panel .order-action-btn {
            min-height: 34px;
            padding-top: 5px;
            padding-bottom: 5px;
            font-size: .78rem;
            line-height: 1.1;
        }
        .order-panel .order-action-row { gap: 5px; }
        .order-panel .order-action-column { grid-template-rows: repeat(3, minmax(34px, auto)); gap: 4px; }
        .order-panel .action-icon { margin-right: .2em; }
        .order-panel .order-comment-box { gap: 4px; margin: 5px 0 2px; }
        .order-panel .order-comment-box textarea { min-height: 42px; padding: 5px 7px; }
        .order-panel .order-comment-box small,
        .order-panel > .action-button-color-hint { display: none; }
    .table-order-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .table-order-heading h2 { margin:.5rem 0; }
    .appearance-admin-tools { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .appearance-admin-tools small { flex-basis:100%; color:#55647b; }
    }
    /* Keep the same three-panel POS layout while fitting compact laptop viewports. */
    @@media (min-width: 821px) and (max-width: 1366px) {
        .table-order-page { padding: 6px 8px 8px !important; }
        .table-order-page .table-order-heading { margin: 0 0 6px; }
        .table-order-page .table-order-heading h2 { margin: 0; font-size: clamp(1rem, 1.35vw, 1.2rem); }
        .order-layout {
            grid-template-columns: minmax(132px, min(var(--category-panel-width, 174px), 16vw)) minmax(0, 1fr) clamp(248px, 23vw, 300px) !important;
            gap: clamp(6px, .7vw, 10px);
        }
        .category-panel, .order-panel { padding: 8px !important; }
        .category-choice { min-height: 38px; padding: 6px 8px; }
        .products-panel-header { margin-bottom: 7px; padding: 8px 10px; }
        .products-panel .item-grid { gap: 6px; }
        .menu-item-card, .extra-tile-wrap { width: clamp(102px, calc(9vw * var(--tile-scale, 1)), 248px); }
        .menu-item-card .menu-item-btn, .extra-tile-wrap > .menu-item-btn { min-height: clamp(54px, calc(8vh * var(--tile-scale, 1)), 144px); }
    }

    @@media (min-width: 821px) and (max-height: 820px) {
        .table-order-page { height: calc(100dvh - 62px) !important; padding-top: 4px !important; padding-bottom: 5px !important; }
        .table-order-page .table-order-heading { margin-bottom: 4px; }
        .category-panel { padding: 6px !important; }
        .category-panel-title { margin: 1px 4px 5px; }
        .category-list { gap: 4px; }
        .category-choice { min-height: 32px; padding: 4px 7px; }
        .products-panel-header { padding: 6px 8px; }
        .products-panel .menu-item-btn, .menu-item-card .menu-item-btn, .extra-tile-wrap > .menu-item-btn { min-height: 54px; padding-top: 6px; padding-bottom: 6px; }
    }

    .table-order-page.has-venue-image { background-image:linear-gradient(135deg,rgba(232,240,251,.92),rgba(211,226,246,.84)),var(--venue-image); background-size:cover; background-position:center; }
</style>

<div class="table-order-page @(venueImage is null ? "" : "has-venue-image")" style="--order-page-bg:@pageBackground;--venue-image:url('@venueImage')" @onclick="CloseCustomizationMenus" @oncontextmenu="OpenOrderBackgroundMenu" @oncontextmenu:preventDefault="true">

    @if (showOrderBackgroundMenu)
    {
        <div class="order-background-menu" style="left:@(orderBackgroundMenuX)px; top:@(orderBackgroundMenuY)px" @onclick:stopPropagation="true">
            <h4>🎨 Φόντο τραπεζιού</h4>
            <div class="order-background-field">
                <label>Χρώμα φόντου</label>
                <input type="color" @bind="editingPageBackground" />
            </div>
            <div class="order-background-actions">
                <button class="order-background-reset" @onclick="ResetOrderBackground">Επαναφορά στο φόντο τραπεζιών</button>
                <button class="order-background-save" @onclick="SaveOrderBackground">Αποθήκευση</button>
            </div>
        </div>
    }

    @if (showCategoryCustomizationMenu)
    {
        <div class="category-customization-menu"
             style="left:@(categoryCustomizationX)px; top:@(categoryCustomizationY)px"
             @onclick:stopPropagation="true">
            <h4>🎨 Μορφοποίηση κατηγορίας</h4>

            <div class="category-customization-field">
                <label>Γέμισμα</label>
                <input type="color" @bind="editingCategoryStyle.Background" />
            </div>

            <div class="category-customization-row">
                <div class="category-customization-field">
                    <label>Χρώμα κειμένου</label>
                    <input type="color" @bind="editingCategoryStyle.TextColor" />
                </div>
                <div class="category-customization-field">
                    <label>Χρώμα περιγράμματος</label>
                    <input type="color" @bind="editingCategoryStyle.BorderColor" />
                </div>
            </div>

            <div class="category-customization-row">
                <div class="category-customization-field">
                    <label>Πλάτος (px)</label>
                    <input type="number" min="80" max="500" @bind="editingCategoryStyle.Width" />
                </div>
                <div class="category-customization-field">
                    <label>Ύψος (px)</label>
                    <input type="number" min="32" max="180" @bind="editingCategoryStyle.Height" />
                </div>
            </div>

            <div class="category-customization-field">
                <label>Μέγεθος γραμματοσειράς (px)</label>
                <input type="number" min="10" max="40" @bind="editingCategoryStyle.FontSize" />
            </div>

            <label class="category-customization-bold">
                <input type="checkbox" @bind="editingCategoryStyle.Bold" />
                Έντονα γράμματα
            </label>

            <div class="category-customization-actions">
                <button class="category-customization-reset" @onclick="ResetCategoryCustomization">Επαναφορά</button>
                <button class="category-customization-save" @onclick="SaveCategoryCustomization">Αποθήκευση</button>
            </div>
        </div>
    }

    @if (showActionButtonCustomizationMenu)
    {
        <div class="action-button-customization-menu"
             style="left:@(actionCustomizationX)px; top:@(actionCustomizationY)px"
             @onclick:stopPropagation="true">
            <h4>🎨 Χρώματα κουμπιού</h4>
            <p class="action-button-customization-caption">@GetActionButtonDisplayName(editingActionButtonKey)</p>

            <div class="category-customization-field">
                <label>Χρώμα φόντου</label>
                <input type="color" @bind="editingActionButtonStyle.Background" />
            </div>
            <div class="category-customization-field">
                <label>Χρώμα κειμένου</label>
                <input type="color" @bind="editingActionButtonStyle.TextColor" />
            </div>
            <div class="category-customization-field">
                <label>Χρώμα περιγράμματος</label>
                <input type="color" @bind="editingActionButtonStyle.BorderColor" />
            </div>

            <div class="category-customization-actions">
                <button class="category-customization-reset" @onclick="ResetActionButtonCustomization">Προεπιλογή</button>
                <button class="category-customization-save" @onclick="SaveActionButtonCustomization">Αποθήκευση</button>
            </div>
        </div>
    }

    <button type="button" class="nav-button" @onclick="RequestLeaveTable">&larr; Πίσω στα τραπέζια</button>
    @if (isTakeAwayMode)
    {
        <div class="takeaway-mode-banner" role="status">
            <span class="takeaway-mode-banner-icon" aria-hidden="true">🥡</span>
            <span><strong>Take Away</strong><small>Αποστολή παραγγελίας και έκδοση απόδειξης.</small></span>
        </div>
    }
    <div class="table-order-heading">
        <h2>@(isTakeAwayMode ? "🥡 Take Away" : tableName)</h2>
        <AuthorizeView Roles="Admin">
            <div class="appearance-admin-tools">
                <button type="button" class="linkbtn-plain" disabled="@(layoutEditing || extrasLayoutEditing)" @onclick="ToggleAppearanceEditMode">@(appearanceEditMode ? "✅ Τέλος διαχείρισης εμφάνισης" : "🎨 Διαχείριση εμφάνισης")</button>
                @if (appearanceEditMode && !layoutEditing && selectedCategoryId != 0)
                {
                    <button type="button" class="linkbtn-plain" @onclick="StartLayoutEditing">↔ Διάταξη ειδών</button>
                }
                @if (appearanceEditMode && showExtraPanel && !extrasLayoutEditing)
                {
                    <button type="button" class="linkbtn-plain" @onclick="StartExtrasLayoutEditing">↔ Διάταξη extra</button>
                }
                @if (appearanceEditMode)
                {
                    <small>Ενεργή λειτουργία ρυθμίσεων. Κράτησε πατημένη κατηγορία ή φόντο για χρώματα. Το παρατεταμένο πάτημα σε είδος συνεχίζει να ανοίγει το σχόλιο.</small>
                }
            </div>
        </AuthorizeView>
    </div>

    <div class="order-layout">
        <div class="category-panel">
            <div class="category-panel-title">Κατηγορίες</div>
            <div class="category-list">
                @if (categories.Count == 0)
                {
                    <span class="hint">Δεν υπάρχουν ενεργές κατηγορίες. Ενεργοποίησε μία από τη Διαχείριση → Κατηγορίες.</span>
                }
                @foreach (var cat in categories)
                {
                    <button class="category-choice @(selectedCategoryId == cat.Id ? "active" : "")"
                            style="@GetCategoryStyle(cat.Id)"
                            @onclick="() => SelectCategory(cat.Id)"
                            @oncontextmenu="(e) => OpenCategoryCustomization(cat.Id, e)"
                            @oncontextmenu:preventDefault="true"
                            @oncontextmenu:stopPropagation="true">
                        @cat.Name
                    </button>
                }
            </div>
        </div>

        <div class="products-panel">
            @if (selectedCategoryId != 0 && itemsByCategory.TryGetValue(selectedCategoryId, out var selectedCategoryItems))
            {
                var selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId);
                <div class="products-panel-header products-panel-toolbar">
                    <div>
                        <strong>@(selectedCategory?.Name ?? "Προϊόντα")</strong>
                        <small style="display:block;margin-top:4px;font-weight:500;color:#687386">Παρατεταμένο πάτημα σε είδος για σχόλιο</small>
                    </div>
                </div>
                @if (layoutEditing)
                {
                    <div class="layout-size-toolbar">
                        <label>Μέγεθος όλων: <strong>@bulkTileScale%</strong></label>
                        <input type="range" min="100" max="200" step="1" @bind="bulkTileScale" />
                        <button type="button" @onclick="ApplyBulkTileScale">Εφαρμογή σε όλα τα είδη</button>
                        <button type="button" class="layout-save" @onclick="SaveLayoutAsync">Τέλος διάταξης · Αποθήκευση</button>
                        <button type="button" class="layout-cancel" @onclick="CancelLayoutEditing">Ακύρωση</button>
                    </div>
                    <p class="layout-swap-prompt">@(layoutSelectedMenuItemId is int selectedId ? $"Επίλεξες «{itemsByCategory.GetValueOrDefault(selectedCategoryId, new()).FirstOrDefault(x => x.Id == selectedId)?.Name}». Πάτησε δεύτερο είδος για ανταλλαγή θέσεων." : "Για αλλαγή θέσεων, πάτησε ένα είδος και μετά το είδος με το οποίο θα ανταλλάξει θέση.")</p>
                }
                <div class="item-grid">
                    @foreach (var item in selectedCategoryItems)
                    {
                        <div class="menu-item-card @(draggedMenuItemId == item.Id ? "layout-dragging" : "") @(layoutSelectedMenuItemId == item.Id ? "layout-swap-selected" : "")"
                             style="@TileScaleStyle(item.TileScale)"
                             @ondragover:preventDefault="true"
                             @ondrop="() => DropMenuItem(item.Id)">
                            @if (layoutEditing)
                            {
                                <div class="tile-layout-tools">
                                    <span class="tile-drag-handle" draggable="true" data-layout-kind="menu" data-layout-id="@item.Id" @ondragstart="() => draggedMenuItemId = item.Id" @ondragend="() => draggedMenuItemId = null">⠿ Σύρε</span>
                                    <button type="button" title="Μικρότερο κατά 1%" disabled="@(item.TileScale <= 1.0)" @onclick="() => ChangeMenuItemSize(item, -0.01)" @onclick:stopPropagation="true">−</button>
                                    <span>@($"{Math.Round(item.TileScale * 100):0}%")</span>
                                    <button type="button" title="Μεγαλύτερο κατά 1%" disabled="@(item.TileScale >= 2.0)" @onclick="() => ChangeMenuItemSize(item, 0.01)" @onclick:stopPropagation="true">+</button>
                                </div>
                            }
                            <button class="menu-item-btn"
                                    @onclick="() => HandleMenuItemClickAsync(item)"
                                    @onpointerdown="(e) => HandleMenuItemPointerDownAsync(item, e)"
                                    @onpointerup="CancelMenuItemLongPress"
                                    @onpointercancel="CancelMenuItemLongPress"
                                    @onpointerleave="CancelMenuItemLongPress"
                                    @oncontextmenu="IgnoreMenuItemContextMenu"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu:stopPropagation="true">
                                <span>@item.Name</span>
                                <span class="price">€@item.Price.ToString("0.00")</span>
                            </button>
                        </div>
                    }
                    @if (selectedCategoryItems.Count == 0)
                    {
                        <span class="hint">Δεν έχουν προστεθεί είδη σε αυτή την κατηγορία.</span>
                    }
                </div>
                @if (!layoutEditing && selectedCategory?.AutoOpenExtras == false && lastManualExtrasItem is not null && lastManualExtrasItem.MenuCategoryId == selectedCategoryId && HasExtrasForItem(lastManualExtrasItem))
                {
                    <div class="products-extra-footer">
                        <button type="button" class="category-extra-trigger products-extra-trigger" @onclick="OpenLastItemExtrasAsync">Extra</button>
                    </div>
                }
            }
            else
            {
                <div class="products-panel-header">Επίλεξε κατηγορία</div>
            }
        </div>

        <div class="order-panel @(selectionMode ? "selection-active" : "")">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap">
                <h3 style="margin:0">Παραγγελία</h3>
            </div>
            @if (selectionMode)
            {
                <div class="selection-toolbar" style="display:flex;gap:7px;flex-wrap:wrap;margin:8px 0">
                    <button type="button" class="close-btn" @onclick="SelectAllVisibleItems"><span class="action-icon" aria-hidden="true">☑️</span>Επιλογή όλων</button>
                    <button type="button" class="close-btn" disabled="@(selectedOrderItemIds.Count == 0)" @onclick="BeginSelectedItemTransfer"><span class="action-icon" aria-hidden="true">🔀</span>Μεταφορά επιλεγμένων</button>
                    <button type="button" class="close-btn" disabled="@(selectedOrderItemIds.Count == 0 || cancellationInProgress || wholeOrderCancellationInProgress)" @onclick="BeginCancelSelectedItems"><span class="action-icon" aria-hidden="true">🗑️</span>Ακύρωση επιλεγμένων</button>
                    <span class="hint">Πατήστε παραγγελία ή είδη για επιλογή · Επιλεγμένα: @selectedOrderItemIds.Count γραμμές</span>
                </div>
            }
            <ul class="order-list">
                @foreach (var orderGroup in order.Items
                    .Where(i => !i.IsCancelled && RemainingQuantityForItem(i) > 0)
                    .GroupBy(i => i.OrderPrintBatchId)
                    .OrderBy(g => OrderBatchSortKey(g.First())))
                {
                    var firstItem = orderGroup.First();
                    var batch = firstItem.OrderPrintBatch;
                    <li class="order-batch-label">
                        @if (selectionMode)
                        {
                            <button type="button" class="close-btn" @onclick="() => ToggleBatchSelection(orderGroup.Select(i => i.Id))"><span class="action-icon" aria-hidden="true">☑️</span>@(orderGroup.All(i => selectedOrderItemIds.Contains(i.Id)) ? "Αποεπιλογή παραγγελίας" : "Επιλογή παραγγελίας")</button>
                        }
                        @if (orderGroup.Key is null)
                        {
                            var pendingGroupTotal = orderGroup
                                .Where(i => !i.IsPrinted)
                                .Sum(i => LineTotalForQuantity(i, RemainingQuantityForItem(i)));
                            <span class="order-batch-heading">
                                <span>Παραγγελία Ν-@nextDailyOrderNumberPreview</span>
                                <span class="order-batch-pending-total">€@pendingGroupTotal.ToString("0.00")</span>
                            </span>
                        }
                        else if (batch?.DailyNumber > 0)
                        {
                            <span class="order-batch-heading"><span>Παραγγελία Ν-@batch.DailyNumber</span></span>
                        }
                        else
                        {
                            <span class="order-batch-heading"><span>Παραγγελία Ν-@(batch?.Number ?? 0)</span></span>
                        }
                    </li>
                    @foreach (var oi in orderGroup.OrderBy(i => i.Id))
                    {
                    <li id="order-item-@oi.Id" class="order-item-interactive @(oi.IsPrinted ? "printed" : "pending") @(selectionMode ? "selection-mode" : "") @(selectedOrderItemIds.Contains(oi.Id) ? "selected-for-action" : "")"
                        @onpointerdown="(e) => OrderItemPointerDown(oi, e)"
                        @onpointerup="(e) => OrderItemPointerUp(oi, e)"
                        @onclick="() => HandleOrderItemTap(oi)">
                        @if (selectionMode) { <input type="checkbox" checked="@selectedOrderItemIds.Contains(oi.Id)" @onchange="(e) => SetOrderItemSelected(oi.Id, e)" @onclick:stopPropagation="true" aria-label="Επιλογή είδους" /> }
                        <div class="order-line-main">
                        <span class="order-line-name">
                            @oi.MenuItem!.Name
                            @if (oi.ExtrasPrice > 0)







                            {
                                <text> (+€@oi.ExtrasPrice.ToString("0.00"))</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(oi.Notes))







                            {
                                <br />

                                <small>@oi.Notes</small>
                            }
                            @if (oi.DiscountPercent > 0m)
                            {
                                <br /><small class="discount-tag">Έκπτωση @oi.DiscountPercent.ToString("0.##")% · €@LineTotalForQuantity(oi, RemainingQuantityForItem(oi)).ToString("0.00")</small>
                            }
                        </span>
                        <span class="order-line-controls">
                            @if (!selectionMode && !oi.IsPrinted)
                            {
                                <button type="button" class="quantity-step" title="Μείωση ποσότητας" @onclick="() => DecreasePendingOrderItemByOne(oi)" @onclick:stopPropagation="true">−</button>
                            }
                            <strong class="quantity-value">@RemainingQuantityForItem(oi)</strong>
                            @if (!selectionMode && !oi.IsPrinted)
                            {
                                <button type="button" class="quantity-step" title="Αύξηση ποσότητας" @onclick="() => HandleOrderItemTap(oi)" @onclick:stopPropagation="true">+</button>
                            }
                        </span>
                        </div>
                        <button class="remove-btn"
                                title="Αφαίρεση είδους"
                                @onclick="() => RemoveItemFromPendingOrder(oi)"
                                @onclick:stopPropagation="true">
                            ✕
                        </button>
                        @if (oi.IsPrinted)
                        {
                            <span class="sent-tag">απεστάλη</span>
                            @if (oi.KitchenPrintUnconfirmed)
                            {
                                <small>Κουζίνα: μη επιβεβαιωμένη εκτύπωση</small>
                            }
                        }
                    </li>
                    @if (discountEditorItemId == oi.Id)
                    {
                        <li class="discount-editor-row">
                            <label>Έκπτωση %</label>
                            <input type="number" min="0" max="100" step="1" @bind="discountDraftPercent" />
                            <button @onclick="() => SaveItemDiscountAsync(oi)">Εφαρμογή</button>
                            <button @onclick="CloseDiscountEditor">Άκυρο</button>
                        </li>
                    }
                    }
                }
            </ul>

            <p class="total"><strong>Σύνολο: €@CurrentOrderTotal.ToString("0.00")</strong></p>

            <button class="send-btn @(sendingOrder ? "sending" : "")"
                    disabled="@(sendingOrder || (isTakeAwayMode ? !order.Items.Any(i => !i.IsCancelled && RemainingQuantityForItem(i) > 0) : !order.Items.Any(i => !i.IsPrinted && !i.IsCancelled)))"
                    @onclick="@(isTakeAwayMode ? OpenTakeAwayPayment : SendOrderAsync)">
                @if (sendingOrder) { <span class="action-icon" aria-hidden="true">⏳</span> } else { <span class="action-icon" aria-hidden="true">📤</span> }@(sendingOrder ? "Αποστολή..." : "Αποστολή παραγγελίας")
            </button>

            @if (!isTakeAwayMode)
            {
            <div class="order-action-grid">
                    <button class="close-btn order-action-btn" style='@GetActionButtonStyle("bill")'
                            title="Για αλλαγή χρώματος, ενεργοποίησε πρώτα τη διαχείριση εμφάνισης"
                            @oncontextmenu='(e) => OpenActionButtonCustomization("bill", e)'
                            @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                            @onclick="PrintBill"><span class="action-icon" aria-hidden="true">🧾</span>Λογαριασμός</button>
                    <button class="close-btn order-action-btn" style='@GetActionButtonStyle("cancel")'
                            title="Για αλλαγή χρώματος, ενεργοποίησε πρώτα τη διαχείριση εμφάνισης"
                            @oncontextmenu='(e) => OpenActionButtonCustomization("cancel", e)'
                            @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                            @onclick="BeginCancelWholeOrder"><span class="action-icon" aria-hidden="true">🗑️</span>Ακύρωση παραγγελίας</button>
                    <button type="button" class="close-btn order-action-btn order-selection-btn @(selectionMode ? "active" : "")" @onclick="ToggleOrderSelection"><span class="action-icon" aria-hidden="true">☑️</span>@(selectionMode ? "Τέλος επιλογής" : "Επιλογή")</button>
                    <button type="button" class="close-btn order-action-btn order-discount-btn" @onclick="BeginDiscount"><span class="action-icon" aria-hidden="true">🏷️</span>Έκπτωση</button>
                    <button class="close-btn order-action-btn" style='@GetActionButtonStyle("reprint")'
                            title="Για αλλαγή χρώματος, ενεργοποίησε πρώτα τη διαχείριση εμφάνισης"
                            @oncontextmenu='(e) => OpenActionButtonCustomization("reprint", e)'
                            @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                            @onclick="ReprintOrder"><span class="action-icon" aria-hidden="true">🖨️</span>Επανεκτύπωση</button>
