                            else if (IsSelectedEdpsWebEcr)
                            {
                                <h3>💳 Πληρωμή μέσω EDPS Middleware</h3>
                                <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                                <p class="hint">POS: @SelectedCardPosSetting?.Name — φυσικό TID @SelectedCardPosSetting?.TerminalId — Middleware route: @(string.IsNullOrWhiteSpace(SelectedCardPosSetting?.IdUrl) ? "/terminal/txninit" : SelectedCardPosSetting?.IdUrl)</p>
                                <button @onclick="StartEdpsSplitCardPayment" disabled="@epayBusy">@(epayBusy ? "Προετοιμασία / αναμονή EDPS…" : edpsRetryWithFreshProviderData ? "🔄 Νέα προσπάθεια (νέα υπογραφή)" : "💳 Αποστολή ποσού στο EDPS POS")</button>
                                @if (edpsStatusCheckRequired)
                                {
                                    <p class="error">Έλεγξε στο POS αν η προηγούμενη προσπάθεια χρεώθηκε. Αν επιβεβαιώσεις ότι απορρίφθηκε, πάτησε ξανά το ίδιο κουμπί για αυτόματη νέα υπογραφή και επανάληψη.</p>
                                }
                            }
                            else
                            {
                            <h3>💳 Πληρωμή με WebECR — @(SelectedCardPosSetting?.Provider ?? "ePay")</h3>
                            <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                            @if (IsSelectedMellonWebEcr)
                            {
                                <p>POS: @SelectedCardPosSetting?.Name — @SelectedCardPosSetting?.Provider — TID @SelectedCardPosSetting?.TerminalId — @(SelectedCardPosSetting?.UseProduction == true ? "Παραγωγικό" : "Demo")</p>
                                <button @onclick="StartEpaySplitCardPayment" disabled="@epayBusy">@(epayBusy ? "Αναμονή απάντησης POS…" : !string.IsNullOrWhiteSpace(cardTransactionId) ? "🧾 Επανάληψη έκδοσης παραστατικού" : "💳 Αποστολή ποσού στο επιλεγμένο POS")</button>
                            }
                            else
                            {
                            <button @onclick="() => LoadEpayTerminals(true)" disabled="@epayBusy">@(epayBusy ? "Αναζήτηση διαθέσιμων POS…" : "🔄 Αναζήτηση διαθέσιμων POS")</button>
                            @if (epayTerminals.Count > 0)
                            {
                                <p class="hint">Επίλεξε τερματικό για αποστολή €@pendingCardAmount.ToString("0.00"):</p>
                                <div class="card-terminal-list">
                                    @foreach (var t in epayTerminals)
                                    {
                                        <button class="card-terminal-choice" disabled="@epayBusy" @onclick="() => ChargeEpayBackendAsync(true, t.BackendId)"><strong>💳 TID @t.TerminalId</strong><span>@t.Merchant @(!string.IsNullOrWhiteSpace(t.Acquirer) ? $"· {t.Acquirer}" : "")</span></button>
                                    }
                                </div>
                            }
                            }
                            @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            <button class="linkbtn-plain" @onclick="() => closeStep = 8">&larr; Πίσω</button>
                        }
                        else if (closeStep == 6)
                        {
                            @if (aadePreloadedSubmitPending)
                            {
                                <h3>🧾 Η απόδειξη εκδόθηκε · εκκρεμεί καταχώριση πληρωμής</h3>
                                <p class="hint">Η συναλλαγή υπάρχει στο POS. Δεν χρειάζεται νέα χρέωση.</p>
                                <button class="pay-btn" @onclick="RetryAadePreloadedSubmitAsync" disabled="@epayBusy">↻ Επανάληψη καταχώρισης στον πάροχο</button>
                                @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            else if (IsSelectedVivaCloud)
                            {
                                <h3>💳 Πληρωμή μέσω Viva Cloud Terminal</h3>
                                <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                                <p class="hint">POS: @SelectedCardPosSetting?.Name — Terminal ID @SelectedCardPosSetting?.TerminalId</p>
                                <button @onclick="() => StartSelectedVivaPayment(false)" disabled="@epayBusy">@(epayBusy ? "Αναμονή αποτελέσματος Viva…" : !string.IsNullOrWhiteSpace(cardTransactionId) ? "🧾 Επανάληψη έκδοσης παραστατικού" : "💳 Αποστολή ποσού στο Viva POS")</button>
                                @if (vivaStatusCheckRequired) { <p class="error">Η προηγούμενη προσπάθεια έχει αβέβαιο αποτέλεσμα. Έλεγξε το ιστορικό Viva πριν από νέα προσπάθεια.</p><p class="hint">Session ID: @vivaPendingSessionId</p> }
                                @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            else if (IsSelectedEdpsWebEcr)
                            {
                                <h3>💳 Πληρωμή μέσω EDPS Middleware</h3>
                                <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                                <p class="hint">POS: @SelectedCardPosSetting?.Name — φυσικό TID @SelectedCardPosSetting?.TerminalId — Middleware route: @(string.IsNullOrWhiteSpace(SelectedCardPosSetting?.IdUrl) ? "/terminal/txninit" : SelectedCardPosSetting?.IdUrl)</p>
                                <button @onclick="StartEdpsFullCardPayment" disabled="@epayBusy">@(epayBusy ? "Προετοιμασία / αναμονή EDPS…" : edpsRetryWithFreshProviderData ? "🔄 Νέα προσπάθεια (νέα υπογραφή)" : "💳 Αποστολή ποσού στο EDPS POS")</button>
                                @if (edpsStatusCheckRequired)
                                {
                                    <p class="error">Έλεγξε στο POS αν η προηγούμενη προσπάθεια χρεώθηκε. Αν επιβεβαιώσεις ότι απορρίφθηκε, πάτησε ξανά το ίδιο κουμπί για αυτόματη νέα υπογραφή και επανάληψη.</p>
                                }
                                @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            else
                            {
                            <h3>💳 Πληρωμή με WebECR — @(SelectedCardPosSetting?.Provider ?? "ePay")</h3>
                            <p><strong>Ποσό:</strong> €@pendingCardAmount.ToString("0.00")</p>
                            @if (IsSelectedMellonWebEcr)
                            {
                                <p>POS: @SelectedCardPosSetting?.Name — @SelectedCardPosSetting?.Provider — TID @SelectedCardPosSetting?.TerminalId — @(SelectedCardPosSetting?.UseProduction == true ? "Παραγωγικό" : "Demo")</p>
                                <button @onclick="StartEpayFullCardPayment" disabled="@epayBusy">@(epayBusy ? "Αναμονή απάντησης POS…" : !string.IsNullOrWhiteSpace(cardTransactionId) ? "🧾 Επανάληψη έκδοσης παραστατικού" : "💳 Αποστολή ποσού στο επιλεγμένο POS")</button>
                            }
                            else
                            {
                            <button @onclick="() => LoadEpayTerminals(false)" disabled="@epayBusy">@(epayBusy ? "Αναζήτηση διαθέσιμων POS…" : "🔄 Αναζήτηση διαθέσιμων POS")</button>
                            @if (epayTerminals.Count > 0)
                            {
                                <p class="hint">Επίλεξε τερματικό για αποστολή €@pendingCardAmount.ToString("0.00"):</p>
                                <div class="card-terminal-list">
                                    @foreach (var t in epayTerminals)
                                    {
                                        <button class="card-terminal-choice" disabled="@epayBusy" @onclick="() => ChargeEpayBackendAsync(false, t.BackendId)"><strong>💳 TID @t.TerminalId</strong><span>@t.Merchant @(!string.IsNullOrWhiteSpace(t.Acquirer) ? $"· {t.Acquirer}" : "")</span></button>
                                    }
                                </div>
                            }
                            }
                            @if (!string.IsNullOrEmpty(fiscalError)) { <p class="error">@fiscalError</p> }
                            }
                            <button class="linkbtn-plain" @onclick="() => closeStep = 2">&larr; Πίσω</button>
                        }
                        else if (closeStep == 5)
                        {
                            @if (lastDocumentOfflinePending)
                            {
                                <h3>⚠️ @(lastPrintSucceeded ? "Η απόδειξη εκτυπώθηκε" : "Η απόδειξη καταχωρίστηκε")</h3>
                                <p class="split-print-warning">@GetTransmissionPendingCustomerMessage(lastTransmissionFailure)</p>
                            }
                            else
                            {
                                <h3>✅ @lastDocumentLabel εκδόθηκε</h3>
                            }
                            <p class="hint">Αρ. @lastSeriesAndNumber @(lastMark is not null ? $"— ΜΑΡΚ: {lastMark}" : lastDocumentOfflinePending ? "— χωρίς ΜΑΡΚ μέχρι τη διαβίβαση" : "")</p>
                            @if (!string.IsNullOrWhiteSpace(lastPrintStatus))
                            {
                                <p class="@(lastPrintSucceeded ? "split-print-success" : "split-print-warning")">@lastPrintStatus</p>
                            }
                            @if (!lastDocumentOfflinePending && !string.IsNullOrEmpty(lastPdfUrl))







                            {
                                <a class="export-btn" href="@lastPdfUrl" target="_blank">📄 Άνοιγμα / Λήψη PDF</a>
                            }







                            else if (!lastDocumentOfflinePending)







                            {
                                <p class="hint">Το PDF δεν είναι ακόμα διαθέσιμο (ο Parochos μπορεί να χρειάζεται λίγο χρόνο ακόμα).</p>
                            }
                            @if (isTakeAwayMode)
                            {
                                @* A real link also works if the Blazor circuit drops during fiscal issue/printing. *@
                                <a class="takeaway-finish-link" href="/waiter?startTakeAway=true">Συνέχεια</a>
                            }
                            else
                            {
                                <button @onclick="FinishClosing">Συνέχεια</button>
                            }
                        }
                    </div>
                </div>
            }

            @if (showCancelModal && pendingCancellationItem is not null)



            {
                <div class="pin-overlay">
                    <div class="pin-box">
                        <h3>⚠ Ακύρωση είδους</h3>
                        <p><strong>@pendingCancellationItem.Quantity x @pendingCancellationItem.MenuItem?.Name</strong></p>
                        <label>Ποσότητα για ακύρωση
                            <input type="number" min="1" max="@RemainingQuantityForItem(pendingCancellationItem)" step="1" @bind="pendingCancellationQuantity" @bind:event="oninput" />
                        </label>

                        @if (pendingCancellationItem.IsPrinted)
                        {
                            <p class="hint">Για τη συγκεκριμένη ποσότητα εκδίδεται νέο φορολογικό 8.6 με γραμμές επιστροφής. Η υπόλοιπη ποσότητα μένει στο τραπέζι.</p>
                        }
                        else
                        {
                            <p class="hint">Το είδος δεν έχει σταλεί ακόμα στην ΑΑΔΕ και θα αφαιρεθεί μόνο από την τρέχουσα παραγγελία.</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(cancellationError))
                        {
                            <p class="error">@cancellationError</p>
                        }

                        <div class="payment-choice">
                            <button class="pay-btn cash" disabled="@cancellationInProgress" @onclick="ConfirmCancelItem">✓ Ακύρωση</button>
                            <button class="linkbtn-plain" disabled="@cancellationInProgress" @onclick="CloseCancelModal">Πίσω</button>
                        </div>
                    </div>
                </div>
            }

            @if (showSelectedCancelModal)
            {
                <div class="pin-overlay">
                    <div class="pin-box">
                        <h3>⚠ Ακύρωση επιλεγμένων ειδών</h3>
                        <p>Θα ακυρωθούν ολόκληρες οι επιλεγμένες γραμμές. Για μερική ποσότητα, επίλεξε μία γραμμή.</p>
                        @if (!string.IsNullOrWhiteSpace(selectedCancellationError)) { <p class="error">@selectedCancellationError</p> }
                        <div class="payment-choice">
                            <button class="pay-btn cash" disabled="@selectedCancellationInProgress" @onclick="ConfirmCancelSelectedItemsAsync">@(selectedCancellationInProgress ? "⏳ Ακύρωση..." : "✓ Ακύρωση")</button>
                            <button class="linkbtn-plain" disabled="@selectedCancellationInProgress" @onclick="() => showSelectedCancelModal = false">Πίσω</button>
                        </div>
                    </div>
                </div>
            }

            @if (showWholeOrderCancelModal)



            {
                <div class="pin-overlay">
                    <div class="pin-box">
                        <h3>⚠ Ακύρωση παραγγελίας</h3>
                        <p>
                            Θα ακυρωθούν <strong>όλα τα ενεργά είδη</strong> της παραγγελίας
                            και το τραπέζι θα κλείσει.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(wholeOrderCancellationError))
                        {
                            <p class="error">@wholeOrderCancellationError</p>
                        }

                        <div class="payment-choice">
                            <button class="pay-btn cash"
                                    disabled="@wholeOrderCancellationInProgress"
                                    @onclick="ConfirmCancelWholeOrder">
                                @(wholeOrderCancellationInProgress ? "⏳ Ακύρωση..." : "✓ Ναι, ακύρωση")
                            </button>
                            <button class="linkbtn-plain"
                                    disabled="@wholeOrderCancellationInProgress"
                                    @onclick="CloseWholeOrderCancelModal">
                                Πίσω
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (showExtraPanel && pendingItem is not null)
            {
                <div class="extras-screen-overlay">
                    <section class="extras-screen-box" role="dialog" aria-modal="true" aria-label="Επιλογή extra">
                        <div class="extras-screen-header">
                            <div>
                                <h3>Extra για: @pendingItem.Name</h3>
                                <p class="hint">Πάτησε extra για να το επιλέξεις. Επόμενα πατήματα: Πολύ → Πάρα πολύ → Λίγο → Με. Το «Με» δεν τυπώνεται.</p>
                            </div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap">
                                <button class="linkbtn-plain" @onclick="CancelPending">← Πίσω στα προϊόντα</button>
                            </div>
                        </div>
                        @if (extrasLayoutEditing)
                        {
                            <div class="layout-size-toolbar">
                                <label>Μέγεθος όλων των extra: <strong>@bulkTileScale%</strong></label>
                                <input type="range" min="100" max="200" step="1" @bind="bulkTileScale" />
                                <button type="button" @onclick="ApplyBulkExtraScale">Εφαρμογή σε όλα τα extra</button>
                                <button type="button" class="layout-save" @onclick="SaveExtraLayoutAsync">Τέλος διάταξης · Αποθήκευση</button>
                                <button type="button" class="layout-cancel" @onclick="CancelExtraLayoutEditing">Ακύρωση</button>
                            </div>
                            <p class="layout-swap-prompt">@(layoutSelectedExtraId is int selectedId ? $"Επίλεξες «{allExtras.FirstOrDefault(x => x.Id == selectedId)?.Name}». Πάτησε δεύτερο extra για ανταλλαγή θέσεων." : "Για αλλαγή θέσεων, πάτησε ένα extra και μετά το extra με το οποίο θα ανταλλάξει θέση.")</p>
                        }

                        <div class="extra-mode-choice" aria-label="Τρόπος επιλογής extra">
                            <span>Επιλογή:</span>
                            <button type="button" class="@(pendingExtraMode == "Με" ? "selected" : "")" @onclick='() => SetPendingExtraMode("Με")'>Με</button>
                            <button type="button" class="@(pendingExtraMode == "Χωρίς" ? "selected" : "")" @onclick='() => SetPendingExtraMode("Χωρίς")'>Χωρίς</button>
                            <button type="button" class="@(pendingExtraMode == "Μόνο" ? "selected" : "")" @onclick='() => SetPendingExtraMode("Μόνο")'>Μόνο</button>
                        </div>

                        <div class="extras-screen-grid">
                            @foreach (var extra in ExtrasForCurrentItem())
                            {
                                <div class="extra-tile-wrap @(draggedExtraId == extra.Id ? "layout-dragging" : "") @(layoutSelectedExtraId == extra.Id ? "layout-swap-selected" : "")"
                                     style="@TileScaleStyle(extra.TileScale)"
                                     @ondragover:preventDefault="true"
                                     @ondrop="() => DropExtra(extra.Id)">
                                    @if (extrasLayoutEditing)
                                    {
                                        <div class="tile-layout-tools">
                                            <span class="tile-drag-handle" draggable="true" data-layout-kind="extra" data-layout-id="@extra.Id" @ondragstart="() => draggedExtraId = extra.Id" @ondragend="() => draggedExtraId = null">⠿ Σύρε</span>
                                            <button type="button" title="Μικρότερο κατά 1%" disabled="@(extra.TileScale <= 1.0)" @onclick="() => ChangeExtraSize(extra, -0.01)" @onclick:stopPropagation="true">−</button>
                                            <span>@($"{Math.Round(extra.TileScale * 100):0}%")</span>
                                            <button type="button" title="Μεγαλύτερο κατά 1%" disabled="@(extra.TileScale >= 2.0)" @onclick="() => ChangeExtraSize(extra, 0.01)" @onclick:stopPropagation="true">+</button>
                                        </div>
                                    }
                                    <button type="button"
                                            class="menu-item-btn @(pendingSelectedExtras.ContainsKey(extra.Id) ? "selected" : "")"
                                            @onclick="() => { if (extrasLayoutEditing) SelectExtraForLayout(extra.Id); else ToggleExtra(extra.Id); }">
                                        <span>@extra.Name</span>
                                        @if (pendingSelectedExtras.TryGetValue(extra.Id, out var extraSelection) && !string.IsNullOrWhiteSpace(GetExtraSelectionText(extraSelection)))
                                        {
                                            <span class="extra-cycle-hint">@GetExtraSelectionText(extraSelection)</span>
                                        }
                                        <span class="price">@(extra.Price >= 0 ? "+" : "")€@extra.Price.ToString("0.00")</span>
                                    </button>
                                    @if (pendingSelectedExtras.ContainsKey(extra.Id))
                                    {
                                        <button type="button" class="extra-remove-btn" title="Αφαίρεση extra" @onclick="() => RemoveExtra(extra.Id)" @onclick:stopPropagation="true">×</button>
                                    }
                                </div>
                            }
                        </div>

                        @if (!ExtrasForCurrentItem().Any())
                        {
                            <p class="hint">Δεν υπάρχουν extra συνδεδεμένα με αυτό το προϊόν ή την κατηγορία του.</p>
                        }

                        <div class="extras-screen-footer">
                            <strong>Σύνολο extra: €@ExtrasForCurrentItem().Where(e => pendingSelectedExtras.ContainsKey(e.Id)).Sum(e => e.Price).ToString("0.00")</strong>
                            <div class="payment-choice">
                                <button class="pay-btn cash" @onclick="ConfirmAddItem">Προσθήκη στην παραγγελία</button>
                                <button class="linkbtn-plain" @onclick="CancelPending">Ακύρωση</button>
                            </div>
                        </div>
                    </section>
                </div>
            }

            @if (showItemCommentPanel && pendingItem is not null)
            {
                <div class="item-comment-overlay" role="dialog" aria-modal="true" aria-labelledby="item-comment-title">
                    <section class="item-comment-dialog">
                        <h3 id="item-comment-title">Σχόλιο για το είδος</h3>
                        <p class="hint"><strong>@pendingItem.Name</strong> · Το σχόλιο θα τυπωθεί μόνο στο παραγγελιόχαρτο κουζίνας/μπαρ.</p>
                        <textarea id="itemCommentInput" class="item-comment-input" @bind="pendingItemComment" @bind:event="oninput" placeholder="π.χ. χωρίς πάγο, αλλεργία στο σουσάμι…"></textarea>
                        <div class="payment-choice">
                            <button class="pay-btn cash" @onclick="ConfirmAddItem">Προσθήκη είδους</button>
                            <button class="linkbtn-plain" @onclick="CancelPending">Ακύρωση</button>
                        </div>
                    </section>
                </div>
            }

            @if (!string.IsNullOrEmpty(statusMessage))







            {
                <p class="status">@statusMessage</p>
            }
        </div>
    </div>

</div>

@if (showLeaveTableConfirm)
{
    <div class="leave-table-overlay" role="dialog" aria-modal="true" aria-labelledby="leave-table-title">
        <section class="leave-table-dialog">
            <div class="leave-table-icon" aria-hidden="true">⚠</div>
            <h3 id="leave-table-title">@(isTakeAwayMode && HasSentTakeAwayItems ? "Ολοκλήρωσε το Take Away" : "Μη απεσταλμένη παραγγελία")</h3>
            @if (isTakeAwayMode && HasSentTakeAwayItems)
            {
                <p>@(HasUnsentTakeAwayItems ? "Υπάρχουν είδη που έχουν ήδη σταλεί και νέα είδη που δεν έχουν σταλεί. Στείλε πρώτα τα νέα είδη και μετά ολοκλήρωσε την πληρωμή." : "Η παραγγελία έχει ήδη σταλεί. Ολοκλήρωσε την πληρωμή και έκδωσε την απόδειξη πριν φύγεις.")</p>
            }
            else
            {
                <p>Έχεις είδη που δεν έχουν σταλεί στην κουζίνα/μπαρ. Αν βγεις τώρα από το τραπέζι, τα είδη αυτά θα διαγραφούν.</p>
                <p class="leave-table-note">Τα είδη που έχουν ήδη σταλεί δεν θα επηρεαστούν.</p>
            }
            @if (!string.IsNullOrWhiteSpace(leaveTableError))
            {
                <p class="error" role="alert">@leaveTableError</p>
            }
            <div class="leave-table-actions">
                @if (isTakeAwayMode && HasSentTakeAwayItems)
                {
                    <button class="leave-table-confirm" disabled="@(leavingTable || sendingOrder)" @onclick="@(HasUnsentTakeAwayItems ? SendOrderAsync : OpenTakeAwayPayment)">@(HasUnsentTakeAwayItems ? "Αποστολή ειδών" : "Πληρωμή & απόδειξη")</button>
                }
                else
                {
                    <button class="leave-table-confirm" disabled="@leavingTable" @onclick="ConfirmLeaveTableAsync">@(leavingTable ? "Διαγραφή…" : "ΟΚ, έξοδος")</button>
                }
                <button disabled="@leavingTable" @onclick="CancelLeaveTable">Ακύρωση</button>
            </div>
        </section>
    </div>
}

@if (showTableTransferModal)
{
    <div class="pin-overlay" style="z-index:10000" role="dialog" aria-modal="true" aria-labelledby="table-transfer-title">
        <div class="pin-box table-transfer-box">
            <h3 id="table-transfer-title">Μεταφορά παραγγελίας</h3>
            @if (pendingTableTransfer is not null)
            {
                <p>@pendingTableTransfer.SourceName → @pendingTableTransfer.TargetName</p>
                <p class="hint">Η μεταφορά εκκρεμεί. Τα δύο τραπέζια παραμένουν δεσμευμένα μέχρι να επιβεβαιωθεί το αποτέλεσμα.</p>
                <button disabled="@tableTransferBusy" @onclick="RecheckTableTransfer">@(tableTransferBusy ? "Έλεγχος…" : "Επανέλεγχος μεταφοράς")</button>
                <button class="linkbtn-plain" disabled="@tableTransferBusy" @onclick='() => Nav.NavigateTo("/waiter")'>Πίσω στα τραπέζια</button>
            }
            else
            {
                <p>Μεταφορά όλων των ειδών από <strong>@tableName</strong>.</p>
                <label for="transfer-table">Τραπέζι προορισμού</label>
                <select id="transfer-table" @bind="tableTransferTargetId" disabled="@tableTransferBusy">
                    <option value="0">Επίλεξε τραπέζι…</option>
                    @foreach (var target in tableTransferTargets)
                    {
                        <option value="@target.Id">@target.Name @(occupiedTransferTargets.Contains(target.Id) ? "— συγχώνευση με υπάρχουσα παραγγελία" : "— ελεύθερο")</option>
                    }
