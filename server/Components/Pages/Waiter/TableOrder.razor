    private async Task ConfirmCancelSelectedItemsAsync()
    {
        if (selectedCancellationInProgress || selectedCancellationQuantities.Count == 0) return;
        selectedCancellationInProgress = true;
        selectedCancellationError = null;
        var completed = 0;
        try
        {
            using var lease = await TableOperationCoordinator.EnterAsync(TableId);
            if (!await EnsureCurrentTableAvailable()) return;
            using var db = await DbFactory.CreateDbContextAsync();
            var current = await db.Orders.Include(o => o.RestaurantTable).Include(o => o.Items)
                .ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                .FirstOrDefaultAsync(o => o.Id == order.Id);
            if (current is null) { selectedCancellationError = "Η παραγγελία δεν βρέθηκε."; return; }

            foreach (var selection in selectedCancellationQuantities)
            {
                var item = current.Items.FirstOrDefault(i => i.Id == selection.Key && !i.IsCancelled);
                if (item is null) continue;
                var quantity = Math.Min(selection.Value, item.Quantity);
                var itemName = item.MenuItem?.Name ?? "Είδος";
                var unitAmount = ((item.MenuItem?.Price ?? 0m) + item.ExtrasPrice) *
                    (1m - Math.Clamp(item.DiscountPercent, 0m, 100m) / 100m);
                var result = await Fiscal.CancelSentOrderItemAsync(db, current, item.Id,
                    "Ακύρωση επιλεγμένων ειδών από τον σερβιτόρο", quantity);
                if (!result.Success)
                {
                    selectedCancellationError = completed == 0
                        ? (result.ErrorMessage ?? "Απέτυχε η ακύρωση.")
                        : $"Ακυρώθηκαν {completed} γραμμές. Η επόμενη ακύρωση απέτυχε: {result.ErrorMessage}";
                    await LoadAsync();
                    return;
                }
                CancellationAuditService.Add(db, current, currentUserId, "Ακύρωση είδους",
                    $"{quantity} × {itemName}", "Ακύρωση επιλεγμένων ειδών από τον σερβιτόρο",
                    quantity, unitAmount * quantity, result.CancelledOrderItemId);
                await db.SaveChangesAsync();
                if (result.OrderFormId is int formId && (result.Mark > 0 || result.OfflineIssued))
                    await FiscalOrderForms.PrintExistingAsync(db, formId);
                completed++;
            }

            statusMessage = $"Ακυρώθηκαν {completed} επιλεγμένες γραμμές.";
            showSelectedCancelModal = false;
            selectedCancellationQuantities.Clear();
            selectedOrderItemIds.Clear();
            selectionMode = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            selectedCancellationError = $"Σφάλμα ακύρωσης: {ex.Message}";
        }
        finally { selectedCancellationInProgress = false; }
    }

    private async Task ApplyDiscountAsync()
    {
        if (discountBusy) return;
        discountBusy = true;
        discountMessage = null;
        try
        {
            using var lease = await TableOperationCoordinator.EnterAsync(TableId);
            if (!await EnsureCurrentTableAvailable()) return;
            using var db = await DbFactory.CreateDbContextAsync();
            var current = await db.Orders.Include(o => o.Items).Include(o => o.Payments).FirstOrDefaultAsync(o => o.Id == order.Id);
            if (current is null) { discountMessage = "Η παραγγελία δεν βρέθηκε."; return; }
            if (current.FiscalStatus != FiscalStatus.NotIssued || current.Payments.Any(p => p.FiscalStatus is FiscalStatus.Issued or FiscalStatus.PaidLocally) || !string.IsNullOrWhiteSpace(current.CardTransactionId))
            { discountMessage = "Δεν εφαρμόστηκε έκπτωση: το τραπέζι έχει ήδη φορολογικό στοιχείο ή πληρωμή."; return; }
            var percent = Math.Clamp(discountDraftPercent, 0m, 100m);
            var scope = discountWholeTable ? current.Items.Where(i => !i.IsCancelled) : current.Items.Where(i => selectedOrderItemIds.Contains(i.Id) && !i.IsCancelled);
            var items = scope.ToList();
            if (items.Count == 0) { discountMessage = "Δεν βρέθηκαν ενεργά είδη για έκπτωση."; return; }
            foreach (var item in items) item.DiscountPercent = percent;
            var discountReturn = await Fiscal.ApplyDiscountWithReturnOrderFormsAsync(db, current, items.Select(i => i.Id).ToList());
            if (!discountReturn.Success)
            {
                discountMessage = "Δεν εφαρμόστηκε η έκπτωση. Δεν εκδόθηκε/ολοκληρώθηκε το δελτίο επιστροφής 8.6: " + discountReturn.ErrorMessage;
                return;
            }
            await db.SaveChangesAsync();
            showDiscountModal = false;
            selectedOrderItemIds.Clear();
            selectionMode = false;
            await LoadAsync();
        }
        finally { discountBusy = false; }
    }

