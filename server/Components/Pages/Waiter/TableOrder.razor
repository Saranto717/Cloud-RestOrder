    private async Task SelectItem(MenuItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;
        lastManualExtrasItem = null;
        lastManualExtrasOrderItemId = null;

        // Η οθόνη extras ανοίγει αυτόματα μόνο αν έτσι έχει οριστεί στην κατηγορία.
        if (CategoryAutoOpensExtras(item.MenuCategoryId) && HasExtrasForItem(item))
        {
            PreparePendingItem(item);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var existingLine = await db.OrderItems.FirstOrDefaultAsync(oi =>
            oi.OrderId == order.Id &&
            oi.MenuItemId == item.Id &&
            !oi.IsPrinted &&
            !oi.IsCancelled &&
            string.IsNullOrEmpty(oi.Notes));

        if (existingLine is not null)
        {
            existingLine.Quantity += 1;
        }
        else
        {
            existingLine = new OrderItem
            {
                OrderId = order.Id,
                MenuItemId = item.Id,
                Quantity = 1,
                Notes = null,
                ExtrasPrice = 0m
            };
            db.OrderItems.Add(existingLine);
        }

        await db.SaveChangesAsync();
        if (!CategoryAutoOpensExtras(item.MenuCategoryId) && HasExtrasForItem(item))
        {
            lastManualExtrasItem = item;
            lastManualExtrasOrderItemId = existingLine.Id;
        }
        statusMessage = null;
        await LoadAsync();
        await FocusOrderItemAsync(existingLine.Id);
    }

