    .takeaway-checkout-btn:disabled { opacity:.48; cursor:not-allowed; }
    .takeaway-finish-link { display:inline-flex; align-items:center; justify-content:center; min-height:40px; margin-top:8px; padding:8px 16px; border:1px solid #cbd8ea; border-radius:10px; background:#f3f7fc; color:#243653; font:inherit; font-weight:750; text-decoration:none; }
    .takeaway-finish-link:hover { background:#e8f0fb; }
    .pin-box.card-pos-picker-box { width:min(94vw,680px); max-width:680px; max-height:88dvh; overflow-y:auto; padding:26px; box-sizing:border-box; }
    .card-pos-picker { color:#202736; text-align:left; }
    .card-pos-picker-head { margin-bottom:16px; text-align:center; }
    .card-pos-picker-head h3 { margin:0 0 6px; color:#1f2a44; }
    .card-pos-picker-head p { margin:0; color:#697386; font-size:.9rem; }
    .card-pos-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(235px,1fr)); gap:12px; }
    .card-pos-option { min-width:0; padding:16px; border:1px solid #e0e5ee; border-radius:16px; background:linear-gradient(150deg,#fff 10%,#f7f9fd 100%); box-shadow:0 5px 16px rgba(31,42,68,.07); }
    .card-pos-option-head { display:flex; align-items:center; gap:11px; margin-bottom:12px; }
