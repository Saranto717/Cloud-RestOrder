    private async Task ConfirmSelectedItemTransferAsync()
    {
        if (selectedTransferBusy || selectedTransferTargetId == 0 || selectedOrderItemIds.Count == 0) return;
        selectedTransferBusy = true;
        selectedTransferMessage = null;
        try
        {
            using var lease = await TableOperationCoordinator.EnterAsync(TableId);
            if (!await EnsureCurrentTableAvailable()) return;
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            var source = await db.Orders.Include(o => o.Items).ThenInclude(i => i.OrderPrintBatch).Include(o => o.Payments)
                .FirstOrDefaultAsync(o => o.Id == order.Id && o.Status == OrderStatus.Open);
            if (source is null) { selectedTransferMessage = "Η παραγγελία δεν βρέθηκε."; return; }
            if (source.FiscalStatus != FiscalStatus.NotIssued || source.Payments.Any() || source.ParochosMark.HasValue || !string.IsNullOrWhiteSpace(source.ParochosPaymentSignature))
            { selectedTransferMessage = "Δεν επιτρέπεται η μερική μεταφορά μετά από έκδοση ή πληρωμή. Χρησιμοποίησε μεταφορά ολόκληρου τραπεζιού."; return; }
            var selected = source.Items.Where(i => selectedOrderItemIds.Contains(i.Id) && !i.IsCancelled).ToList();
            if (selected.Count == 0) { selectedTransferMessage = "Τα επιλεγμένα είδη δεν είναι πλέον ενεργά."; return; }
            var target = await db.Orders.Include(o => o.Items).Include(o => o.Payments)
                .FirstOrDefaultAsync(o => o.RestaurantTableId == selectedTransferTargetId && o.Status == OrderStatus.Open);
            if (target is not null && (target.FiscalStatus != FiscalStatus.NotIssued || target.Payments.Any() || target.ParochosMark.HasValue || !string.IsNullOrWhiteSpace(target.ParochosPaymentSignature)))
            { selectedTransferMessage = "Το τραπέζι προορισμού έχει ήδη έκδοση ή πληρωμή. Επίλεξε άλλο τραπέζι."; return; }
            if (target is null)
            {
                target = new Order { RestaurantTableId = selectedTransferTargetId, WaiterUserId = source.WaiterUserId, CreatedAt = DateTime.Now };
                db.Orders.Add(target);
                await db.SaveChangesAsync();
            }
            var batchMap = new Dictionary<int, OrderPrintBatch>();
            foreach (var item in selected)
            {
                if (item.OrderPrintBatchId is int batchId && !batchMap.ContainsKey(batchId))
                {
                    var sourceBatch = item.OrderPrintBatch;
                    var nextNumber = await db.OrderPrintBatches.Where(x => x.OrderId == target.Id).Select(x => (int?)x.Number).MaxAsync() ?? 0;
                    var copy = new OrderPrintBatch { OrderId = target.Id, Number = nextNumber + 1, DailyNumber = sourceBatch?.DailyNumber ?? 0, CreatedAt = DateTime.Now };
                    db.OrderPrintBatches.Add(copy);
                    await db.SaveChangesAsync();
                    batchMap[batchId] = copy;
                }
                item.OrderId = target.Id;
                if (item.OrderPrintBatchId is int oldBatchId) item.OrderPrintBatchId = batchMap[oldBatchId].Id;
            }
            if (!source.Items.Any(i => !i.IsCancelled && !selectedOrderItemIds.Contains(i.Id))) source.Status = OrderStatus.Closed;
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            showSelectedTransferModal = false;
            selectedOrderItemIds.Clear();
            selectionMode = false;
            Nav.NavigateTo("/waiter", forceLoad: true);
        }
        catch (Exception ex) { selectedTransferMessage = "Η μεταφορά δεν ολοκληρώθηκε: " + ex.Message; }
        finally { selectedTransferBusy = false; }
    }

    private static decimal LineTotalForQuantity(OrderItem item, int quantity)
    {
        var unitGross = (item.MenuItem?.Price ?? 0m) + item.ExtrasPrice;
        var discount = Math.Clamp(item.DiscountPercent, 0m, 100m) / 100m;
        return Math.Round(quantity * unitGross * (1m - discount), 2);
    }

    private decimal CurrentOrderTotal => order.Items.Where(i => !i.IsCancelled)
        .Sum(i => LineTotalForQuantity(i, RemainingQuantityForItem(i)));

    private decimal SplitSelectedTotal => splitPaymentItems.Sum(i =>
    {
        var q = splitQuantities.TryGetValue(i.Id, out var selected) ? selected : 0;
        return LineTotalForQuantity(i, q);
    });



    private async Task BeginSplitPayment()

    {

        fiscalError = null;
        lastPrintStatus = null;
        lastPrintSucceeded = false;

        using var db = await DbFactory.CreateDbContextAsync();

        var activeSplitItems = await db.OrderItems.Include(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
            .Where(i => i.OrderId == order.Id && !i.IsCancelled && i.Quantity > 0).OrderBy(i => i.Id).ToListAsync();
        var paid = await db.OrderPaymentItems
            .Where(pi => pi.OrderPayment != null && pi.OrderPayment.OrderId == order.Id && pi.OrderPayment.FiscalStatus == FiscalStatus.Issued)
            .GroupBy(pi => pi.OrderItemId).Select(g => new { OrderItemId = g.Key, Quantity = g.Sum(x => x.Quantity) })
            .ToDictionaryAsync(x => x.OrderItemId, x => x.Quantity);
        splitPaymentItems = activeSplitItems.Select(i =>
        {
            var alreadyPaid = paid.TryGetValue(i.Id, out var q) ? q : 0;
            var remaining = i.Quantity - alreadyPaid;
            if (remaining <= 0) return null;
            return new OrderItem { Id = i.Id, OrderId = i.OrderId, MenuItemId = i.MenuItemId, MenuItem = i.MenuItem, Quantity = remaining, ExtrasPrice = i.ExtrasPrice, Notes = i.Notes, IsCancelled = false };
        }).Where(i => i is not null).Select(i => i!).ToList();
        splitQuantities = splitPaymentItems.ToDictionary(i => i.Id, _ => 0);

        if (splitPaymentItems.Count == 0)

        {

            fiscalError = "Δεν υπάρχουν ενεργά είδη για split πληρωμή.";

            return;

        }

        isSplitPaymentFlow = true;

        closeStep = 7;

    }



    private void SetSplitQuantity(int itemId, string? value)

    {

        if (!int.TryParse(value, out var q)) q = 0;

        var item = splitPaymentItems.FirstOrDefault(i => i.Id == itemId);

        splitQuantities[itemId] = Math.Clamp(q, 0, item?.Quantity ?? 0);

    }



    private void ContinueSplitPayment()

    {

        fiscalError = null;

        if (SplitSelectedTotal <= 0)

        {

            fiscalError = "Επίλεξε τουλάχιστον ένα τεμάχιο.";

            return;

        }

        closeStep = 8;

    }



    private async Task SelectSplitPayment(PaymentMethod method)

    {

        selectedPaymentMethod = method;

        cardFiscalRetryOnly = false;
        cardFiscalRetryRequiresRecovery = false;
        if (method == PaymentMethod.Card)
        {
            await LoadCardPosSettingsAsync();
            using var db = await DbFactory.CreateDbContextAsync();
            var savedOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
            if (savedOrder is not null && savedOrder.Status == OrderStatus.Open &&
                (savedOrder.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) &&
                !string.IsNullOrWhiteSpace(savedOrder.CardTransactionId))
            {
                cardFiscalRetryOnly = true;
                cardTransactionId = savedOrder.CardTransactionId.Trim();
                pendingCardTerminalId = savedOrder.CardTerminalId ?? string.Empty;
                pendingCardDocumentKind = savedOrder.DocumentKind is FiscalDocumentKind.Receipt or FiscalDocumentKind.Invoice
                    ? savedOrder.DocumentKind.Value
                    : FiscalDocumentKind.Receipt;

                var isEdpsWebEcr = cardPosSettings.Any(x => x.Provider == "EDPS" &&
                    x.Protocol.Contains("WebECR API v6") &&
                    string.Equals(x.TerminalId?.Trim(), savedOrder.CardTerminalId?.Trim(), StringComparison.OrdinalIgnoreCase));
                var expectedPaymentExternalSystemIdPrefix = $"payment-{savedOrder.Id}-";
                cardFiscalRetryRequiresRecovery = isEdpsWebEcr && savedOrder.ParochosMark is null &&
                    !string.IsNullOrWhiteSpace(savedOrder.ParochosPaymentUid) &&
                    !(savedOrder.ParochosExternalId?.StartsWith(expectedPaymentExternalSystemIdPrefix, StringComparison.OrdinalIgnoreCase) ?? false);

                fiscalError = cardFiscalRetryRequiresRecovery
                    ? "Η παλιά προσπάθεια χρέωσε την κάρτα αλλά συνέδεσε την υπογραφή με διαφορετικό αναγνωριστικό παραστατικού. Δεν γίνεται ασφαλής επανέκδοση από εδώ. Μην ξαναστείλεις ποσό στο POS· χρειάζεται ανάκτηση από τα στοιχεία Parochos."
                    : "Υπάρχει ήδη εγκεκριμένη συναλλαγή. Θα επαναληφθεί μόνο η έκδοση του ίδιου παραστατικού, χωρίς νέα χρέωση.";
                closeStep = 2;
                return;
            }
        }

        closeStep = 9;

    }



    private List<OrderItem> BuildSelectedSplitItems() => splitPaymentItems

        .Where(i => splitQuantities.TryGetValue(i.Id, out var q) && q > 0)

        .Select(i => new OrderItem

        {

            Id = i.Id,

            OrderId = i.OrderId,

            MenuItemId = i.MenuItemId,

            MenuItem = i.MenuItem,

            Quantity = splitQuantities[i.Id],

            ExtrasPrice = i.ExtrasPrice,

            Notes = i.Notes,

            IsCancelled = false

        }).ToList();



    private async Task IssueSelectedPayment(FiscalDocumentKind kind)

    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;


        fiscalError = null;

        splitDocumentKind = kind;

        var selected = BuildSelectedSplitItems();

        if (selected.Count == 0) { fiscalError = "Δεν επιλέχθηκαν είδη."; return; }



        if (cardFiscalRetryOnly)
        {
            if (kind != pendingCardDocumentKind)
            {
                fiscalError = "Η ήδη εγκεκριμένη πληρωμή είναι συνδεδεμένη με συγκεκριμένο τύπο παραστατικού. Δεν ξεκίνησε νέα χρέωση.";
                return;
            }
            await RetryApprovedCardFiscalDocument();
            return;
        }

        if (kind == FiscalDocumentKind.Invoice)

        {

            closeStep = 3;

            return;

        }



        if (selectedPaymentMethod is PaymentMethod.Card or PaymentMethod.Iris)

        {

            using var db = await DbFactory.CreateDbContextAsync();

            var o = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);

            if (o is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }

            if (SelectedCardPosSetting is null) { fiscalError = "Επίλεξε ενεργό συνδεδεμένο POS."; return; }
            var prep = await Fiscal.PrepareSelectedCardPaymentAsync(db, o, selected, kind, SelectedCardPosSetting);

            if (!prep.Success) { fiscalError = prep.ErrorMessage; return; }

            splitPendingCardPayment = prep;
            edpsRetryWithFreshProviderData = false;
            edpsStatusCheckRequired = false;

            pendingCardAmount = prep.Amount;

            pendingCardTerminalId = prep.TerminalId;

            pendingCardDocumentKind = kind;

            cardTransactionId = "";

            closeStep = 10;

            return;

        }



        await CompleteSplitPayment(null);

    }



    private async Task LoadCardPosSettingsAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        cardPosSettings = await db.BankPosTerminalSettings
            .Where(x => x.IsEnabled &&
                (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR") ||
                 (x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6")) ||
                 (x.Provider.ToLower() == "viva" && x.Protocol.ToLower() == "viva cloud")))
            .OrderByDescending(x => x.UpdatedAt)
            .ThenBy(x => x.Name)
            .ToListAsync();
        cardPosSettings = cardPosSettings.Where(x =>
            CommonWebEcrProviderProfile.IsCommonRest(x)
                ? MellonConnectionSettings.IsConnected(x)
                : x.Provider.Contains("ePay", StringComparison.OrdinalIgnoreCase) ||
                  x.Provider.Contains("Euronet", StringComparison.OrdinalIgnoreCase) ||
                  (x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6")) ||
                  IsVivaCloudSetting(x)).ToList();
        selectedCardPosSettingsId = cardPosSettings.FirstOrDefault()?.Id ?? 0;
        CardPosChanged();
        if (cardPosSettings.Count == 0)
            fiscalError = "Δεν υπάρχει ενεργό συνδεδεμένο POS. Έλεγξε τις ρυθμίσεις στα Τραπεζικά POS.";
    }

    private async Task SelectCardPosForInvoiceAsync(int settingsId, bool isSplit)
    {
        selectedCardPosSettingsId = settingsId;
        CardPosChanged();
        if (isSplit) await IssueSelectedPayment(FiscalDocumentKind.Invoice);
        else await SelectDocumentKind(FiscalDocumentKind.Invoice);
    }

    private async Task StartCardPaymentFromPosAsync(int settingsId, bool isSplit)
    {
        if (cardPosLaunchBusy || epayBusy) return;
        cardPosLaunchBusy = true;
        try
        {
            selectedPaymentMethod = PaymentMethod.Card;
            selectedCardPosSettingsId = settingsId;
            CardPosChanged();

            using (var settingsDb = await DbFactory.CreateDbContextAsync())
            {
                var selectedTerminal = await settingsDb.BankPosTerminalSettings
                    .FirstOrDefaultAsync(x => x.Id == settingsId && x.IsEnabled);
                if (selectedTerminal?.AadePreloaded == true)
                {
                    if (isSplit)
                    {
                        fiscalError = "Η προφορτωμένη πληρωμή AADE λειτουργεί μόνο για εξόφληση ολόκληρου του παραστατικού. Για μερική πληρωμή απενεργοποίησε την προφόρτωση για αυτό το POS.";
                        return;
                    }
                    await StartAadePreloadedCardPaymentAsync(selectedTerminal);
                    return;
                }
            }

            if (isSplit) await IssueSelectedPayment(FiscalDocumentKind.Receipt);
            else await SelectDocumentKind(FiscalDocumentKind.Receipt);

            if (isSplit ? closeStep != 10 : closeStep != 6) return;

            if (IsSelectedVivaCloud)
            {
                await StartSelectedVivaPayment(isSplit);
                return;
            }
            if (IsSelectedEdpsWebEcr)
            {
                if (isSplit) await StartEdpsSplitCardPayment();
                else await StartEdpsFullCardPayment();
                return;
            }
            if (!IsSelectedMellonWebEcr)
            {
                selectedEpaySettingsId = settingsId;
                await LoadEpayTerminals(isSplit);
                if (epayTerminals.Count == 1)
                {
                    selectedEpayBackendId = epayTerminals[0].BackendId;
                    await ChargeEpayBackendAsync(isSplit, selectedEpayBackendId);
                }
                return;
            }

            if (isSplit) await StartEpaySplitCardPayment();
            else await StartEpayFullCardPayment();
        }
        finally
        {
            cardPosLaunchBusy = false;
        }
    }

    private async Task StartAadePreloadedCardPaymentAsync(BankPosTerminalSettings terminal)
    {
        fiscalError = null;
        aadePreloadedPaymentFlow = true;
        aadePreloadedSubmitPending = false;
        if (terminal is null || !terminal.AadePreloaded) { fiscalError = "Το επιλεγμένο POS δεν έχει ενεργή προφόρτωση."; return; }
        if (order.DocumentKind is not null || order.FiscalStatus == FiscalStatus.Issued || order.Payments.Any())
        { fiscalError = "Η προφόρτωση ξεκινά μόνο πριν εκδοθεί παραστατικό ή καταχωριστεί πληρωμή."; return; }

        CardPaymentPreparation preparation;
        using (var paymentDb = await DbFactory.CreateDbContextAsync())
        {
            var pendingOrder = await paymentDb.Orders.Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                .FirstOrDefaultAsync(x => x.Id == order.Id);
            if (pendingOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
            preparation = await Fiscal.PrepareCardPaymentAsync(paymentDb, pendingOrder, FiscalDocumentKind.Receipt, terminal);
            if (!preparation.Success || preparation.ProviderData is null)
            { fiscalError = "Δεν δημιουργήθηκαν τα υπογεγραμμένα στοιχεία για προφόρτωση: " + (preparation.ErrorMessage ?? "άγνωστο σφάλμα"); return; }
            pendingOrder.PaymentMethod = PaymentMethod.Credit;
            pendingOrder.DocumentKind = FiscalDocumentKind.Receipt;
            pendingOrder.ParochosPaymentSignature = preparation.ProviderData.OriginalSignature?.Trim() ?? preparation.Signature;
            pendingOrder.ParochosPaymentUid = preparation.ProviderData.Uid;
            pendingOrder.CardTerminalId = preparation.TerminalId;
            pendingOrder.CardNspCode = preparation.NspCode;
            pendingOrder.ParochosExternalId = preparation.ExternalSystemId;
            pendingOrder.InvoiceSeriesName = preparation.SeriesName;
            pendingOrder.InvoiceNumber = preparation.InvoiceNumber;
            await paymentDb.SaveChangesAsync();
        }

        pendingCardPayment = preparation;
        pendingCardDocumentKind = FiscalDocumentKind.Receipt;
        pendingCardAmount = preparation.Amount;
        pendingCardTerminalId = preparation.TerminalId;
        cardTransactionId = "";
        selectedPaymentMethod = PaymentMethod.Credit;
        closeStep = 6;

        if (IsSelectedVivaCloud)
        {
            await StartSelectedVivaPayment(false);
            return;
        }
        if (IsSelectedEdpsWebEcr)
        {
            await StartEdpsFullCardPayment();
            return;
        }
        if (IsSelectedMellonWebEcr)
        {
            await StartEpayFullCardPayment();
            return;
        }

        selectedEpaySettingsId = terminal.Id;
        await LoadEpayTerminals(false);
        if (epayTerminals.Count == 1)
        {
            selectedEpayBackendId = epayTerminals[0].BackendId;
            await ChargeEpayBackendAsync(false, selectedEpayBackendId);
        }
    }

    private async Task SubmitStoredAadePreloadedPaymentAsync(AppDbContext db, Order storedOrder)
    {
        if (storedOrder.PaymentMethod is not (PaymentMethod.Card or PaymentMethod.Iris))
            storedOrder.PaymentMethod = PaymentMethod.Card; // POS EFT transaction; use generic card mapping if the terminal omitted its subtype.
        var methodInfo = storedOrder.PaymentMethod == PaymentMethod.Iris ? "IRIS" : "Κάρτα";
        var result = await Fiscal.SubmitPreloadedPaymentAsync(db, storedOrder,
            FiscalPayloadBuilder.CalculateTotals(storedOrder).Gross, storedOrder.CardTransactionId!, storedOrder.ParochosPaymentSignature!,
            storedOrder.CardTerminalId!, methodInfo);
        if (!result.Success)
        {
            fiscalError = "Η πληρωμή εγκρίθηκε στο POS και η απόδειξη έχει ήδη εκδοθεί, αλλά η καταχώριση της συναλλαγής στον πάροχο δεν επιβεβαιώθηκε. Μην ξαναχρεώσεις την κάρτα. Πάτησε «Επανάληψη καταχώρισης» για να σταλεί ξανά το ίδιο transaction. " + (result.ErrorMessage ?? "");
            aadePreloadedSubmitPending = true;
            closeStep = 6;
            return;
        }
        aadePreloadedSubmitPending = false;
        aadePreloadedPaymentFlow = false;
        selectedPaymentMethod = storedOrder.PaymentMethod;
        cardTransactionId = storedOrder.CardTransactionId!;
        lastDocumentLabel = "Απόδειξη";
        lastSeriesAndNumber = $"{storedOrder.InvoiceSeriesName} {storedOrder.InvoiceNumber}";
        lastMark = storedOrder.ParochosMark;
        lastPrintSucceeded = true;
        lastPrintStatus = "Η απόδειξη εκδόθηκε και η συναλλαγή POS καταχωρίστηκε στον πάροχο.";
        closeStep = 5;
    }

    private async Task RetryAadePreloadedSubmitAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var storedOrder = await db.Orders.Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
            .FirstOrDefaultAsync(x => x.Id == order.Id);
        if (storedOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
        await SubmitStoredAadePreloadedPaymentAsync(db, storedOrder);
    }

    private async Task CompleteAadePreloadedPaymentAsync(
        AppDbContext db, Order currentOrder, CardPaymentPreparation preparation,
        string? transactionId, PaymentMethod method, string terminalId, bool preloadedAccepted = false)
    {
        if (!preloadedAccepted || string.IsNullOrWhiteSpace(transactionId))
        {
            fiscalError = "Το POS δεν επιβεβαίωσε ότι δέχτηκε την προφόρτωση. Δεν εκδόθηκε απόδειξη. Έλεγξε την κατάσταση στο POS πριν επαναλάβεις.";
            closeStep = 6;
            return;
        }
        currentOrder.PaymentMethod = PaymentMethod.Credit;
        currentOrder.CardTerminalId = terminalId.Trim();
        currentOrder.CardNspCode = preparation.NspCode;
        currentOrder.ParochosPaymentSignature = preparation.ProviderData?.OriginalSignature?.Trim() ?? preparation.Signature;
        currentOrder.ParochosPaymentUid = preparation.ProviderData?.Uid ?? preparation.Uid;
        currentOrder.AadePreloadedTerminalSettingsId = selectedCardPosSettingsId;
        currentOrder.AadePreloadedIntentId = transactionId.Trim();
        currentOrder.AadePreloadedStatus = "Pending";
        currentOrder.AadePreloadedAt = DateTime.UtcNow;
        currentOrder.AadePreloadedStatusMessage = "POS accepted preload; awaiting customer payment.";
        await db.SaveChangesAsync();
        // The POS has accepted the preloaded transaction; now issue the fiscal
        // receipt as credit. Actual payment settlement is a separate cashier action.
        await IssueAndClose(FiscalDocumentKind.Receipt);
    }

    private async Task ChargeEpayBackendAsync(bool isSplit, string backendId)
    {
        if (epayBusy || string.IsNullOrWhiteSpace(backendId)) return;
        selectedEpayBackendId = backendId;
        if (isSplit) await StartEpaySplitCardPayment();
        else await StartEpayFullCardPayment();
    }

    private async Task LoadEpayTerminals(bool isSplit)
    {
        if (epayBusy) return;
        epayBusy = true;
        fiscalError = null;
        epayTerminals.Clear();
        selectedEpayBackendId = "";
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings
                .FirstOrDefaultAsync(x => x.Id == selectedCardPosSettingsId && x.IsEnabled &&
                    (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR")));
            if (terminal is null && selectedCardPosSettingsId == 0)
                terminal = await db.BankPosTerminalSettings
                    .Where(x => x.IsEnabled && (x.Provider.Contains("ePay") || x.Provider.Contains("Euronet") || x.Protocol.Contains("Common WebECR")))
                    .OrderByDescending(x => x.UpdatedAt).FirstOrDefaultAsync();
            if (terminal is null) { fiscalError = "Δεν υπάρχει ενεργή σύνδεση WebECR (ePay / Mellon) στις Ρυθμίσεις → Τραπεζικά POS."; return; }
            selectedEpaySettingsId = terminal.Id;
            selectedEpayProviderCode = terminal.ProviderCode ?? "";
            var result = await Epay.GetTerminalsAsync(terminal);
            if (!result.Success) { fiscalError = result.Message; return; }
            epayTerminals = result.Terminals?.ToList() ?? new();
            if (epayTerminals.Count == 0) fiscalError = "Το ePay δεν επέστρεψε διαθέσιμα POS. Έλεγξε την εξουσιοδότηση WebECR.";
        }
        catch (Exception ex) { fiscalError = "Σφάλμα αναζήτησης POS: " + ex.Message; }
        finally { epayBusy = false; }
    }

    private async Task StartEpaySplitCardPayment()
    {
        if (epayBusy) return;
        await StartSelectedEpayPayment(true);
    }

    private async Task StartEpayFullCardPayment()
    {
        if (epayBusy) return;
        await StartSelectedEpayPayment(false);
    }

    private async Task StartSelectedEpayPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        var isMellon = IsSelectedMellonWebEcr;
        if (isMellon && !string.IsNullOrWhiteSpace(cardTransactionId))
        {
            if (isSplit) await CompleteSplitCardPayment();
            else if (aadePreloadedPaymentFlow) await RetryAadePreloadedSubmitAsync();
            else await CompleteCardPayment();
            return;
        }
        if (!isMellon && string.IsNullOrWhiteSpace(selectedEpayBackendId)) { fiscalError = "Επίλεξε πρώτα διαθέσιμο POS."; return; }
        epayBusy = true; fiscalError = null;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var settingsId = isMellon ? selectedCardPosSettingsId : selectedEpaySettingsId;
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x => x.Id == settingsId && x.IsEnabled);
            if (terminal is null) { fiscalError = "Η σύνδεση ePay δεν είναι πλέον ενεργή. Κάνε ξανά αναζήτηση POS."; return; }
            if (isMellon && !MellonConnectionSettings.IsConnected(terminal))
            { fiscalError = "Το επιλεγμένο Mellon POS δεν είναι πλέον συνδεδεμένο. Έλεγξε τις ρυθμίσεις του."; return; }
            var reference = BuildEpayCustomerReference(order.Id);
            ProviderPaymentData? providerData;
            string? signedTerminalId;
            CardPaymentPreparation? cardPreparation = null;
            if (isSplit)
            {
                providerData = splitPendingCardPayment?.ProviderData;
                signedTerminalId = splitPendingCardPayment?.TerminalId;
            }
            else
            {
                // Full-payment signature must be generated for the full order amount immediately before txninit.
                var currentOrderForSignature = await db.Orders
                    .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                    .FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrderForSignature is null) { fiscalError = "Η παραγγελία δεν βρέθηκε για υπογραφή πληρωμής."; return; }
                var prep = aadePreloadedPaymentFlow
                    ? pendingCardPayment ?? new CardPaymentPreparation { Success = false, ErrorMessage = "Δεν υπάρχει προετοιμασμένη προφορτωμένη υπογραφή." }
                    : await Fiscal.PrepareCardPaymentAsync(db, currentOrderForSignature, isMellon ? pendingCardDocumentKind : FiscalDocumentKind.Receipt, terminal);
                if (!prep.Success) { fiscalError = prep.ErrorMessage ?? "Αποτυχία προετοιμασίας υπογραφής παρόχου."; return; }
                cardPreparation = prep;
                providerData = prep.ProviderData;
                signedTerminalId = prep.TerminalId;
            }
            if (providerData is null) { fiscalError = "Δεν δημιουργήθηκαν ProviderData από τον πάροχο. Δεν ξεκίνησε χρέωση."; return; }
            if (isMellon && isSplit && (!string.Equals(splitPendingCardPayment?.NspCode, terminal.ParochosNspCode.Trim(), StringComparison.Ordinal) ||
                providerData.ProviderId != terminal.ProviderId))
            { fiscalError = "Άλλαξαν οι ρυθμίσεις υπογραφής του Mellon POS. Επίλεξε ξανά POS και παραστατικό πριν τη χρέωση."; return; }
            var selectedEpayTerminal = isMellon
                ? new EpayWebEcrService.TerminalChoice(terminal.IdUrl, terminal.TerminalId, terminal.MerchantId, terminal.ProviderCode)
                : epayTerminals.FirstOrDefault(x => x.BackendId == selectedEpayBackendId);
            if (selectedEpayTerminal is null) { fiscalError = "Selected WebECR POS was not found. No charge was started."; return; }
            if (!string.Equals(signedTerminalId?.Trim(), selectedEpayTerminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                fiscalError = $"Parochos signature TID ({signedTerminalId ?? "<missing>"}) does not match selected ePay POS TID ({selectedEpayTerminal.TerminalId}). No charge was started.";
                return;
            }
            var result = isMellon
                ? await ChargeMellonAsync(terminal, pendingCardAmount, reference, providerData)
                : await Epay.ChargeAsync(terminal, pendingCardAmount, reference, default, selectedEpayBackendId, providerData);
            if (!result.Success) { fiscalError = result.Message; return; }
            selectedPaymentMethod = MapPosPaymentType(result.PaymentType) ?? PaymentMethod.None;
            cardTransactionId = result.TransactionId;
            pendingCardTerminalId = selectedEpayTerminal.TerminalId;
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    if (!result.PreloadedAccepted)
                    {
                        currentOrder.PaymentMethod = selectedPaymentMethod;
                        currentOrder.CardTransactionId = result.TransactionId;
                    }
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    // Store the Parochos/AADE NSP code, not ePay WebECR ProviderId.
                    currentOrder.CardNspCode = cardPreparation?.NspCode ?? "2";
                    if (cardPreparation is not null)
                    {
                        currentOrder.ParochosExternalId = cardPreparation.ExternalSystemId;
                        currentOrder.InvoiceSeriesName = cardPreparation.SeriesName;
                        currentOrder.InvoiceNumber = cardPreparation.InvoiceNumber;
                        currentOrder.DocumentKind = isMellon ? pendingCardDocumentKind : FiscalDocumentKind.Receipt;
                        currentOrder.ParochosPaymentSignature = cardPreparation.Signature;
                        currentOrder.ParochosPaymentUid = cardPreparation.Uid;
                    }
                    await db.SaveChangesAsync();
                }
            }
            if (isSplit) await CompleteSplitCardPayment();
            else if (aadePreloadedPaymentFlow && cardPreparation is not null)
            {
                var chargedOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (chargedOrder is not null)
                    await CompleteAadePreloadedPaymentAsync(db, chargedOrder, cardPreparation, result.TransactionId, selectedPaymentMethod, selectedEpayTerminal.TerminalId, result.PreloadedAccepted);
            }
            else await CompleteCardPayment();
        }
        finally { epayBusy = false; }
    }

    private async Task<EpayWebEcrService.PaymentResult> ChargeMellonAsync(
        BankPosTerminalSettings terminal, decimal amount, string reference, ProviderPaymentData providerData)
    {
        var result = await Mellon.ChargeAsync(terminal, amount, reference, providerData: providerData);
        return new(result.Success, result.TransactionId, result.Message, result.IntentId, result.PaymentType, result.PreloadedAccepted);
    }

    private static string BuildEpayCustomerReference(int orderId)
    {
        var athensTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "GTB Standard Time" : "Europe/Athens");
        var localTimestamp = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, athensTimeZone)
            .ToString("yyyyMMddHHmmss", System.Globalization.CultureInfo.InvariantCulture);
        var orderReference = orderId.ToString("D10", System.Globalization.CultureInfo.InvariantCulture);
        var randomSuffix = System.Security.Cryptography.RandomNumberGenerator
            .GetInt32(0, 1_000_000_000)
            .ToString("D9", System.Globalization.CultureInfo.InvariantCulture);
        return orderReference + localTimestamp + randomSuffix;
    }

    private async Task StartEdpsSplitCardPayment()
    {
        if (epayBusy) return;
        await StartSelectedEdpsPayment(true);
    }

    private async Task StartEdpsFullCardPayment()
    {
        if (epayBusy) return;
        await StartSelectedEdpsPayment(false);
    }

    private async Task StartSelectedVivaPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (epayBusy) return;
        if (!string.IsNullOrWhiteSpace(cardTransactionId))
        {
            // A successful card payment followed by a fiscal failure is a fiscal retry only.
            epayBusy = true;
            try
            {
                if (isSplit) await CompleteSplitCardPayment();
                else if (aadePreloadedPaymentFlow) await RetryAadePreloadedSubmitAsync();
                else await CompleteCardPayment();
            }
            finally { epayBusy = false; }
            return;
        }
        var retryAfterManualStatusCheck = vivaStatusCheckRequired;
        if (retryAfterManualStatusCheck)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Η προηγούμενη προσπάθεια Viva δεν επιβεβαιώθηκε. Έλεγξε πρώτα το ιστορικό συναλλαγών της Viva και το POS. Αν υπάρχει χρέωση, πάτησε Άκυρο. Μόνο αν επιβεβαίωσες ότι δεν χρεώθηκε, πάτησε OK για νέα προσπάθεια με νέα υπογραφή Parochos.");
            if (!confirmed) return;
            vivaStatusCheckRequired = false;
        }
        epayBusy = true;
        fiscalError = null;
        var requestMayHaveStarted = false;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x =>
                x.Id == selectedCardPosSettingsId && x.IsEnabled && x.Provider.ToLower() == "viva" && x.Protocol.ToLower() == "viva cloud");
            if (terminal is null) { fiscalError = "Η σύνδεση Viva δεν είναι πλέον ενεργή. Επίλεξε ξανά το POS."; return; }

            var preparation = isSplit ? splitPendingCardPayment : pendingCardPayment;
            if (retryAfterManualStatusCheck || preparation is null || !preparation.Success || preparation.ProviderData is null)
            {
                if (isSplit)
                {
                    var currentOrder = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
                    preparation = await Fiscal.PrepareSelectedCardPaymentAsync(db, currentOrder, BuildSelectedSplitItems(), pendingCardDocumentKind, terminal);
                    splitPendingCardPayment = preparation;
                }
                else
                {
                    var currentOrder = await db.Orders.Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; return; }
                    preparation = await Fiscal.PrepareCardPaymentAsync(db, currentOrder, pendingCardDocumentKind, terminal);
                    pendingCardPayment = preparation;
                }
            }
            if (preparation is null || !preparation.Success || preparation.ProviderData is null)
            { fiscalError = preparation?.ErrorMessage ?? "Δεν δημιουργήθηκε έγκυρη υπογραφή Parochos. Δεν ξεκίνησε χρέωση."; return; }
            if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            { fiscalError = "Το Terminal ID της υπογραφής Parochos δεν ταιριάζει με το επιλεγμένο Viva POS. Δεν ξεκίνησε χρέωση."; return; }
            var expectedCents = decimal.ToInt64(decimal.Round(pendingCardAmount * 100m, 0, MidpointRounding.AwayFromZero));
            var signedCents = decimal.ToInt64(decimal.Round(preparation.Amount * 100m, 0, MidpointRounding.AwayFromZero));
            if (expectedCents != signedCents)
            { pendingCardAmount = preparation.Amount; fiscalError = "Το ποσό της υπογραφής Parochos διαφέρει από το ποσό πληρωμής. Ελέγξτε το νέο ποσό και ξεκινήστε ξανά."; return; }

            requestMayHaveStarted = true;
            var reference = $"RO-{order.Id}-{(isSplit ? "SPLIT-" : "")}{Guid.NewGuid():N}";
            var result = await Viva.ChargeAsync(terminal, preparation.Amount, reference, preparation.ProviderData);
            vivaPendingSessionId = result.SessionId;
            if (!result.Success)
            {
                fiscalError = result.Message;
                vivaStatusCheckRequired = result.RequiresStatusCheck;
                return;
            }

            selectedPaymentMethod = result.PaymentMethod ?? PaymentMethod.None;
            cardTransactionId = result.TransactionId ?? "";
            pendingCardTerminalId = terminal.TerminalId.Trim();
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    if (!result.PreloadedAccepted)
                    {
                        currentOrder.PaymentMethod = selectedPaymentMethod;
                        currentOrder.CardTransactionId = result.TransactionId;
                    }
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    currentOrder.CardNspCode = preparation.NspCode;
                    currentOrder.ParochosExternalId = preparation.ExternalSystemId;
                    currentOrder.InvoiceSeriesName = preparation.SeriesName;
                    currentOrder.InvoiceNumber = preparation.InvoiceNumber;
                    currentOrder.DocumentKind = pendingCardDocumentKind;
                    currentOrder.ParochosPaymentSignature = preparation.Signature;
                    currentOrder.ParochosPaymentUid = preparation.Uid;
                    await db.SaveChangesAsync();
                }
            }
            vivaStatusCheckRequired = false;
            if (isSplit) await CompleteSplitCardPayment();
            else if (aadePreloadedPaymentFlow && preparation is not null)
            {
                var chargedOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (chargedOrder is not null)
                    await CompleteAadePreloadedPaymentAsync(db, chargedOrder, preparation, result.TransactionId, selectedPaymentMethod, terminal.TerminalId, result.PreloadedAccepted);
            }
            else await CompleteCardPayment();
        }
        catch (Exception ex)
        {
            if (requestMayHaveStarted)
            {
                vivaStatusCheckRequired = true;
                fiscalError = "Δεν επιβεβαιώθηκε το αποτέλεσμα από τη Viva. Έλεγξε το ιστορικό POS πριν από οποιαδήποτε νέα προσπάθεια. " + ex.Message;
            }
            else fiscalError = "Σφάλμα προετοιμασίας Viva. Δεν ξεκίνησε χρέωση. " + ex.Message;
        }
        finally { epayBusy = false; }
    }

    private async Task StartSelectedEdpsPayment(bool isSplit)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (epayBusy) return;
        if (edpsStatusCheckRequired)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Η κατάσταση της προηγούμενης προσπάθειας δεν επιβεβαιώθηκε από το EDPS. Έλεγξε το ιστορικό του POS. Αν επιβεβαίωσες ότι απορρίφθηκε και δεν χρεώθηκε, πάτησε OK για να δημιουργηθεί νέα υπογραφή Parochos και να σταλεί αμέσως νέα προσπάθεια. Αν εγκρίθηκε, πάτησε Άκυρο.");
            if (!confirmed) return;
            edpsStatusCheckRequired = false;
            edpsRetryWithFreshProviderData = true;
        }
        epayBusy = true;
        fiscalError = null;
        var txnInitMayHaveStarted = false;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(
                x => x.Id == selectedCardPosSettingsId && x.IsEnabled && x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6"));
            if (terminal is null)
            {
                fiscalError = "Η σύνδεση EDPS δεν είναι πλέον ενεργή. Επίλεξε ξανά τερματικό κάρτας.";
                return;
            }

            var preparation = isSplit ? splitPendingCardPayment : pendingCardPayment;
            if (edpsRetryWithFreshProviderData)
            {
                if (isSplit)
                {
                    var currentOrder = await db.Orders.Include(x => x.RestaurantTable)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null)
                    {
                        fiscalError = "Η παραγγελία δεν βρέθηκε. Δεν ξεκίνησε χρέωση.";
                        return;
                    }
                    var selected = BuildSelectedSplitItems();
                    preparation = await Fiscal.PrepareSelectedCardPaymentAsync(
                        db, currentOrder, selected, pendingCardDocumentKind, terminal);
                }
                else
                {
                    var currentOrder = await db.Orders
                        .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                        .FirstOrDefaultAsync(x => x.Id == order.Id);
                    if (currentOrder is null)
                    {
                        fiscalError = "Η παραγγελία δεν βρέθηκε. Δεν ξεκίνησε χρέωση.";
                        return;
                    }
                    preparation = await Fiscal.PrepareCardPaymentAsync(
                        db, currentOrder, pendingCardDocumentKind, terminal);
                }

                if (!preparation.Success || preparation.ProviderData is null)
                {
                    fiscalError = preparation.ErrorMessage ?? "Ο Parochos δεν επέστρεψε νέα υπογραφή. Δεν ξεκίνησε χρέωση.";
                    return;
                }
                var previousAmountCents = decimal.ToInt32(decimal.Round(pendingCardAmount * 100m, 0, MidpointRounding.AwayFromZero));
                var newAmountCents = decimal.ToInt32(decimal.Round(preparation.Amount * 100m, 0, MidpointRounding.AwayFromZero));
                if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    fiscalError = "Το TID της νέας υπογραφής Parochos δεν ταιριάζει με το επιλεγμένο EDPS POS. Δεν ξεκίνησε χρέωση.";
                    return;
                }

                if (isSplit)
                    splitPendingCardPayment = preparation;
                else
                    pendingCardPayment = preparation;
                pendingCardTerminalId = preparation.TerminalId;
                if (previousAmountCents != newAmountCents)
                {
                    pendingCardAmount = preparation.Amount;
                    edpsRetryWithFreshProviderData = false;
                    fiscalError = "Το ποσό άλλαξε. Εμφανίζεται το νέο σύνολο με νέα υπογραφή Parochos· έλεγξέ το και πάτησε ξανά αποστολή. Δεν ξεκίνησε χρέωση.";
                    return;
                }

                edpsRetryWithFreshProviderData = false;
            }

            var providerData = preparation?.ProviderData;
            if (preparation is null || !preparation.Success || providerData is null)
            {
                fiscalError = "Δεν υπάρχουν έγκυρα ProviderData Parochos για το EDPS. Δεν ξεκίνησε χρέωση.";
                return;
            }
            if (!string.Equals(preparation.TerminalId.Trim(), terminal.TerminalId.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                fiscalError = $"Το TID της υπογραφής Parochos ({preparation.TerminalId}) δεν ταιριάζει με το επιλεγμένο EDPS POS ({terminal.TerminalId}). Δεν ξεκίνησε χρέωση.";
                return;
            }

            var reference = isSplit
                ? $"RO-SPLIT-{order.Id}-{Guid.NewGuid():N}"
                : $"RO-{order.Id}-{Guid.NewGuid():N}";
            txnInitMayHaveStarted = true;
            var result = await Edps.ChargeAsync(terminal, preparation.Amount, reference, providerData);
            if (!result.Success)
            {
                fiscalError = result.Message;
                edpsRetryWithFreshProviderData = result.RetryRequiresFreshProviderData;
                edpsStatusCheckRequired = result.RequiresStatusCheck;
                return;
            }

            selectedPaymentMethod = MapPosPaymentType(result.PaymentType) ?? PaymentMethod.None;
            edpsRetryWithFreshProviderData = false;
            edpsStatusCheckRequired = false;
            cardTransactionId = result.TransactionId;
            pendingCardTerminalId = terminal.TerminalId.Trim();
            if (!isSplit)
            {
                var currentOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (currentOrder is not null)
                {
                    if (!result.PreloadedAccepted)
                    {
                        currentOrder.PaymentMethod = selectedPaymentMethod;
                        currentOrder.CardTransactionId = result.TransactionId;
                    }
                    currentOrder.CardTerminalId = pendingCardTerminalId;
                    currentOrder.CardNspCode = preparation.NspCode;
                    currentOrder.ParochosExternalId = preparation.ExternalSystemId;
                    currentOrder.InvoiceSeriesName = preparation.SeriesName;
                    currentOrder.InvoiceNumber = preparation.InvoiceNumber;
                    currentOrder.DocumentKind = pendingCardDocumentKind;
                    currentOrder.ParochosPaymentSignature = preparation.Signature;
                    currentOrder.ParochosPaymentUid = preparation.Uid;
                    await db.SaveChangesAsync();
                }
            }

            if (isSplit) await CompleteSplitCardPayment();
            else if (aadePreloadedPaymentFlow && preparation is not null)
            {
                var chargedOrder = await db.Orders.FirstOrDefaultAsync(x => x.Id == order.Id);
                if (chargedOrder is not null)
                    await CompleteAadePreloadedPaymentAsync(db, chargedOrder, preparation, result.TransactionId, selectedPaymentMethod, terminal.TerminalId, result.PreloadedAccepted);
            }
            else await CompleteCardPayment();
        }
        catch (Exception)
        {
            if (txnInitMayHaveStarted)
            {
                edpsStatusCheckRequired = true;
                fiscalError = "Δεν επιβεβαιώθηκε η απάντηση του EDPS. Έλεγξε το ιστορικό του POS πριν από νέα προσπάθεια.";
            }
            else
            {
                fiscalError = "Σφάλμα προετοιμασίας της συναλλαγής EDPS. Δεν ξεκίνησε χρέωση.";
            }
        }
        finally
        {
            epayBusy = false;
        }
    }

    private async Task CompleteSplitCardPayment()

    {

        if (selectedPaymentMethod is not (PaymentMethod.Card or PaymentMethod.Iris))
        {
            fiscalError = "Το POS ενέκρινε την πληρωμή αλλά δεν επέστρεψε αν ήταν κάρτα ή IRIS. Δεν εκδίδεται παραστατικό με εικασία και δεν πρέπει να σταλεί ξανά χρέωση. Έλεγξε το ιστορικό του POS.";
            return;
        }

        if (string.IsNullOrWhiteSpace(cardTransactionId))

        {

            fiscalError = "Συμπλήρωσε το Transaction ID από το EFT-POS.";

            return;

        }

        await CompleteSplitPayment(cardTransactionId.Trim());

    }



    private async Task<bool> PrintSplitPaymentDocumentAsync(AppDbContext db, int orderId, long? mark)
    {
        try
        {
            var printOrder = await db.Orders.AsNoTracking()
                .Include(x => x.RestaurantTable)
                .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory).ThenInclude(c => c!.PrinterStations)
                .Include(x => x.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory).ThenInclude(c => c!.PrinterStation)
                .Include(x => x.Payments).ThenInclude(p => p.Items)
                .FirstOrDefaultAsync(x => x.Id == orderId);
            if (printOrder is null) return false;

            var payment = mark is long fiscalMark
                ? printOrder.Payments.FirstOrDefault(p => p.Mark == fiscalMark)
                : printOrder.Payments.OrderByDescending(p => p.Id).FirstOrDefault();
            if (payment is null) return false;

            var paidItems = payment.Items
                .Select(pi => (Item: printOrder.Items.FirstOrDefault(i => i.Id == pi.OrderItemId), pi.Quantity))
                .Where(x => x.Item is not null && x.Quantity > 0)
                .Select(x => (Item: x.Item!, x.Quantity))
                .ToList();
            if (paidItems.Count == 0) return false;

            var printItems = paidItems.Select(x => (
                ItemName: x.Item.MenuItem?.Name ?? "Είδος",
                Quantity: x.Quantity,
                LineTotal: LineTotalForQuantity(x.Item, x.Quantity),
                VatPercent: x.Item.MenuItem?.VatPercentOverride ?? x.Item.MenuItem?.MenuCategory?.VatPercent ?? 24m)).ToList();
            var total = printItems.Sum(x => x.LineTotal);
            var stations = paidItems
                .SelectMany(x => GetCategoryPrinters(x.Item.MenuItem?.MenuCategory)
                    .Where(station => station.PrintFiscalDocuments))
                .DistinctBy(s => s.Id)
                .ToList();
            if (stations.Count == 0) return false;

            var settings = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            var waiter = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == printOrder.WaiterUserId);
            var relatedDocuments = await db.FiscalOrderDocuments.AsNoTracking()
                .Where(f => f.OrderId == orderId && f.Mark != null && !f.IsCancellation && !f.IsCancelled)
                .OrderBy(f => f.IssuedAt)
                .Select(f => $"Δελτίο παραγγελίας {f.SeriesName} {f.Number}")
                .ToListAsync();
            var documentLabel = payment.DocumentKind == FiscalDocumentKind.Invoice
                ? "ΤΙΜΟΛΟΓΙΟ"
                : payment.FiscalStatus == FiscalStatus.Issued ? "ΑΠΟΔΕΙΞΗ ΛΙΑΝΙΚΗΣ" : "ΑΠΟΔΕΙΞΗ ΠΛΗΡΩΜΗΣ";

            var allPrinted = true;
            foreach (var station in stations)
            {
                var printed = await Printer.PrintFiscalReceiptAsync(
                    station,
                    printOrder.RestaurantTable?.Name ?? tableName,
                    waiter?.FullName ?? "-",
                    documentLabel,
                    payment.SeriesName ?? "",
                    payment.InvoiceNumber ?? payment.Id,
                    payment.Mark ?? mark,
                    payment.QrCode,
                    printItems,
                    total,
                    settings,
                    printOrder,
                    payment.Id,
                    "ΠΡΩΤΟΤΥΠΟ",
                    payment.CreatedAt,
                    relatedDocuments);
                allPrinted &= printed;
            }
            return allPrinted;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠ Split payment receipt printing failed: {ex.Message}");
            return false;
        }
    }

    private async Task CompleteSplitPayment(string? transactionId)

    {

        closeStep = 4;

        fiscalError = null;

        try

        {

            using var db = await DbFactory.CreateDbContextAsync();

            var o = await db.Orders.Include(x => x.RestaurantTable).FirstOrDefaultAsync(x => x.Id == order.Id);

            if (o is null) { fiscalError = "Η παραγγελία δεν βρέθηκε."; closeStep = 7; return; }

            var selected = BuildSelectedSplitItems();

            var result = await Fiscal.IssueSelectedItemsPaymentAsync(

                db, o, selected, selectedPaymentMethod, splitDocumentKind, transactionId,

                splitPendingCardPayment?.Signature, pendingCardTerminalId,
                splitPendingCardPayment?.NspCode ?? (IsSelectedEdpsWebEcr ? "5" : "2"),
                splitPendingCardPayment?.ExternalSystemId,
                splitPendingCardPayment?.SeriesName,
                splitPendingCardPayment?.InvoiceNumber);

            if (!result.Success)

            {

                fiscalError = "Απέτυχε η έκδοση: " + result.ErrorMessage;

                closeStep = selectedPaymentMethod is PaymentMethod.Card or PaymentMethod.Iris ? 10 : 9;

                return;

            }

            lastPrintSucceeded = await PrintSplitPaymentDocumentAsync(db, o.Id, result.Mark);
            lastPrintStatus = lastPrintSucceeded
                ? "Το παραστατικό της μερικής πληρωμής στάλθηκε στον εκτυπωτή."
                : "Η πληρωμή καταχωρίστηκε, αλλά η εκτύπωση απέτυχε. Έλεγξε ότι υπάρχει ενεργός εκτυπωτής στις κατηγορίες των ειδών και ότι είναι συνδεδεμένος. Δεν χρειάζεται να ξανακάνεις την πληρωμή.";



            var activeItems = await db.OrderItems.Where(i => i.OrderId == o.Id && !i.IsCancelled)
                .Select(i => new { i.Id, i.Quantity }).ToListAsync();
            var paidQuantities = await db.OrderPaymentItems
                .Where(pi => pi.OrderPayment != null && pi.OrderPayment.OrderId == o.Id && pi.OrderPayment.FiscalStatus == FiscalStatus.Issued)
                .GroupBy(pi => pi.OrderItemId).Select(g => new { OrderItemId = g.Key, Quantity = g.Sum(x => x.Quantity) })
                .ToDictionaryAsync(x => x.OrderItemId, x => x.Quantity);
            var hasRemaining = activeItems.Any(i => (paidQuantities.TryGetValue(i.Id, out var q) ? q : 0) < i.Quantity);
            if (!hasRemaining)
            {
                o.Status = OrderStatus.Closed;
                o.ClosedAt = DateTime.Now;
                await db.SaveChangesAsync();
            }
            else
            {
                await LoadAsync();
            }



            lastDocumentLabel = splitDocumentKind == FiscalDocumentKind.Invoice ? "Τιμολόγιο" : "Απόδειξη";

            lastSeriesAndNumber = await db.OrderPayments
                .Where(p => p.OrderId == o.Id && (result.Mark != null ? p.Mark == result.Mark : p.FiscalStatus == FiscalStatus.PaidLocally))
                .OrderByDescending(p => p.Id)
                .Select(p => p.SeriesName + " " + p.InvoiceNumber)
                .FirstOrDefaultAsync() ?? "Μερική πληρωμή";

            lastMark = result.Mark;

            lastPdfUrl = null;

            closeStep = 5;

        }

        catch (Exception ex)

        {

            fiscalError = "Απρόσμενο σφάλμα: " + ex.Message;

            closeStep = 9;

        }

    }



