                                <button class="payment-method-card cash" aria-label="Μετρητά" @onclick="() => SelectPayment(PaymentMethod.Cash)" style="display:flex;align-items:center;justify-content:center;gap:18px;width:100%;min-height:96px;padding:18px;border:1px solid #d9e2ef;border-left:7px solid #2e8b57;border-radius:16px;background:#fff;color:#202b43;font-size:1.35rem;font-weight:800;cursor:pointer;box-shadow:0 6px 18px rgba(28,42,68,.1);">
                                    <span class="payment-method-icon" style="display:grid;place-items:center;width:54px;height:54px;border-radius:15px;background:#edf8f0;font-size:28px;">💵</span><strong>Μετρητά</strong>
                                </button>
                                <button class="payment-method-card card" aria-label="Κάρτα" @onclick="() => SelectPayment(PaymentMethod.Card)" style="display:flex;align-items:center;justify-content:center;gap:18px;width:100%;min-height:96px;padding:18px;border:1px solid #d9e2ef;border-left:7px solid #3478c8;border-radius:16px;background:#fff;color:#202b43;font-size:1.35rem;font-weight:800;cursor:pointer;box-shadow:0 6px 18px rgba(28,42,68,.1);">
                                    <span class="payment-method-icon" style="display:grid;place-items:center;width:54px;height:54px;border-radius:15px;background:#eef4ff;font-size:28px;">💳</span><strong>Κάρτα</strong>
