    private async Task ConfirmCancelWholeOrder()



    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;




        if (wholeOrderCancellationInProgress)



            return;







        wholeOrderCancellationInProgress = true;



        wholeOrderCancellationError = null;







        try



        {



            using var db = await DbFactory.CreateDbContextAsync();







            var dbOrder = await db.Orders



                .Include(o => o.RestaurantTable)



                .Include(o => o.Items)



                .FirstOrDefaultAsync(o => o.Id == order.Id);







            if (dbOrder is null)



            {



                wholeOrderCancellationError = "Η παραγγελία δεν βρέθηκε.";



                return;



            }







            var activeItems = dbOrder.Items.Where(i => !i.IsCancelled).ToList();
            var cancellationReason = "Ακύρωση ολόκληρης παραγγελίας από τον σερβιτόρο";







            if (activeItems.Count == 0)



            {



                var emptyClose = await Fiscal.CloseEmptyOrderAsync(db, dbOrder);







                if (!emptyClose.Success)



                {



                    wholeOrderCancellationError = emptyClose.ErrorMessage;



                    return;



                }



            }



            else



            {



                var result = await Fiscal.CancelWholeOrderAsync(



                    db,



                    dbOrder,



                    cancellationReason);







                if (!result.Success)



                {



                    wholeOrderCancellationError =



                        result.ErrorMessage ?? "Απέτυχε η ακύρωση της παραγγελίας.";



                    return;



                }



            }







            foreach (var item in activeItems)
            {
                var amount = item.Quantity * ((item.MenuItem?.Price ?? 0m) + item.ExtrasPrice) *
                    (1m - Math.Clamp(item.DiscountPercent, 0m, 100m) / 100m);
                CancellationAuditService.Add(db, dbOrder, currentUserId, "Ακύρωση παραγγελίας",
                    $"{item.Quantity} × {item.MenuItem?.Name ?? "Είδος"}", cancellationReason, item.Quantity, amount, item.Id);
            }

            dbOrder.Status = OrderStatus.Closed;



            dbOrder.ClosedAt = DateTime.Now;



            await db.SaveChangesAsync();







            showWholeOrderCancelModal = false;



            statusMessage = "Η παραγγελία ακυρώθηκε και το τραπέζι έκλεισε.";



            await LoadAsync();



        }



        catch (Exception ex)



        {



            wholeOrderCancellationError = $"Σφάλμα ακύρωσης παραγγελίας: {ex.Message}";



        }



        finally



        {



            wholeOrderCancellationInProgress = false;



        }



    }







