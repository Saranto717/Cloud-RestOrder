        align-items: center;
        gap: 7px;
        margin-bottom: 11px;
        color: #315d92;
        font-size: .81rem;
        font-weight: 800;
    }

    .invoice-pin-box .aade-info-grid {
        display: grid;
        gap: 10px;
    }

        .invoice-pin-box .aade-info-grid > div span {
            display: block;
            margin-bottom: 2px;
            color: #7a8492;
            font-size: .68rem;
            font-weight: 700;
