            return;

        }



        await IssueAndClose(FiscalDocumentKind.Invoice);

    }















    private async Task CompleteCardPayment()







    {







        if (selectedPaymentMethod is not (PaymentMethod.Card or PaymentMethod.Iris))
        {
            fiscalError = "Το POS ενέκρινε την πληρωμή αλλά δεν επέστρεψε αν ήταν κάρτα ή IRIS. Δεν εκδίδεται παραστατικό με εικασία και δεν πρέπει να σταλεί ξανά χρέωση. Έλεγξε το ιστορικό του POS.";
            return;
        }

        if (string.IsNullOrWhiteSpace(cardTransactionId))







        {







            fiscalError = "Συμπλήρωσε το Transaction ID που επέστρεψε το EFT-POS.";







            return;







        }







        await IssueAndClose(pendingCardDocumentKind, true);







    }















    private async Task IssueAndClose(FiscalDocumentKind kind, bool cardPaymentReady = false)







    {
        if (isTakeAwayMode) kind = FiscalDocumentKind.Receipt;

        lastDocumentOfflinePending = false;
        lastTransmissionFailure = null;
        lastPrintStatus = null;
        lastPrintSucceeded = false;







        closeStep = 4;







        fiscalError = null;







        StateHasChanged();















        try







        {







            using var db = await DbFactory.CreateDbContextAsync();







            var o = await db.Orders







    .Include(x => x.RestaurantTable)







    .Include(x => x.Items)







        .ThenInclude(i => i.MenuItem)







            .ThenInclude(mi => mi!.MenuCategory)







                .ThenInclude(c => c!.PrinterStations)







    .FirstOrDefaultAsync(x => x.Id == order.Id);















            if (o is null)







            {







                fiscalError = "Η παραγγελία δεν βρέθηκε.";







                closeStep = 2;







                return;







            }















            o.PaymentMethod = selectedPaymentMethod;















            if (kind == FiscalDocumentKind.Invoice)







            {







                o.CounterpartVatNumber = counterpartVat.Trim();







                o.CounterpartName = counterpartName.Trim();







                o.CounterpartStreet = counterpartStreet.Trim();







                o.CounterpartCity = counterpartCity.Trim();







                o.CounterpartPostalCode = counterpartPostalCode.Trim();







                o.CounterpartStreetNumber = "";







                o.CounterpartTaxOffice = counterpartDoy.Trim();







                o.CounterpartMainActivity = counterpartMainActivity.Trim();







            }















            // EFT-POS flow: requestPayment must happen before /api/send. The Parochos API







            // returns the provider signature; the actual POS transaction is performed by







            // the terminal/POS integration and returns a transaction id.







            if ((o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) && !cardPaymentReady &&
                !string.IsNullOrWhiteSpace(o.CardTransactionId))
            {
                if (kind != o.DocumentKind)
                {
                    fiscalError = "Υπάρχει ήδη εγκεκριμένη πληρωμή για διαφορετικό τύπο παραστατικού. Δεν ξεκίνησε νέα χρέωση.";
                    closeStep = 2;
                    return;
                }

                cardTransactionId = o.CardTransactionId.Trim();
                cardPaymentReady = true;
            }

            if (cardPaymentReady && (o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) &&
                !string.IsNullOrWhiteSpace(o.ParochosPaymentUid))
            {
                var isEdpsWebEcrPayment = await db.BankPosTerminalSettings.AnyAsync(x =>
                    x.Provider == "EDPS" && x.Protocol.Contains("WebECR API v6") &&
                    x.TerminalId == o.CardTerminalId);
                var expectedPaymentExternalSystemIdPrefix = $"payment-{o.Id}-";
                if (isEdpsWebEcrPayment && o.ParochosMark is null &&
                    !(o.ParochosExternalId?.StartsWith(expectedPaymentExternalSystemIdPrefix, StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    cardFiscalRetryOnly = true;
                    cardFiscalRetryRequiresRecovery = true;
                    fiscalError = "Η συναλλαγή POS έχει ήδη εγκριθεί, αλλά η παλιά έκδοση συνέδεσε την υπογραφή Parochos με διαφορετικό αναγνωριστικό παραστατικού. Δεν έγινε νέα χρέωση. Χρειάζεται ανάκτηση της αρχικής υπογραφής από τα στοιχεία Parochos.";
                    closeStep = 2;
                    return;
                }
            }

            if ((o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) && !cardPaymentReady)







            {







                if (SelectedCardPosSetting is null) { fiscalError = "Επίλεξε ενεργό συνδεδεμένο POS."; return; }
            var preparation = await Fiscal.PrepareCardPaymentAsync(db, o, kind, SelectedCardPosSetting);







                if (!preparation.Success)







                {







                    fiscalError = preparation.ErrorMessage;







                    closeStep = 2;







                    return;







                }















                pendingCardPayment = preparation;
                edpsRetryWithFreshProviderData = false;
                edpsStatusCheckRequired = false;







                pendingCardDocumentKind = kind;







                pendingCardTerminalId = preparation.TerminalId;







                pendingCardAmount = preparation.Amount;







                cardTransactionId = "";







                await db.SaveChangesAsync();







                closeStep = 6;







                return;







            }















            if (o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris)







                o.CardTransactionId = cardTransactionId.Trim();















            var result = await Fiscal.IssueAsync(db, o, kind, (o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) ? cardTransactionId : null);







            await db.SaveChangesAsync();















            if (!result.Success)







            {







                if ((o.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris) && cardPaymentReady &&
                    !string.IsNullOrWhiteSpace(o.CardTransactionId))
                {
                    cardFiscalRetryOnly = true;
                    cardFiscalRetryRequiresRecovery = result.RequiresRecovery;
                    pendingCardDocumentKind = kind;
                }

                // Provider/API transport text can be very long and is not useful
                // at the cash register. Diagnostics remain in the server logs and
                // the cashier receives a clear next action instead.
                fiscalError = result.NumberConflict ? result.ErrorMessage : result.RequiresRecovery
                    ? "Δεν επιβεβαιώθηκε η επικοινωνία με τον πάροχο. Δεν έγινε δεύτερη έκδοση για αποφυγή διπλής απόδειξης. Έλεγξε τις εκκρεμείς διαβιβάσεις."
                    : string.IsNullOrWhiteSpace(result.ErrorMessage)
                        ? "Το παραστατικό δεν εκδόθηκε. Έλεγξε τα στοιχεία έκδοσης και δοκίμασε ξανά."
                        : (o.ParochosMark is > 0 ? "" : "Το παραστατικό δεν εκδόθηκε: ") + result.ErrorMessage.Trim()[..Math.Min(result.ErrorMessage.Trim().Length, 700)] +
                          (string.IsNullOrWhiteSpace(result.ErrorCode) ? "" : $" (Κωδικός: {result.ErrorCode})");







                closeStep = 2;







                return;







            }















            o.Status = OrderStatus.Closed;







            o.ClosedAt = DateTime.Now;







            await db.SaveChangesAsync();















            // Τύπωσε το τελικό φορολογικό παραστατικό με MARK και πραγματικό QR ESC/POS.







            // Δεν βάζουμε MARK μέσα στις γραμμές των προϊόντων.
            lastDocumentOfflinePending = result.OfflineIssued;
            lastTransmissionFailure = result.OfflineIssued
                ? result.TransmissionFailure ?? o.ParochosTransmissionFailure
                : null;
            lastPrintSucceeded = false;
            lastPrintStatus = null;







            try







            {







                var fiscalItems = o.Items.Where(oi => !oi.IsCancelled).Select(oi => (







                    ItemName: oi.MenuItem!.Name,







                    Quantity: oi.Quantity,







                    LineTotal: LineTotalForQuantity(oi, oi.Quantity),







                    VatPercent: oi.MenuItem?.VatPercentOverride ?? oi.MenuItem?.MenuCategory?.VatPercent ?? 24m)).ToList();







                var fiscalTotal = fiscalItems.Sum(i => i.LineTotal);
                var relatedFiscalDocuments = await db.FiscalOrderDocuments.Where(f => f.OrderId == o.Id && f.Mark != null && !f.IsCancellation && !f.IsCancelled).OrderBy(f => f.IssuedAt).Select(f => $"Δελτίο παραγγελίας {f.SeriesName} {f.Number}").ToListAsync();















                var stations = o.Items.Where(oi => !oi.IsCancelled)
                    .SelectMany(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory)
                        .Where(station => station.IsActive && station.PrintFiscalDocuments))
                    .DistinctBy(s => s.Id)
                    .ToList();

                // Σε εγκατάσταση με έναν μόνο ενεργό εκτυπωτή παραστατικών,
                // χρησιμοποιούμε ασφαλές fallback. Με περισσότερους από έναν δεν
                // μαντεύουμε, ώστε να μην προκύψει διπλή φυσική εκτύπωση.
                if (stations.Count == 0)
                {
                    var eligibleFallbacks = await db.PrinterStations
                        .Where(p => p.IsActive && p.PrintFiscalDocuments)
                        .OrderBy(p => p.Name)
                        .ToListAsync();
                    if (eligibleFallbacks.Count == 1)
                        stations.Add(eligibleFallbacks[0]);
                }















                var waiterUser = await db.Users.FindAsync(currentUserId);







                if (result.OfflineIssued && stations.Count == 0)
                {
                    lastPrintSucceeded = false;
                    lastPrintStatus = "Η απόδειξη καταχωρίστηκε, αλλά δεν βρέθηκε διαθέσιμος εκτυπωτής. Έλεγξε τον εκτυπωτή και χρησιμοποίησε «Εκτύπωση απόδειξης» από τις εκκρεμείς διαβιβάσεις.";
                }

                foreach (var station in stations)







                {







                    var printed = result.AlreadyPrinted || (await Printer.PrintFiscalReceiptAsync(







                        station,







                        tableName,







                        waiterUser?.FullName ?? "-",







                        o.StaffConsumptionInvoiceType is "6.1" or "6.2" ? "ΣΤΟΙΧΕΙΟ ΙΔΙΟΚΑΤΑΝΑΛΩΣΗΣ"
                            : (kind == FiscalDocumentKind.Invoice ? "ΤΙΜΟΛΟΓΙΟ" : "ΑΠΟΔΕΙΞΗ ΛΙΑΝΙΚΗΣ"),







                        o.InvoiceSeriesName ?? "",







                        o.InvoiceNumber ?? 0,







                        result.OfflineIssued ? null : o.ParochosMark,







                        // Το Transmission Failure δεν είναι QR ΑΑΔΕ. Δεν στέλνουμε
                        // αυθαίρετο κείμενο ως ESC/POS QR, γιατί αρκετοί θερμικοί
                        // εκτυπωτές απορρίπτουν την εντολή και δεν τυπώνουν τίποτα.
                        // Η ένδειξη TF τυπώνεται στο κάτω μέρος του παραστατικού.
                        result.OfflineIssued ? null : o.ParochosQrCode,







                        fiscalItems,







                        fiscalTotal,







                        companySettings, o,
                        copyLabel: "ΠΡΩΤΟΤΥΠΟ",
                        relatedDocuments: relatedFiscalDocuments,
                        transmissionFailure: result.OfflineIssued ? result.TransmissionFailure ?? o.ParochosTransmissionFailure ?? 1 : null));















                    if (!printed)







                        Console.WriteLine($"⚠ Fiscal receipt printer failed: {station.Name} ({station.IpAddress}:{station.Port})");

                    if (result.OfflineIssued && printed)
                    {
                        o.ParochosOfflineReceiptPrintedAtUtc ??= DateTime.UtcNow;
                        await db.SaveChangesAsync();
                        lastPrintSucceeded = true;
                        lastPrintStatus = "Η απόδειξη τυπώθηκε. Η διαβίβαση παραμένει αποθηκευμένη και θα ολοκληρωθεί μόλις αποκατασταθεί η επικοινωνία.";
                    }
                    else if (result.OfflineIssued && !lastPrintSucceeded)
                    {
                        lastPrintSucceeded = false;
                        lastPrintStatus = "Η απόδειξη καταχωρίστηκε, αλλά δεν στάλθηκε στον εκτυπωτή. Έλεγξε τον εκτυπωτή και χρησιμοποίησε «Εκτύπωση απόδειξης» από τις εκκρεμείς διαβιβάσεις.";
                    }







                }







            }







            catch (Exception ex)







            {







                Console.WriteLine($"⚠ Fiscal receipt printing failed: {ex.Message}");

                if (result.OfflineIssued)
                {
                    lastPrintSucceeded = false;
                    lastPrintStatus = "Η απόδειξη καταχωρίστηκε, αλλά δεν μπόρεσε να προετοιμαστεί για εκτύπωση. Έλεγξε τον εκτυπωτή και χρησιμοποίησε «Εκτύπωση απόδειξης» από τις εκκρεμείς διαβιβάσεις.";
                }







                // Η φορολογική έκδοση έχει ήδη ολοκληρωθεί. Η φυσική εκτύπωση είναι best-effort.







            }















            pendingCardPayment = null;







            cardTransactionId = "";







            pendingCardTerminalId = "";







            pendingCardAmount = 0m;







            pendingCardDocumentKind = FiscalDocumentKind.Receipt;















            lastDocumentOfflinePending = result.OfflineIssued;
            lastDocumentLabel = result.OfflineIssued
                ? (kind == FiscalDocumentKind.Invoice ? "Προσωρινό τιμολόγιο" : "Προσωρινή απόδειξη")
                : (kind == FiscalDocumentKind.Invoice ? "Τιμολόγιο" : "Απόδειξη");







            lastSeriesAndNumber = $"{o.InvoiceSeriesName}-{o.InvoiceNumber}";







            lastMark = result.OfflineIssued ? null : o.ParochosMark;







            lastPdfUrl = result.OfflineIssued ? null : o.ParochosPdfUrl;







            closeStep = 5;







        }







        catch (Exception ex)







        {







            Console.Error.WriteLine(ex);
            fiscalError = "Δεν επιβεβαιώθηκε η έκδοση. Έλεγξε τις εκκρεμείς διαβιβάσεις πριν από νέα προσπάθεια.";







            closeStep = 2;







        }







    }















    private void FinishClosing()







    {







        showPaymentModal = false;







        Nav.NavigateTo(isTakeAwayMode ? "/waiter?startTakeAway=true" : "/waiter", forceLoad: true);







    }
