    .card-pos-actions .card-pos-pay { background:#1f2a44; color:#fff; }
    .card-pos-actions .card-pos-invoice { border:1px solid #d9e0eb; background:#fff; color:#34425e; }
    .card-pos-actions button:disabled { opacity:.55; cursor:wait; }
    .alternative-payment-option {
        display:block; width:100%; min-height:58px; padding:12px 16px;
        border:1px solid #cbd6e5; border-left:5px solid #365f9d; border-radius:12px;
