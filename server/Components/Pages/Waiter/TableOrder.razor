            var baseTotal = items.Sum(i => RemainingQuantityForItem(i) * ((i.MenuItem?.Price ?? 0m) + i.ExtrasPrice));
            return Math.Round(baseTotal * (1m - Math.Clamp(discountDraftPercent, 0m, 100m) / 100m), 2);
