    .alternative-payment-option:focus-visible { outline:3px solid #6a9ce0; outline-offset:2px; }
    .card-terminal-list { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px; margin:12px 0; }
    .card-terminal-choice { padding:13px; border:1px solid #dce3ef; border-radius:12px; background:#f8faff; color:#25324b; text-align:left; cursor:pointer; }
    .card-terminal-choice strong,.card-terminal-choice span { display:block; }
    .card-terminal-choice span { margin-top:4px; color:#697386; font-size:.78rem; }
    @@media (max-width:560px) { .pin-box.card-pos-picker-box { width:calc(100vw - 20px); padding:18px; } .card-pos-grid { grid-template-columns:1fr; } }
    /* Back to tables: keep the framed button look, not a default/visited hyperlink. */
    button.nav-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 16px;
        border: 1px solid #d5dbe6;
        border-radius: 12px;
        background: #fff;
        color: #1f2a44;
        font-weight: 700;
        text-decoration: none;
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }
    button.nav-button:active { background: #eef2f8; }

    /* Tap to add one; horizontal swipe is handled by pointer events. */
    .order-list li.order-item-interactive {
        cursor: pointer;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .order-list li.order-item-interactive > span { pointer-events: none; }
    .order-list li.order-item-interactive .remove-btn { touch-action: manipulation; }
    .order-list li.order-item-interactive.pending { cursor: pointer; }
    .order-list li.order-item-interactive.printed { cursor: default; }
    .order-list li.order-item-focused { animation: order-item-focus 1.05s ease-out; }
    @@keyframes order-item-focus { 0% { background:#dbeafe; outline:2px solid #60a5fa; } 100% { background:transparent; outline-color:transparent; } }
    .order-list li.order-item-interactive.selection-mode { cursor: pointer; }
    .order-list li.order-item-interactive.selection-mode.selected-for-action { outline: 2px solid #2563eb; background: #eff6ff; }
    .order-list li.order-item-interactive .discount-btn { flex: 0 0 auto; border: 1px solid #cbd5e1; border-radius: 7px; background:#f8fafc; color:#334155; padding:3px 7px; font-size:.72rem; font-weight:800; cursor:pointer; }
    .order-list li.order-item-interactive .discount-editor { flex-basis:100%; display:flex; align-items:center; gap:6px; padding:5px 0 2px; }
    .order-list li.order-item-interactive .discount-editor input { width:62px; padding:4px 6px; }
    .order-list li.discount-editor-row { display:flex; align-items:center; gap:6px; padding:5px 8px 8px; background:#f8fafc; border-bottom:1px solid #e2e8f0; }
    .order-list li.discount-editor-row label { font-size:.78rem; font-weight:700; }
    .order-list li.discount-editor-row input { width:64px; }
    .order-list li.discount-editor-row button { padding:4px 7px; }
    /* Invoice modal - component local so it cannot be broken by global modal/input styles */
