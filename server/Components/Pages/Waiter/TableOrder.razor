    private bool providerCloseRunning;
    private bool staffConsumptionBusy;
    private async Task BeginStaffConsumptionAsync()
    {
        if (staffConsumptionBusy || isTakeAwayMode) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Να εφαρμοστούν οι τιμές ιδιοκατανάλωσης σε όλα τα είδη και να συνεχίσεις με πληρωμή;")) return;
        staffConsumptionBusy = true;
        try
        {
            using var lease = await TableOperationCoordinator.EnterAsync(TableId);
            if (!await EnsureCurrentTableAvailable()) return;
            using var db = await DbFactory.CreateDbContextAsync();
            var current = await db.Orders.Include(o => o.RestaurantTable).Include(o => o.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                .Include(o => o.Payments).FirstOrDefaultAsync(o => o.Id == order.Id && o.Status == OrderStatus.Open);
            if (current is null) { statusMessage = "Η παραγγελία δεν βρέθηκε."; return; }
            if (current.StaffConsumptionInvoiceType is "6.1" or "6.2" && current.FiscalStatus == FiscalStatus.Issued && current.ParochosMark is > 0)
            {
                if (current.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris || !string.IsNullOrWhiteSpace(current.CardTransactionId))
                { statusMessage = "Το παραστατικό έχει ήδη εκδοθεί. Χρησιμοποίησε την ανάκτηση πληρωμής κάρτας χωρίς νέα χρέωση."; return; }
                await LoadAsync();
                selectedPaymentMethod = current.PaymentMethod;
                fiscalError = $"Το παραστατικό έχει ήδη εκδοθεί με ΜΑΡΚ {current.ParochosMark}. Η συνέχεια θα ελέγξει μόνο τη σύνδεση και το κλείσιμο.";
                closeStep = 2;
                showPaymentModal = true;
                return;
            }
            if (current.StaffConsumptionInvoiceType is "6.1" or "6.2" && current.FiscalStatus == FiscalStatus.Failed && current.ParochosTransmissionState == "Rejected" && current.ParochosMark is null)
            {
                if (current.PaymentMethod is PaymentMethod.Card or PaymentMethod.Iris || !string.IsNullOrWhiteSpace(current.CardTransactionId))
                { statusMessage = "Υπάρχει συναλλαγή κάρτας. Χρησιμοποίησε την ανάκτηση της πληρωμής χωρίς νέα χρέωση."; return; }
                await LoadAsync();
                selectedPaymentMethod = PaymentMethod.None;
                fiscalError = null;
                closeStep = 1;
                showPaymentModal = true;
                return;
            }
            if (current.FiscalStatus != FiscalStatus.NotIssued || current.Payments.Count > 0 || current.InvoiceNumber.HasValue || !string.IsNullOrWhiteSpace(current.InvoiceSeriesName) || !string.IsNullOrWhiteSpace(current.ParochosExternalId) || !string.IsNullOrWhiteSpace(current.CardTransactionId) || !string.IsNullOrWhiteSpace(current.ParochosPaymentSignature) || !string.IsNullOrWhiteSpace(current.ParochosInvoicePayloadJson))
            { statusMessage = "Η ιδιοκατανάλωση δεν εφαρμόστηκε: υπάρχει ήδη πληρωμή ή φορολογική διαδικασία."; return; }
            var items = current.Items.Where(i => !i.IsCancelled && i.Quantity > 0).ToList();
            if (items.Count == 0 || items.Any(i => !i.IsPrinted)) { statusMessage = "Στείλε πρώτα όλα τα είδη της παραγγελίας."; return; }
            var config = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            if (config is { UseParochosProvider: true, IssueOrderFormsToAade: true })
            {
                if (await db.OrderPrintBatches.AnyAsync(b => b.OrderId == current.Id && b.DispatchNotificationPending) || await db.FiscalOrderDocuments.AnyAsync(d => d.OrderId == current.Id && d.Mark == null && d.ParochosInvoicePayloadJson != null))
                { statusMessage = "Υπάρχει εκκρεμές δελτίο παραγγελίας. Ολοκλήρωσε πρώτα τη διαβίβασή του."; return; }
                var forms = await db.FiscalOrderDocuments.Include(d => d.Items).Where(d => d.OrderId == current.Id && d.Mark != null && !d.IsCancelled && !d.IsCancellation && !d.IsDiscountReturn).ToListAsync();
                if (forms.Count == 0 || items.Any(i => !forms.Any(f => f.Items.Any(x => x.OrderItemId == i.Id))) && !(forms.Count == 1 && forms[0].Items.Count == 0 && items.Count == 1))
                { statusMessage = "Δεν επιβεβαιώθηκε το δελτίο για όλα τα είδη. Η ιδιοκατανάλωση δεν εφαρμόστηκε."; return; }
            }
            if (items.Any(i => i.MenuItem?.MenuCategory is null)) { statusMessage = "Όρισε κατηγορία και χαρακτηρισμό για όλα τα είδη."; return; }
            if (items.Any(i => i.MenuItem!.MenuCategory!.IncomeClassificationCategory is not ("category1_1" or "category1_2" or "category1_3"))) { statusMessage = "Όρισε χαρακτηρισμό εμπορεύματος, προϊόντος ή υπηρεσίας για όλα τα είδη."; return; }
            var serviceKinds = items.Select(i => i.MenuItem!.MenuCategory!.IncomeClassificationCategory == "category1_3").Distinct().ToArray();
            if (serviceKinds.Length != 1) { statusMessage = "Τα προϊόντα και οι υπηρεσίες απαιτούν διαφορετικά παραστατικά. Χώρισέ τα σε διαφορετικές παραγγελίες."; return; }
            foreach (var item in items)
            {
                var regular = item.MenuItem!.Price + item.ExtrasPrice;
                var target = item.MenuItem.StaffConsumptionPrice;
                if (target < 0m || regular < target || regular <= 0m) { statusMessage = $"Έλεγξε την τιμή ιδιοκατανάλωσης του είδους {item.MenuItem.Name}."; return; }
                item.DiscountPercent = (1m - target / regular) * 100m;
                if (FiscalPayloadBuilder.LineGross(item) != Math.Round(item.Quantity * target, 2)) { statusMessage = $"Δεν υπολογίστηκε ακριβώς η τιμή για {item.MenuItem.Name}."; return; }
            }
            var adjustment = await Fiscal.ApplyDiscountWithReturnOrderFormsAsync(db, current, items.Select(i => i.Id).ToList());
            if (!adjustment.Success) { statusMessage = "Δεν ολοκληρώθηκε η προσαρμογή των δελτίων: " + adjustment.ErrorMessage; return; }
            current.StaffConsumptionInvoiceType = serviceKinds[0] ? "6.2" : "6.1";
            await db.SaveChangesAsync();
            await LoadAsync();
            selectedPaymentMethod = PaymentMethod.None;
            fiscalError = null;
            closeStep = 1;
            showPaymentModal = true;
        }
        catch (Exception ex) { statusMessage = "Η ιδιοκατανάλωση δεν ολοκληρώθηκε: " + ex.Message; }
        finally { staffConsumptionBusy = false; }
    }
    private async Task ForceReleaseAsync(bool cancel)
    {
        if (providerCloseRunning || isTakeAwayMode) return;
        if (!await JS.InvokeAsync<bool>("confirm", cancel ? "Θα επιχειρηθεί φορολογική ακύρωση και το τραπέζι θα αδειάσει τοπικά. Αν αποτύχει η ακύρωση, θα καταγραφεί για έλεγχο. Συνέχεια;" : "Θα σταλεί εντολή κλεισίματος και το τραπέζι θα αδειάσει τοπικά, χωρίς να καταχωριστεί είσπραξη ή να εκδοθεί απόδειξη. Συνέχεια;")) return;
        providerCloseRunning = true;
        try
        {
            using var lease = await TableOperationCoordinator.EnterAsync(TableId);
            using var db = await DbFactory.CreateDbContextAsync();
            var current = await db.Orders.Include(o => o.RestaurantTable).Include(o => o.Items).ThenInclude(i => i.MenuItem).FirstOrDefaultAsync(o => o.Id == order.Id && o.Status == OrderStatus.Open);
            var settings = await FiscalConfiguration.GetSettingsAsync(db);
            if (current is null || settings is null || !settings.UseParochosProvider) { statusMessage = "Δεν βρέθηκε παραγγελία ή ενεργός πάροχος."; return; }
            var anotherActiveOrder = await db.Orders
                .Where(o => o.Id != current.Id && o.RestaurantTableId == current.RestaurantTableId &&
                            o.Status == OrderStatus.Open && o.FiscalStatus != FiscalStatus.Issued)
                .AnyAsync(o => db.OrderItems.Any(i => i.OrderId == o.Id && !i.IsCancelled));
            if (anotherActiveOrder)
            {
                statusMessage = "Δεν έγινε η αναγκαστική ενέργεια: υπάρχει άλλη ενεργή παραγγελία στο ίδιο τραπέζι.";
                return;
            }
            var point = await FiscalConfiguration.ResolvePointOfServiceAsync(db, current);
            if (string.IsNullOrWhiteSpace(point)) { statusMessage = "Δεν βρέθηκε το σημείο εξυπηρέτησης."; return; }
            string cancellation = "";
            if (cancel)
            {
                try
                {
                    using var fiscalDb = await DbFactory.CreateDbContextAsync();
                    var fiscalOrder = await fiscalDb.Orders.Include(o => o.RestaurantTable).FirstAsync(o => o.Id == current.Id);
                    var fiscal = await Fiscal.CancelWholeOrderAsync(fiscalDb, fiscalOrder, "Αναγκαστική ακύρωση από διαχειριστή", closePointOfService: false);
                    if (!fiscal.Success)
                    {
                        statusMessage = "Δεν έκλεισε το τραπέζι. Η ακύρωση στον πάροχο δεν επιβεβαιώθηκε: " + fiscal.ErrorMessage;
                        return;
                    }
                    cancellation = "Ακύρωση στον πάροχο: επιβεβαιώθηκε. ";
                }
                catch (Exception ex) { statusMessage = "Δεν έκλεισε το τραπέζι. Η ακύρωση στον πάροχο δεν επιβεβαιώθηκε: " + ex.Message; return; }
            }
            string providerResult;
            try
            {
                // Always send SetState(actionKind=1), just like the normal receipt
                // and whole-cancellation flows. ListDetails can report an empty
                // table while the provider still has an open Point of Service.
                var result = await Provider.ClosePointOfServiceAsync(settings, point);
                if (!result.Success)
                {
                    var afterFailure = await Provider.ListPointOfServiceDetailsAsync(settings, point);
                    if (!afterFailure.Success || afterFailure.PointOfService is not null || afterFailure.Details.Count > 0)
                        throw new InvalidOperationException("Ο πάροχος δεν επιβεβαίωσε το κλείσιμο: " + (result.ErrorMessage ?? afterFailure.ErrorMessage ?? "άγνωστο σφάλμα"));
                }
                var verified = await Provider.ListPointOfServiceDetailsAsync(settings, point);
                if (!verified.Success || verified.PointOfService is not null || verified.Details.Count > 0)
                    throw new InvalidOperationException("Ο πάροχος εξακολουθεί να εμφανίζει το τραπέζι ανοιχτό.");
                providerResult = "Κλείσιμο παρόχου: επιβεβαιώθηκε.";
            }
            catch (Exception ex) { statusMessage = "Δεν έκλεισε το τραπέζι στο πρόγραμμα, επειδή δεν επιβεβαιώθηκε το κλείσιμο στον πάροχο: " + ex.Message; return; }
            current.Status = OrderStatus.ForceClosed;
            current.ClosedAt = DateTime.Now;
            current.ForceCloseAction = cancel ? "Αναγκαστική ακύρωση" : "Αναγκαστικό κλείσιμο";
            current.ForceCloseResult = cancellation + providerResult;
            current.ForceClosedByUserId = currentUserId;
            var affected = current.Items.Where(i => !i.IsCancelled).ToList();
            var affectedAmount = affected.Sum(i => i.Quantity * ((i.MenuItem?.Price ?? 0m) + i.ExtrasPrice) *
                (1m - Math.Clamp(i.DiscountPercent, 0m, 100m) / 100m));
            CancellationAuditService.Add(db, current, currentUserId, current.ForceCloseAction,
                cancel ? "Αναγκαστική ακύρωση ολόκληρης παραγγελίας" : "Αναγκαστική αποδέσμευση τραπεζιού",
                cancellation + providerResult, affected.Sum(i => i.Quantity), affectedAmount);
            await db.SaveChangesAsync();
            await JS.InvokeVoidAsync("alert", "Το τραπέζι έκλεισε στο πρόγραμμα και στον πάροχο. " + cancellation + providerResult + " Η κίνηση καταγράφηκε στο ιστορικό.");
            allowLeaveTableNavigation = true;
            Nav.NavigateTo("/waiter");
        }
        catch (Exception ex) { statusMessage = "Δεν επιβεβαιώθηκε το κλείσιμο στον πάροχο: " + ex.Message; }
        finally { providerCloseRunning = false; }
    }

    private async Task SendOrderAsync()
    {
        if (sendingOrder) return;

        sendingOrder = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var waiterName = (await db.Users.FindAsync(currentUserId))?.FullName ?? "-";
            KitchenOrderDispatchResult dispatch;
            using (await TableOperationCoordinator.EnterAsync(TableId))
            {
                if (!await EnsureCurrentTableAvailable()) return;
                dispatch = await KitchenOrderDispatch.DispatchPendingAsync(
                    db, order.Id, tableName, waiterName, orderCommentDraft, tableService: !isTakeAwayMode);
            }
            if (!dispatch.HasItems)
            {
                statusMessage = "Δεν υπάρχουν νέα είδη για αποστολή.";
                return;
            }

            // Inventory is independent from fiscal issuance. Only items the
            // kitchen/bar dispatch service marked as submitted consume stock.
            var inventoryUpdateFailed = false;
            try
            {
                await Inventory.ConsumeForDispatchedItemsAsync(
                    dispatch.SubmittedItems.Select(item => item.Id), currentUserId);
            }
            catch (Exception ex)
            {
                inventoryUpdateFailed = true;
                Console.Error.WriteLine($"Inventory update failed after dispatch for order {order.Id}: {ex}");
            }

            FiscalOrderFormDispatchResult? fiscalDispatch = null;
            if (!isTakeAwayMode && dispatch.SubmittedItems.Count > 0)
            {
                try
                {
                    await LoadAsync();
                    await InvokeAsync(StateHasChanged);
                    fiscalDispatch = await FiscalOrderForms.ConsumeBatchAsync(db, dispatch.BatchId);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Order form processing failed for batch {dispatch.BatchId}: {ex}");
                    fiscalDispatch = new(new FiscalIssueResult { Success = false }, Array.Empty<string>());
                }
            }

            orderCommentDraft = "";
            var messages = new List<string>
            {
                dispatch.SuccessfulStations.Count > 0
                    ? $"Η παραγγελία στάλθηκε σε: {string.Join(", ", dispatch.SuccessfulStations)}."
                    : "Η παραγγελία καταχωρήθηκε."
            };

            if (dispatch.FailedStations.Count > 0)
                messages.Add($"Αποτυχία εκτύπωσης στην κουζίνα/μπαρ: {string.Join(", ", dispatch.FailedStations)}.");
            if (dispatch.CategoriesWithoutPrinter.Count > 0)
                messages.Add($"Χωρίς εκτυπωτή (καταχωρήθηκαν): {string.Join(", ", dispatch.CategoriesWithoutPrinter)}.");
            if (fiscalDispatch is { Issue.OfflineIssued: true })
            {
                messages.Add(fiscalDispatch.Issue.TransmissionFailure == 2
                    ? "Το Δελτίο Παραγγελίας εκδόθηκε κανονικά. Ο πάροχος δεν επικοινωνεί προσωρινά με την ΑΑΔΕ και η διαβίβαση θα ολοκληρωθεί μόλις αποκατασταθεί η επικοινωνία."
                    : "Το Δελτίο Παραγγελίας εκδόθηκε κανονικά. Δεν υπάρχει προσωρινά επικοινωνία με τον πάροχο και η διαβίβαση θα ολοκληρωθεί μόλις αποκατασταθεί η σύνδεση.");
            }
            else if (fiscalDispatch is { Issue.Success: false })
            {
                messages.Add("Το Δελτίο Παραγγελίας παρέμεινε αποθηκευμένο για ασφαλή έλεγχο στον πάροχο. Δεν έγινε δεύτερη έκδοση.");
            }
            if (fiscalDispatch?.PrintErrors.Count > 0)
                messages.Add($"Αποτυχία εκτύπωσης φορολογικού δελτίου σε: {string.Join(", ", fiscalDispatch.PrintErrors)}.");

            statusMessage = string.Join(" ", messages);
            await JS.InvokeVoidAsync("playBeep");
            if (isTakeAwayMode)
            {
                await LoadAsync();
                showLeaveTableConfirm = false;
                selectedPaymentMethod = PaymentMethod.None;
                closeStep = 1;
                showPaymentModal = true;
                return;
            }
            var destination = "/waiter?sent=true";
            if (dispatch.FailedStations.Count > 0) destination += "&kitchenPrintError=true";
            if (fiscalDispatch is { Issue.OfflineIssued: true }) destination += $"&fiscalOffline={fiscalDispatch.Issue.TransmissionFailure}";
            if (inventoryUpdateFailed) destination += "&inventoryError=true";
            if (fiscalDispatch is { Issue.Success: false }) destination += "&fiscalError=true";
            if (fiscalDispatch?.PrintErrors.Count > 0) destination += "&fiscalPrintError=true";

            // Always return to the table overview after handling this dispatch,
            // including printer failures. The accepted items never go back to the draft.
            allowLeaveTableNavigation = true;
            Nav.NavigateTo(destination);
        }
        finally
        {
            sendingOrder = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task ReprintOrder()
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        using var db = await DbFactory.CreateDbContextAsync();

        var activeItems = await db.OrderItems
            .Include(oi => oi.MenuItem).ThenInclude(mi => mi!.MenuCategory).ThenInclude(c => c!.PrinterStations)
            .Include(oi => oi.MenuItem).ThenInclude(mi => mi!.MenuCategory).ThenInclude(c => c!.PrinterStation)
            .Where(oi => oi.OrderId == order.Id && oi.IsPrinted && !oi.IsCancelled)
            .OrderBy(oi => oi.Id)
            .ToListAsync();

        if (!activeItems.Any())
        {
            statusMessage = "Δεν υπάρχουν ενεργά είδη για επανεκτύπωση.";
            return;
        }

        var waiterUser = await db.Users.FindAsync(currentUserId);
        var withPrinter = activeItems
            .SelectMany(oi => GetCategoryPrinters(oi.MenuItem?.MenuCategory)
                .Where(station => station.PrintOrders)
                .Select(station => new { Station = station, Item = oi }))
            .GroupBy(x => x.Station)
            .ToList();

        if (!withPrinter.Any())
        {
            statusMessage = "Δεν υπάρχουν ενεργά είδη με αντιστοιχισμένο εκτυπωτή.";
            return;
        }

        var printed = new List<string>();
        var failed = new List<string>();
        var failedItems = new HashSet<int>();
        var dailyOrderNumber = await db.OrderPrintBatches
            .Where(b => b.OrderId == order.Id)
            .OrderByDescending(b => b.Id)
            .Select(b => (int?)b.DailyNumber)
            .FirstOrDefaultAsync() ?? 0;
        if (dailyOrderNumber <= 0)
            dailyOrderNumber = await RestaurantOrders.Services.CashierService.ReserveNextOrderNumberAsync(db);
        foreach (var group in withPrinter)
        {
            var ticketItems = group.Select(x => x.Item)
                .Select(oi => new KitchenTicketLine(
                    oi.MenuItem!.Name,
                    oi.Quantity,
                    oi.Quantity * ((oi.MenuItem?.Price ?? 0m) + oi.ExtrasPrice),
                    oi.Notes,
                    oi.MenuItem?.VatPercentOverride ?? oi.MenuItem?.MenuCategory?.VatPercent ?? 24m,
                    OrderPriority.Normalize(oi.MenuItem?.MenuCategory?.OrderPriority)))
                .OrderBy(x => OrderPriority.Rank(x.Priority))
                .ToList();

            var ok = await Printer.PrintKitchenTicketAsync(
                group.Key,
                tableName,
                waiterUser?.FullName ?? "-",
                ticketItems,
                companySettings,
                dailyOrderNumber,
                orderCommentDraft);

            if (ok) printed.Add(group.Key.Name);
            else { failed.Add(group.Key.Name); foreach (var x in group) failedItems.Add(x.Item.Id); }
        }

        foreach (var row in withPrinter.SelectMany(g => g).Select(x => x.Item).DistinctBy(i => i.Id))
            row.KitchenPrintUnconfirmed = failedItems.Contains(row.Id);
        await db.SaveChangesAsync();
        await LoadAsync();
        statusMessage = printed.Any()
            ? $"Η επανεκτύπωση ολοκληρώθηκε σε: {string.Join(", ", printed)}."
            : "Η επανεκτύπωση απέτυχε.";
        if (failed.Any())
            statusMessage += $" Αποτυχία σε: {string.Join(", ", failed)}.";
    }
















