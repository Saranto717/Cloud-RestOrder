    private void SelectMenuItemForLayout(int itemId)
    {
        if (!layoutEditing || !itemsByCategory.TryGetValue(selectedCategoryId, out var list)) return;
        var firstIndex = layoutSelectedMenuItemId is int firstId ? list.FindIndex(x => x.Id == firstId) : -1;
        var secondIndex = list.FindIndex(x => x.Id == itemId);
        if (secondIndex < 0) return;
        if (firstIndex < 0) { layoutSelectedMenuItemId = itemId; return; }
        if (firstIndex == secondIndex) { layoutSelectedMenuItemId = null; return; }
        (list[firstIndex], list[secondIndex]) = (list[secondIndex], list[firstIndex]);
        for (var i = 0; i < list.Count; i++) list[i].DisplayOrder = i;
        itemsByCategory[selectedCategoryId] = list;
        layoutSelectedMenuItemId = null;
    }

    private void SelectExtraForLayout(int extraId)
    {
        if (!extrasLayoutEditing) return;
        var visible = ExtrasForCurrentItem().Select(x => x.Id).ToHashSet();
        if (!visible.Contains(extraId)) return;
        var firstId = layoutSelectedExtraId;
        if (firstId is null) { layoutSelectedExtraId = extraId; return; }
        if (firstId == extraId) { layoutSelectedExtraId = null; return; }
        var firstIndex = allExtras.FindIndex(x => x.Id == firstId.Value);
        var secondIndex = allExtras.FindIndex(x => x.Id == extraId);
        if (firstIndex < 0 || secondIndex < 0) { layoutSelectedExtraId = extraId; return; }
        (allExtras[firstIndex], allExtras[secondIndex]) = (allExtras[secondIndex], allExtras[firstIndex]);
        for (var i = 0; i < allExtras.Count; i++) allExtras[i].DisplayOrder = i;
        layoutSelectedExtraId = null;
    }

    private void ApplyBulkTileScale()
