    private async Task ConfirmAddItem()







    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;








        if (pendingItem is null) return;















        var selectedExtras = allExtras.Where(e => pendingSelectedExtras.ContainsKey(e.Id)).ToList();
        var noteParts = selectedExtras.Select(e => BuildExtraNote(e, pendingSelectedExtras[e.Id])).ToList();
        if (!string.IsNullOrWhiteSpace(pendingItemComment))
            noteParts.Insert(0, $"Σχόλιο: {pendingItemComment.Trim()}");
        var notes = string.Join(", ", noteParts);







        var extrasPrice = selectedExtras.Sum(e => e.Price);















        using var db = await DbFactory.CreateDbContextAsync();















        if (pendingOrderItemId.HasValue)
        {
            var targetLine = await db.OrderItems.FirstOrDefaultAsync(oi =>
                oi.Id == pendingOrderItemId.Value && oi.OrderId == order.Id && !oi.IsPrinted && !oi.IsCancelled);
            if (targetLine is not null)
            {
                if (!string.IsNullOrWhiteSpace(notes))
                    targetLine.Notes = string.Join(", ", new[] { targetLine.Notes, notes }.Where(x => !string.IsNullOrWhiteSpace(x)));
                targetLine.ExtrasPrice += extrasPrice;
                await db.SaveChangesAsync();
                statusMessage = null;
                CancelPending();
                await LoadAsync();
                await FocusOrderItemAsync(targetLine.Id);
                return;
            }
        }

        // Ίδιο είδος με ίδιες σημειώσεις -> αύξηση ποσότητας, αλλιώς νέα γραμμή







        var existingLine = await db.OrderItems.FirstOrDefaultAsync(oi =>







            oi.OrderId == order.Id && oi.MenuItemId == pendingItem.Id && !oi.IsPrinted && !oi.IsCancelled &&







            (oi.Notes ?? "") == notes);















        if (existingLine is not null)







        {







            existingLine.Quantity += pendingQty;







        }







        else







        {







            existingLine = new OrderItem

            {

                OrderId = order.Id,

                MenuItemId = pendingItem.Id,

                Quantity = pendingQty,

                Notes = string.IsNullOrWhiteSpace(notes) ? null : notes,

                ExtrasPrice = extrasPrice

            };
            db.OrderItems.Add(existingLine);







        }















        await db.SaveChangesAsync();







        statusMessage = null;







        CancelPending();







        await LoadAsync();

        if (existingLine is not null)
            await FocusOrderItemAsync(existingLine.Id);







    }















    private double? orderItemPointerStartX;
    private double? orderItemPointerStartY;
    private int? orderItemPointerItemId;
    private bool suppressNextOrderItemTap;

    private void OrderItemPointerDown(OrderItem item, PointerEventArgs e)
    {
        orderItemPointerStartX = e.ClientX;
        orderItemPointerStartY = e.ClientY;
        orderItemPointerItemId = item.Id;
        suppressNextOrderItemTap = false;
    }

    private async Task OrderItemPointerUp(OrderItem item, PointerEventArgs e)
    {
        if (orderItemPointerItemId != item.Id || orderItemPointerStartX is null || orderItemPointerStartY is null)
            return;

        var deltaX = e.ClientX - orderItemPointerStartX.Value;
        var deltaY = e.ClientY - orderItemPointerStartY.Value;
        orderItemPointerStartX = null;
        orderItemPointerStartY = null;
        orderItemPointerItemId = null;

        // Swipe left only; ignore vertical scrolling and short movements.
        if (deltaX <= -55 && Math.Abs(deltaX) > Math.Abs(deltaY) * 1.25)
        {
            suppressNextOrderItemTap = true;
            await DecreasePendingOrderItemByOne(item);
        }
    }

    private async Task HandleOrderItemTap(OrderItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (suppressNextOrderItemTap)
        {
            suppressNextOrderItemTap = false;
            return;
        }

        if (selectionMode)
        {
            if (selectedOrderItemIds.Contains(item.Id)) selectedOrderItemIds.Remove(item.Id);
            else selectedOrderItemIds.Add(item.Id);
            return;
        }

        // Items already sent to the kitchen/bar are immutable here; use the existing cancellation flow.
        if (item.IsPrinted || item.IsCancelled)
            return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == item.Id);
        if (dbItem is null || dbItem.IsPrinted || dbItem.IsCancelled)
            return;

        dbItem.Quantity += 1;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task DecreasePendingOrderItemByOne(OrderItem item)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        if (item.IsPrinted || item.IsCancelled)
            return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == item.Id);
        if (dbItem is null || dbItem.IsPrinted || dbItem.IsCancelled)
            return;

        if (dbItem.Quantity <= 1)
        {
            ClearPendingExtrasForRemovedItem(dbItem.Id, dbItem.MenuItemId);
            db.OrderItems.Remove(dbItem);
        }
        else
            dbItem.Quantity -= 1;

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task RemoveItemFromPendingOrder(OrderItem oi)
    {
        using var tableLease = await TableOperationCoordinator.EnterAsync(TableId);
        if (!await EnsureCurrentTableAvailable()) return;

        // Όσο το είδος δεν έχει σταλεί, το Χ το αφαιρεί άμεσα από τα προς αποστολή.
        // Αν έχει ήδη σταλεί, κρατάμε την υπάρχουσα διαδικασία φορολογικής ακύρωσης.
        if (oi.IsPrinted)
        {
            BeginCancelItem(oi);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();

        var dbItem = await db.OrderItems.FirstOrDefaultAsync(i => i.Id == oi.Id);
        if (dbItem is null)
            return;

        ClearPendingExtrasForRemovedItem(dbItem.Id, dbItem.MenuItemId);

        db.OrderItems.Remove(dbItem);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private void ClearPendingExtrasForRemovedItem(int orderItemId, int menuItemId)
    {
        var belongsToRemovedLine = pendingOrderItemId == orderItemId
            || lastManualExtrasOrderItemId == orderItemId
            || (showExtraPanel && pendingItem?.Id == menuItemId);

        if (belongsToRemovedLine)
            CancelPending();

        if (lastManualExtrasOrderItemId == orderItemId)
        {
            lastManualExtrasItem = null;
            lastManualExtrasOrderItemId = null;
        }
    }



