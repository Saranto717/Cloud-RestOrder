@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using System.Text.Json
@inject IConfiguration Configuration
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

@if (Configuration.GetValue<bool>("CloudWeb:Enabled"))
{
    <h2>Λογαριασμοί Cloud POS</h2>
    <p class="hint">Δημιούργησε λογαριασμούς email και κωδικού για όσους θα συνδέονται στο Cloud POS. Η πρόσβαση και οι ρόλοι ισχύουν μόνο για το συγκεκριμένο κατάστημα.</p>
    <form class="admin-form quick-add-form" @onsubmit="CreateCloudUserAsync" @onsubmit:preventDefault="true">
        <div class="form-row"><label>Email *</label><input type="email" @bind="cloudEmail" autocomplete="off" required /></div>
        <div class="form-row"><label>Κωδικός *</label><input type="password" @bind="cloudPassword" autocomplete="new-password" placeholder="Τουλάχιστον 12 χαρακτήρες" minlength="12" required /></div>
        <div class="form-row"><label>Ρόλος</label><select @bind="cloudRole"><option value="waiter">Προσωπικό</option><option value="admin">Διαχειριστής</option></select></div>
        <button type="submit" disabled="@cloudBusy">@(cloudBusy ? "Αποθηκεύεται…" : "Προσθήκη λογαριασμού")</button>
    </form>
    @if (!string.IsNullOrWhiteSpace(cloudMessage))
    {
        <p class="@(cloudIsError ? "error" : "status")" role="status">@cloudMessage</p>
    }
    <table class="admin-table">
        <thead><tr><th>Email</th><th>Ρόλος</th><th>Κατάσταση</th><th></th></tr></thead>
        <tbody>
            @foreach (var account in cloudUsers)
            {
                <tr>
                    <td>@account.Email</td>
                    <td>@(account.Role == "admin" ? "Διαχειριστής" : "Προσωπικό")</td>
                    <td>@(account.IsActive ? "Ενεργός" : "Απενεργοποιημένος")</td>
                    <td>
                        @if (account.Role != "admin" && account.IsActive)
                        {
                            <button class="danger" disabled="@cloudBusy" @onclick="() => DeactivateCloudUserAsync(account)">Απενεργοποίηση</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
<h2>Χρήστες (πλήρης διαχείριση)</h2>
<p class="hint">Για γρήγορη προσθήκη σερβιτόρου/μπάρμαν, χρησιμοποίησε το κουμπί "Προσθήκη χρηστών" στην αρχική οθόνη.
Εδώ μπορείς επίσης να φτιάξεις άλλους λογαριασμούς Διαχειριστή, να ενεργοποιήσεις/απενεργοποιήσεις χρήστες,
να ορίσεις νέο κωδικό, ή να διαγράψεις.</p>

<div class="admin-form quick-add-form">
    <div class="form-row">
        <label>Όνομα *</label>
        <input @bind="newFirstName" placeholder="π.χ. Γιώργος" />
    </div>
    <div class="form-row">
        <label>Επώνυμο</label>
        <input @bind="newLastName" placeholder="(προαιρετικό)" />
    </div>
    <div class="form-row">
        <label>Κωδικός</label>
        <input @bind="newCode" type="password" placeholder="(προαιρετικό)" />
    </div>
    <div class="form-row">
        <label>Τηλέφωνο</label>
        <input @bind="newPhone" placeholder="(προαιρετικό)" />
    </div>
    <div class="form-row">
        <label>Ιδιότητα</label>
        <input @bind="newJobTitle" list="jobTitles" placeholder="π.χ. Σερβιτόρος" />
        <datalist id="jobTitles">
            <option value="Σερβιτόρος" />
            <option value="Barman" />
            <option value="Ταμίας" />
            <option value="Μάγειρας" />
            <option value="Βοηθός Κουζίνας" />
        </datalist>
    </div>
    <div class="form-row">
        <label>Ρόλος</label>
        <select @bind="newRole">
            <option value="Waiter">Προσωπικό (σερβιτόρος/μπάρμαν κ.λπ.)</option>
            <option value="Admin">Διαχειριστής</option>
        </select>
    </div>

    <button @onclick="Add">Προσθήκη</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="error">@errorMessage</p>
}

<table class="admin-table">
    <thead><tr><th>Όνομα</th><th>Ιδιότητα</th><th>Τηλέφωνο</th><th>Ρόλος</th><th>Ενεργός</th><th>Νέος κωδικός</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in items)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@(u.JobTitle ?? "-")</td>
                <td>@(u.Phone ?? "-")</td>
                <td>@(u.Role == Role.Admin ? "Διαχειριστής" : "Προσωπικό")</td>
                <td><input type="checkbox" checked="@u.IsActive" @onchange="e => ToggleActive(u, e)" /></td>
                <td>
                    <input @bind="codeResetValues[u.Id]" placeholder="(κενό = χωρίς κωδικό)" style="width:140px" />
                    <button @onclick="() => ResetCode(u)">Ορισμός</button>
                </td>
                <td><button class="danger" @onclick="() => Delete(u)">Διαγραφή</button></td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    private sealed record CloudManagedUser(int Id, Guid StoreId, string Email, string Role, bool IsActive);
    private static readonly JsonSerializerOptions CloudJsonOptions = new(JsonSerializerDefaults.Web);
    private readonly List<CloudManagedUser> cloudUsers = new();
    private string cloudEmail = "";
    private string cloudPassword = "";
    private string cloudRole = "waiter";
    private string? cloudMessage;
    private bool cloudIsError;
    private bool cloudBusy;

    private List<User> items = new();
    private string newFirstName = "", newLastName = "", newCode = "", newPhone = "", newJobTitle = "";
    private string newRole = "Waiter";
    private string? errorMessage;
    private Dictionary<int, string> codeResetValues = new();

    protected override async Task OnInitializedAsync()
    {
        if (Configuration.GetValue<bool>("CloudWeb:Enabled")) await LoadCloudUsersAsync();
        else await Load();
    }

    private async Task LoadCloudUsersAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("restaurantOrders.cloudPosUsers.list");
            cloudUsers.Clear();
            cloudUsers.AddRange(JsonSerializer.Deserialize<List<CloudManagedUser>>(result.GetRawText(), CloudJsonOptions) ?? new());
        }
        catch (Exception ex)
        {
            cloudMessage = "Δεν φορτώθηκαν οι λογαριασμοί Cloud POS: " + ex.Message;
            cloudIsError = true;
        }
    }

    private async Task CreateCloudUserAsync()
    {
        cloudBusy = true;
        cloudMessage = null;
        cloudIsError = false;
        try
        {
            await JS.InvokeAsync<JsonElement>("restaurantOrders.cloudPosUsers.create", new { email = cloudEmail, password = cloudPassword, role = cloudRole });
            cloudEmail = "";
            cloudPassword = "";
            cloudMessage = "Ο λογαριασμός προστέθηκε.";
            await LoadCloudUsersAsync();
        }
        catch (Exception ex)
        {
            cloudMessage = "Δεν δημιουργήθηκε ο λογαριασμός: " + ex.Message;
            cloudIsError = true;
        }
        finally { cloudBusy = false; }
    }

    private async Task DeactivateCloudUserAsync(CloudManagedUser account)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Να απενεργοποιηθεί ο λογαριασμός {account.Email};")) return;
        cloudBusy = true;
        cloudMessage = null;
        cloudIsError = false;
        try
        {
            await JS.InvokeAsync<JsonElement>("restaurantOrders.cloudPosUsers.deactivate", account.Id);
            cloudMessage = "Ο λογαριασμός απενεργοποιήθηκε.";
            await LoadCloudUsersAsync();
        }
        catch (Exception ex)
        {
            cloudMessage = "Δεν απενεργοποιήθηκε ο λογαριασμός: " + ex.Message;
            cloudIsError = true;
        }
        finally { cloudBusy = false; }
    }

    private async Task Load()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        items = await db.Users.OrderBy(u => u.FirstName).ToListAsync();
        foreach (var u in items)
        {
            if (!codeResetValues.ContainsKey(u.Id)) codeResetValues[u.Id] = "";
        }
    }

    private async Task Add()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newFirstName))
        {
            errorMessage = "Το Όνομα είναι υποχρεωτικό.";
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        db.Users.Add(new User
        {
            FirstName = newFirstName.Trim(),
            LastName = string.IsNullOrWhiteSpace(newLastName) ? null : newLastName.Trim(),
            Phone = string.IsNullOrWhiteSpace(newPhone) ? null : newPhone.Trim(),
            JobTitle = string.IsNullOrWhiteSpace(newJobTitle) ? null : newJobTitle.Trim(),
            CodeHash = string.IsNullOrWhiteSpace(newCode) ? null : PasswordHasher.Hash(newCode.Trim()),
            Role = newRole == "Admin" ? Role.Admin : Role.Waiter,
            IsActive = true
        });
        await db.SaveChangesAsync();

        newFirstName = ""; newLastName = ""; newCode = ""; newPhone = ""; newJobTitle = ""; newRole = "Waiter";
        await Load();
    }

    private async Task ResetCode(User u)
    {
        var code = codeResetValues.GetValueOrDefault(u.Id, "").Trim();

        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(u.Id);
        if (entity is not null)
        {
            entity.CodeHash = string.IsNullOrEmpty(code) ? null : PasswordHasher.Hash(code);
            await db.SaveChangesAsync();
        }
        codeResetValues[u.Id] = "";
        await Load();
    }

    private async Task ToggleActive(User u, ChangeEventArgs e)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(u.Id);
        if (entity is not null)
        {
            entity.IsActive = (bool)(e.Value ?? false);
            await db.SaveChangesAsync();
        }
        await Load();
    }

    private async Task Delete(User u)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(u.Id);
        if (entity is not null)
        {
            db.Users.Remove(entity);
            await db.SaveChangesAsync();
        }
        await Load();
    }
}
