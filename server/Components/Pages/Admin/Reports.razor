@page "/admin/reports"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<h2>Αναφορές Πωλήσεων</h2>
<p class="hint">
    Δείχνει είδη που έχουν πράγματι σταλεί/επιβεβαιωθεί (πατήθηκε "Αποστολή στην κουζίνα/μπαρ"),
    ομαδοποιημένα ανά κατηγορία και είδος, για το διάστημα που θα διαλέξεις.
</p>

<div class="admin-form">
    <label>Από:</label>
    <input type="date" @bind="fromDate" />
    <label>Έως:</label>
    <input type="date" @bind="toDate" />
    <button @onclick="RunReport">Προβολή</button>
    <a class="export-btn" href="@ExportUrl" target="_blank">⬇ Εξαγωγή σε Excel</a>
</div>

@if (hasRun)
{
    if (!rows.Any())
    {
        <p class="hint">Δεν βρέθηκαν πωλήσεις σε αυτό το διάστημα.</p>
    }
    else
    {
        @foreach (var catGroup in rows.GroupBy(r => r.Category))
        {
            <h3>@catGroup.Key <span class="hint">(@catGroup.Sum(r => r.Quantity) τεμ. — €@catGroup.Sum(r => r.Revenue).ToString("0.00"))</span></h3>
            <table class="admin-table">
                <thead><tr><th>Είδος</th><th>Ποσότητα</th><th>Έσοδα</th></tr></thead>
                <tbody>
                    @foreach (var row in catGroup.OrderByDescending(r => r.Quantity))
                    {
                        <tr>
                            <td>@row.ItemName</td>
                            <td>@row.Quantity</td>
                            <td>€@row.Revenue.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <p class="total"><strong>Γενικό σύνολο: @rows.Sum(r => r.Quantity) τεμ. — €@rows.Sum(r => r.Revenue).ToString("0.00")</strong></p>
    }
}

<h2>Ιστορικό και αναφορά ακυρώσεων</h2>
<p class="hint">Καταγράφονται οι ακυρώσεις ειδών και παραγγελιών, καθώς και οι αναγκαστικές ενέργειες, με τον χρήστη που τις εκτέλεσε.</p>
@if (hasRun)
{
    if (!cancellationRows.Any())
    {
        <p class="hint">Δεν υπάρχουν ακυρώσεις ή αναγκαστικές ενέργειες για το επιλεγμένο διάστημα.</p>
    }
    else
    {
        <p class="total"><strong>Σύνολο αξίας ακυρωμένων ειδών/παραγγελιών: €@cancellationRows.Where(x => x.Action.Contains("Ακύρωση")).Sum(x => x.Amount).ToString("0.00")</strong></p>
        <table class="admin-table">
            <thead><tr><th>Ημερομηνία / ώρα</th><th>Χρήστης</th><th>Τραπέζι</th><th>Ενέργεια</th><th>Είδη</th><th>Ποσότητα</th><th>Αξία</th><th>Αιτία / αποτέλεσμα</th></tr></thead>
            <tbody>
                @foreach (var row in cancellationRows)
                {
                    <tr>
                        <td>@row.At.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@row.Employee</td>
                        <td>@row.Table</td>
                        <td>@row.Action</td>
                        <td>@row.Description</td>
                        <td>@row.Quantity</td>
                        <td>€@row.Amount.ToString("0.00")</td>
                        <td>@row.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private List<Services.ReportRow> rows = new();
    private List<Services.CancellationReportRow> cancellationRows = new();
    private bool hasRun;

    private string ExportUrl => $"/api/reports/export?from={fromDate:yyyy-MM-dd}&to={toDate:yyyy-MM-dd}";

    protected override async Task OnInitializedAsync() => await RunReport();

    private async Task RunReport()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        rows = await Services.ReportService.GetSalesReport(db, fromDate, toDate);
        cancellationRows = await Services.CancellationAuditService.GetReportAsync(db, fromDate, toDate);
        hasRun = true;
    }
}
