    private async Task RefreshPreloadedRowsAsync()
    {
        var allRows = await LoadPreloadedRowsAsync();
        preloadedRows = allRows.Where(x => x.DayCloseId is null).ToList();
        carriedPreloadedRows = allRows.Where(x => x.DayCloseId is not null).ToList();
    }

    private async Task LoadPendingFiscalRowsAsync()
    {
        if (loadingPendingFiscal) return;
        loadingPendingFiscal = true;
        pendingFiscalChecked = true;
        pendingFiscalMessage = null;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            pendingFiscalRows = (await FiscalDocuments.GetPendingTransmissionsAsync(db)).ToList();
        }
        catch (Exception ex)
        {
            pendingFiscalMessage = "Δεν ήταν δυνατή η ανάγνωση των εκκρεμών διαβιβάσεων: " + ex.Message;
        }
        finally { loadingPendingFiscal = false; }
    }

    private async Task RetryPendingFiscalTransmissionAsync(PendingFiscalTransmission row)
    {
        var orderId = row.OrderId;
        if (retryingFiscalOrderId.HasValue) return;
        retryingFiscalOrderId = orderId;
        pendingFiscalMessage = null;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var result = await FiscalOutbox.CheckAsync(db, row);
            pendingFiscalMessage = result.Mark > 0 ? $"Το παραστατικό επιβεβαιώθηκε (ΜΑΡΚ {result.Mark})."
                : result.ErrorMessage ?? "Ο έλεγχος ολοκληρώθηκε χωρίς νέο ΜΑΡΚ.";
            pendingFiscalRows = (await FiscalDocuments.GetPendingTransmissionsAsync(db)).ToList();
            await LoadCurrent();
            await LoadDailyActivity();
        }
        catch (Exception ex)
        {
            pendingFiscalMessage = "Απέτυχε ο επανέλεγχος: " + ex.Message;
        }
        finally { retryingFiscalOrderId = null; }
    }

    private async Task CloseEmployee(int waiterUserId, string employeeName)
    {
        statusMessage = null;

        if (printerId == 0)
        {
            statusMessage = "Διάλεξε πρώτα εκτυπωτή.";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Κλείσιμο ταμείου για {employeeName}; Οι υπόλοιποι υπάλληλοι δεν επηρεάζονται.");
        if (!confirmed) return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        using var db = await DbFactory.CreateDbContextAsync();
        var record = await Services.CashierService.PerformEmployeeClose(db, waiterUserId, userId);

        var station = await db.PrinterStations.FindAsync(printerId);
        if (station is not null)
        {
            var ok = await Printer.PrintDayCloseAsync(station, record);
            statusMessage = ok
                ? $"Το ταμείο του/της {employeeName} τυπώθηκε στον εκτυπωτή '{station.Name}'."
                : $"⚠ Καταγράφηκε, αλλά απέτυχε η εκτύπωση στον '{station.Name}'.";
        }

        await LoadCurrent();
        await LoadHistory();
    }

    private async Task CloseDay()
    {
        statusMessage = null;

        if (printerId == 0)
        {
            statusMessage = "Διάλεξε πρώτα εκτυπωτή για να τυπωθεί το κλείσιμο.";
            return;
        }

        var pendingInfo = preloadedRows.Count > 0
            ? $" Θα καταγραφούν επίσης {preloadedRows.Count} εκκρεμείς προφορτώσεις (€{preloadedRows.Sum(x => x.Amount):0.00}) και θα παραμείνουν διαθέσιμες για μεταγενέστερη τακτοποίηση."
            : "";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Θέλετε όντως να κάνετε κλείσιμο ημέρας; Το τρέχον ταμείο και ο αριθμός παραγγελιών θα μηδενιστούν.{pendingInfo}");
        if (!confirmed) return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        using var db = await DbFactory.CreateDbContextAsync();
        var record = await Services.CashierService.PerformDayClose(db, userId);

        var station = await db.PrinterStations.FindAsync(printerId);
        if (station is not null)
        {
            var ok = await Printer.PrintDayCloseAsync(station, record);
            statusMessage = ok
                ? $"Το κλείσιμο τυπώθηκε στον εκτυπωτή '{station.Name}'."
                : $"⚠ Το κλείσιμο καταγράφηκε, αλλά απέτυχε η εκτύπωση στον '{station.Name}'.";
        }

        await LoadCurrent();
        await LoadHistory();
        await RefreshPreloadedRowsAsync();
    }
