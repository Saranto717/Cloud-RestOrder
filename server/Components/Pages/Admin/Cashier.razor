@code {
    private bool unlocked;
    private string enteredPin = "";
    private bool pinError;

    private List<Services.EmployeeSummary> currentRows = new();
    private List<PrinterStation> printers = new();
    private int printerId = 0;
    private string? statusMessage;

    private DateTime selectedDate = DateTime.Today;
    private List<Services.DayCloseRecord> history = new();
    private DateTime activityDate = DateTime.Today;
    private Services.CashierDailyActivity dailyActivity = new();
    private bool reconcilingPreloads;
    private bool preloadedChecked;
    private string? preloadedMessage;
    private List<PreloadedCashierRow> preloadedRows = new();
    private List<PreloadedCashierRow> carriedPreloadedRows = new();
    private sealed record PreloadedCashierRow(string Series, long? Number, string Table, string Terminal, DateTime CreatedAt, decimal Amount, string Status, int? DayCloseId);
    private List<PendingFiscalTransmission> pendingFiscalRows = new();
    private bool loadingPendingFiscal;
    private bool pendingFiscalChecked;
    private int? retryingFiscalOrderId;
    private string? pendingFiscalMessage;

    private static List<PaymentMethod> AlternativePaymentMethods(IEnumerable<Services.EmployeeSummary> rows) => rows
        .SelectMany(row => row.OtherPaymentTotals.Keys)
        .Distinct()
        .OrderBy(PaymentMethodInfo.GetMyDataCode)
        .ToList();

    private static decimal AlternativePaymentAmount(Services.EmployeeSummary row, PaymentMethod method) =>
        row.OtherPaymentTotals.TryGetValue(method, out var amount) ? amount : 0m;

    private static string ShortPaymentMethodName(PaymentMethod method) => method switch
    {
        PaymentMethod.DomesticBankAccount => "Κατάθεση",
        PaymentMethod.ForeignBankAccount => "Τράπεζα αλλοδαπής",
        PaymentMethod.Check => "Επιταγή",
        PaymentMethod.Credit => "Επί πιστώσει",
        PaymentMethod.WebBanking => "Web Banking",
