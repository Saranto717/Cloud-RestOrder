    private async Task CheckPin()
    {
        pinError = false;
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.Users.FindAsync(userId);

        if (user is null || (user.HasCode && !PasswordHasher.Verify(enteredPin, user.CodeHash!)))
        {
            pinError = true;
            return;
        }

        unlocked = true;
        printers = await db.PrinterStations.Where(p => p.ConnectionType != "Sunmi").OrderBy(p => p.Name).ToListAsync();
        await LoadCurrent();
        await LoadHistory();
        await LoadDailyActivity();
        await RefreshPreloadedRowsAsync();
        await LoadPendingFiscalRowsAsync();
    }

    private async Task LoadCurrent()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        currentRows = await Services.CashierService.GetCurrentSummary(db);
    }

    private async Task LoadHistory()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        history = await Services.CashierService.GetClosingsForDate(db, selectedDate);
    }

    private async Task LoadDailyActivity()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        dailyActivity = await Services.CashierActivityService.GetForDate(db, activityDate);
    }

    private async Task ReconcilePreloadedPaymentsAsync()
    {
        if (reconcilingPreloads) return;
        reconcilingPreloads = true;
        preloadedChecked = true;
        preloadedMessage = null;
        preloadedRows.Clear();
        var messages = new List<string>();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var pending = await db.Orders.Include(o => o.RestaurantTable).Include(o => o.Items).ThenInclude(i => i.MenuItem).ThenInclude(m => m!.MenuCategory)
                .Where(o => o.AadePreloadedStatus == "Pending" && o.AadePreloadedTerminalSettingsId != null && o.AadePreloadedIntentId != null && o.FiscalStatus == FiscalStatus.Issued)
                .OrderBy(o => o.AadePreloadedAt).ToListAsync();
            if (pending.Count == 0) { preloadedMessage = "Δεν υπάρχουν προφορτώσεις σε αναμονή."; return; }

            // ePay's WebECR getpending asks the POS to resend the results of
            // preloaded transactions. Run once per physical terminal before
            // looking up each order by its CustomerReference.
            var epayPendingResults = new Dictionary<int, EpayWebEcrService.PendingTransactionsResult>();
            foreach (var terminalGroup in pending.Where(o => o.AadePreloadedTerminalSettingsId.HasValue)
                         .GroupBy(o => o.AadePreloadedTerminalSettingsId!.Value))
            {
                var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x => x.Id == terminalGroup.Key);
                if (terminal is null || !(terminal.Provider.Contains("ePay", StringComparison.OrdinalIgnoreCase) || terminal.Provider.Contains("Euronet", StringComparison.OrdinalIgnoreCase))) continue;
                var result = await EpayPos.RequestPendingTransactionsAsync(terminal);
                epayPendingResults[terminalGroup.Key] = result;
                messages.Add(result.Success
                    ? $"ePay {terminal.TerminalId}: {result.Message}"
                    : $"ePay {terminal.TerminalId}: {result.Message}");
            }

            foreach (var order in pending)
            {
                var terminal = await db.BankPosTerminalSettings.FirstOrDefaultAsync(x => x.Id == order.AadePreloadedTerminalSettingsId);
                if (terminal is null) { messages.Add($"Παραγγελία #{order.Id}: δεν βρέθηκαν οι ρυθμίσεις POS."); continue; }
                PreloadedPosStatusResult posStatus;
                if (terminal.Protocol.Contains("Viva", StringComparison.OrdinalIgnoreCase) || terminal.Provider.Contains("Viva", StringComparison.OrdinalIgnoreCase))
                    posStatus = await VivaPos.GetPreloadedStatusAsync(terminal, order.AadePreloadedIntentId!);
                else if (terminal.Protocol.Contains("EDPS", StringComparison.OrdinalIgnoreCase) || terminal.Provider.Contains("EDPS", StringComparison.OrdinalIgnoreCase))
                    posStatus = await EdpsPos.GetPreloadedStatusAsync(terminal, order.AadePreloadedIntentId!);
                else
                {
                    if (order.AadePreloadedTerminalSettingsId is int terminalId && epayPendingResults.TryGetValue(terminalId, out var resendResult) && !resendResult.Success)
                    {
                        order.AadePreloadedStatusMessage = "Δεν έγινε λήψη αποτελεσμάτων από το POS μέσω getpending. " + resendResult.Message;
                        messages.Add($"Παραγγελία #{order.Id}: {order.AadePreloadedStatusMessage}");
                        await db.SaveChangesAsync();
                        continue;
                    }
                    posStatus = await EpayPos.GetPreloadedStatusAsync(terminal, order.AadePreloadedIntentId!);
                }

                order.AadePreloadedStatusMessage = posStatus.Message;
                if (posStatus.State == PreloadedPosState.Paid)
                {
                    var actualMethod = posStatus.PaymentMethod ?? posStatus.PaymentType switch
                    {
                        1 => PaymentMethod.Iris,
                        2 or 5 => PaymentMethod.Credit,
                        _ => PaymentMethod.Card
                    };
                    var transactionId = posStatus.TransactionId;
                    if (string.IsNullOrWhiteSpace(transactionId))
                    {
                        messages.Add($"Παραγγελία #{order.Id}: το POS αναφέρει πληρωμή, αλλά δεν επέστρεψε Transaction ID.");
                        continue;
                    }
                    var total = FiscalPayloadBuilder.CalculateTotals(order.Items.Where(i => !i.IsCancelled && i.Quantity > 0).ToList()).Gross;
                    var paymentInfo = actualMethod switch { PaymentMethod.Iris => "IRIS", PaymentMethod.Credit => "Επί πιστώσει", _ => "Κάρτα" };
                    var submit = await FiscalDocuments.SubmitPreloadedPaymentAsync(db, order, total, transactionId,
                        order.ParochosPaymentSignature ?? "", order.CardTerminalId ?? terminal.TerminalId,
                        paymentInfo, PaymentMethodInfo.GetMyDataCode(actualMethod));
                    if (submit.Success)
                    {
                        order.PaymentMethod = actualMethod;
                        order.CardTransactionId = transactionId;
                        order.AadePreloadedStatus = "Settled";
                        order.AadePreloadedStatusMessage = $"Εξοφλήθηκε στο POS με {paymentInfo} και καταχωρίστηκε στον πάροχο.";
                        messages.Add($"Παραγγελία #{order.Id}: εξοφλήθηκε ({paymentInfo}).");
                    }
                    else
                    {
                        order.AadePreloadedStatusMessage = "Το POS επιβεβαίωσε πληρωμή, αλλά η καταχώριση στον πάροχο εκκρεμεί: " + (submit.ErrorMessage ?? "άγνωστο σφάλμα");
                        messages.Add($"Παραγγελία #{order.Id}: η πληρωμή έγινε, αλλά εκκρεμεί η αποστολή στον πάροχο. {submit.ErrorMessage}");
                    }
                }
                else if (posStatus.State == PreloadedPosState.Cancelled)
                {
                    var credit = await FiscalDocuments.CreditIssuedDocumentAsync(db, order.Id, null, "Η προφορτωμένη συναλλαγή ακυρώθηκε στο POS");
                    if (credit.Success)
                    {
                        order.AadePreloadedStatus = "Cancelled";
                        order.AadePreloadedStatusMessage = "Η συναλλαγή ακυρώθηκε στο POS και εκδόθηκε πιστωτικό παραστατικό.";
                        messages.Add($"Παραγγελία #{order.Id}: ακυρώθηκε στο POS και εκδόθηκε πιστωτικό.");
                    }
                    else
                    {
                        order.AadePreloadedStatusMessage = "Το POS ακύρωσε τη συναλλαγή, αλλά απέτυχε η έκδοση πιστωτικού: " + (credit.ErrorMessage ?? "άγνωστο σφάλμα");
                        messages.Add($"Παραγγελία #{order.Id}: απαιτείται επανάληψη έκδοσης πιστωτικού. {credit.ErrorMessage}");
                    }
                }
                else
                {
                    messages.Add($"Παραγγελία #{order.Id}: {posStatus.Message}");
                }
                await db.SaveChangesAsync();
            }
            await RefreshPreloadedRowsAsync();
            preloadedMessage = string.Join(" ", messages);
            await LoadCurrent();
            await LoadDailyActivity();
        }
        catch (Exception ex)
        {
            preloadedMessage = "Απέτυχε ο έλεγχος προφορτώσεων: " + ex.Message;
        }
        finally { reconcilingPreloads = false; }
    }

    private async Task<List<PreloadedCashierRow>> LoadPreloadedRowsAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Orders.Include(o => o.RestaurantTable).Include(o => o.Items).Include(o => o.Items).ThenInclude(i => i.MenuItem)
            .Where(o => o.AadePreloadedStatus == "Pending" && o.FiscalStatus == FiscalStatus.Issued)
            .OrderBy(o => o.AadePreloadedAt).ToListAsync();
        var output = new List<PreloadedCashierRow>();
        foreach (var order in rows)
        {
            var terminal = order.AadePreloadedTerminalSettingsId is int id ? await db.BankPosTerminalSettings.FindAsync(id) : null;
            var amount = FiscalPayloadBuilder.CalculateTotals(order.Items.Where(i => !i.IsCancelled && i.Quantity > 0).ToList()).Gross;
            output.Add(new(order.InvoiceSeriesName ?? "Απόδειξη", order.InvoiceNumber, order.RestaurantTable?.Name ?? "—", terminal?.Name ?? "—", order.AadePreloadedAt ?? order.CreatedAt, amount, order.AadePreloadedStatusMessage ?? "Σε αναμονή", order.DayCloseId));
        }
