@page "/admin/cloud-sync"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable
@inject IConfiguration Configuration
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CloudSyncCredentialProtector CredentialProtector
@inject CloudSyncRuntimeState RuntimeState

<PageTitle>Σύνδεση Cloud</PageTitle>

@if (Configuration.GetValue<bool>("CloudWeb:Enabled"))
{
    <section class="admin-form">
        <h2>Cloud POS</h2>
        <p>Αυτή είναι η cloud έκδοση της εφαρμογής. Η σύνδεση του καταστήματος και ο συγχρονισμός με το Windows POS ρυθμίζονται από το τοπικό πρόγραμμα, στην επιλογή «Σύνδεση Cloud».</p>
        <p>Οι χρήστες, τα τραπέζια, ο κατάλογος, οι παραγγελίες και τα υπόλοιπα στοιχεία αυτής της εγκατάστασης αποθηκεύονται στον ξεχωριστό χώρο του καταστήματος.</p>
    </section>
}
else
{
<div class="cloud-sync-page">
    <div class="cloud-sync-heading">
        <div>
            <p class="cloud-sync-eyebrow">WINDOWS POS · CLOUD</p>
            <h1>Σύνδεση Cloud</h1>
            <p>Το Windows POS συνεχίζει να δουλεύει από την τοπική SQLite βάση. Όταν υπάρχει Internet, στέλνει τις αλλαγές στο cloud και λαμβάνει τις παραγγελίες των tablet.</p>
        </div>
        <span class="cloud-sync-state @(enabled ? "is-on" : "is-off")"><i></i>@(enabled ? "Ενεργός συγχρονισμός" : "Απενεργοποιημένος")</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <div class="cloud-sync-notice @(hasError ? "is-error" : "is-success")" role="status">@notice</div>
    }

    <div class="cloud-sync-grid">
        <section class="cloud-sync-card cloud-sync-form-card">
            <div class="cloud-sync-card-title"><span class="cloud-sync-icon">↔</span><div><h2>Σύζευξη καταστήματος</h2><p>Πάρε το token μία φορά από το License Manager.</p></div></div>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="cloud-sync-field">
                    <label>Cloud License Manager</label>
                    <input value="https://texn-support.ddns.net/" readonly aria-label="Διεύθυνση Cloud License Manager" />
                    <small>Η σύνδεση δεδομένων απαιτεί HTTPS. Δεν στέλνουμε στοιχεία σύνδεσης μέσω HTTP.</small>
                </div>
                <div class="cloud-sync-field">
                    <label for="store-token">Store API token</label>
                    <input id="store-token" type="password" autocomplete="new-password" @bind="storeTokenInput" placeholder="@(hasStoredToken ? "Υπάρχει ήδη αποθηκευμένο token · άφησέ το κενό" : "Επικόλλησε το token του καταστήματος")" />
                    <small>Αποθηκεύεται κρυπτογραφημένο σε αυτόν τον υπολογιστή. Δεν εμφανίζεται ξανά μετά την αποθήκευση.</small>
                </div>
                <label class="cloud-sync-toggle"><input type="checkbox" @bind="enabled" /><span><strong>Ενεργοποίηση αμφίδρομου συγχρονισμού</strong><small>Οι τοπικές αλλαγές μένουν στην ουρά μέχρι να υπάρχει σύνδεση.</small></span></label>
                <button class="cloud-sync-primary" type="submit" disabled="@saving">@(saving ? "Αποθήκευση…" : "Αποθήκευση σύνδεσης")</button>
            </form>
        </section>

        <section class="cloud-sync-card cloud-sync-status-card">
            <div class="cloud-sync-card-title"><span class="cloud-sync-icon cloud-sync-icon-green">✓</span><div><h2>Κατάσταση</h2><p>Το API και τα κλειδιά συσκευής ρυθμίζονται αυτόματα.</p></div></div>
            <dl class="cloud-sync-details">
                <div><dt>Κατάστημα</dt><dd>@(hasStoredToken ? "Συζευγμένο" : "Δεν έχει συνδεθεί")</dd></div>
                <div><dt>Εγκατάσταση</dt><dd>Δημιουργείται ανά Windows υπολογιστή</dd></div>
                <div><dt>Τελευταίος συγχρονισμός</dt><dd>@(lastSync is null ? "Δεν έχει ολοκληρωθεί ακόμη" : lastSync.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</dd></div>
                <div><dt>Εκκρεμείς αλλαγές</dt><dd>@pendingCount</dd></div>
            </dl>
            @if (deviceRegistered)
            {
                <p class="cloud-sync-inline-success">Η εγκατάσταση έχει καταχωρηθεί με δικό της υπογεγραμμένο κλειδί.</p>
            }
            @if (!string.IsNullOrWhiteSpace(lastError))
            {
                <p class="cloud-sync-inline-error">@lastError</p>
            }
        </section>
    </div>

    <section class="cloud-sync-help">
        <h2>Ρύθμιση για πρώτη φορά</h2>
        <ol>
            <li>Στο License Manager δημιούργησε το cloud κατάστημα και τον πρώτο λογαριασμό διαχειριστή tablet.</li>
            <li>Αντέγραψε το Store API token που εμφανίζεται μία φορά και επικόλλησέ το εδώ.</li>
            <li>Ενεργοποίησε τον συγχρονισμό. Το POS θα στείλει αρχικά τον κατάλογο και τα τραπέζια.</li>
            <li>Στο Android άνοιξε <code>https://texn-support.ddns.net/pos.html</code> και συνδέσου με τον λογαριασμό tablet.</li>
        </ol>
        <p>Αν πέσει το Internet, οι παραγγελίες του Windows POS συνεχίζουν τοπικά. Τα tablet χρειάζονται σύνδεση για να πάρουν ή να στείλουν νέες παραγγελίες. Όταν επανέλθει το δίκτυο, οι αλλαγές Windows αποστέλλονται και οι παραγγελίες tablet περνούν στην τοπική βάση και στους εκτυπωτές.</p>
    </section>
</div>
}

<style>
    .cloud-sync-page{max-width:1180px;margin:28px auto;padding:0 22px 40px;color:#17243d}
    .cloud-sync-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:22px}
    .cloud-sync-heading h1{font-size:30px;margin:2px 0 8px;color:#142344}
    .cloud-sync-heading p:not(.cloud-sync-eyebrow){max-width:760px;margin:0;color:#687794;line-height:1.55}
    .cloud-sync-eyebrow{font-size:11px;letter-spacing:.14em;font-weight:800;color:#3c63dd;margin:0}
    .cloud-sync-state{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border:1px solid #dce4f2;background:#fff;border-radius:999px;padding:10px 14px;font-size:13px;font-weight:700}
    .cloud-sync-state i{width:8px;height:8px;border-radius:50%;background:#a0aabd}.cloud-sync-state.is-on i{background:#28a878;box-shadow:0 0 0 4px #e5f7ef}
    .cloud-sync-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}
    .cloud-sync-card,.cloud-sync-help{background:#fff;border:1px solid #dce4f2;border-radius:17px;padding:22px;box-shadow:0 8px 24px #233c6410}
    .cloud-sync-card-title{display:flex;align-items:center;gap:13px;margin-bottom:22px}.cloud-sync-card-title h2,.cloud-sync-help h2{margin:0;font-size:18px}.cloud-sync-card-title p{margin:4px 0 0;color:#77839b;font-size:13px}
    .cloud-sync-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#eef2ff;color:#3b61dc;font-size:22px;font-weight:800}.cloud-sync-icon-green{background:#e7f8f0;color:#159b68}
    .cloud-sync-field{display:grid;gap:7px;margin-bottom:17px}.cloud-sync-field label,.cloud-sync-toggle strong{font-size:13px;font-weight:750}.cloud-sync-field input{width:100%;box-sizing:border-box;border:1px solid #ccd7ea;border-radius:9px;padding:12px 13px;color:#17243d;background:#fff;font:inherit}.cloud-sync-field input:focus{outline:3px solid #dfe8ff;border-color:#5678e8}.cloud-sync-field input[readonly]{background:#f5f7fb;color:#586887}.cloud-sync-field small,.cloud-sync-toggle small{color:#7b879e;line-height:1.45}
    .cloud-sync-toggle{display:flex;align-items:flex-start;gap:11px;padding:14px;border:1px solid #e2e8f2;border-radius:11px;background:#f8faff;margin:4px 0 17px}.cloud-sync-toggle input{accent-color:#315cda;width:17px;height:17px;margin-top:2px}.cloud-sync-toggle span{display:grid;gap:4px}
    .cloud-sync-primary{width:100%;border:0;border-radius:10px;background:#315bd8;color:white;font:inherit;font-weight:800;padding:13px;cursor:pointer}.cloud-sync-primary:disabled{opacity:.6;cursor:wait}
    .cloud-sync-details{display:grid;gap:0;margin:0}.cloud-sync-details div{display:flex;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #edf0f6}.cloud-sync-details div:last-child{border-bottom:0}.cloud-sync-details dt{color:#77839b;font-size:13px}.cloud-sync-details dd{margin:0;text-align:right;font-size:13px;font-weight:700;max-width:58%;overflow-wrap:anywhere}
    .cloud-sync-inline-success,.cloud-sync-inline-error,.cloud-sync-notice{border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.5}.cloud-sync-inline-success,.cloud-sync-notice.is-success{background:#e9f8ef;color:#167448}.cloud-sync-inline-error,.cloud-sync-notice.is-error{background:#fff0ef;color:#b42318}.cloud-sync-notice{margin-bottom:16px}
    .cloud-sync-help{margin-top:18px}.cloud-sync-help ol{padding-left:22px;line-height:1.7;color:#3c4c69}.cloud-sync-help>p{color:#75819a;line-height:1.6;margin-bottom:0}.cloud-sync-help code{color:#294da8;background:#f0f4ff;padding:2px 5px;border-radius:4px}
    @@media(max-width:850px){.cloud-sync-grid{grid-template-columns:1fr}.cloud-sync-heading{align-items:flex-start;flex-direction:column}}
</style>

@code {
    private string apiBaseUrl = "https://texn-support.ddns.net/";
    private string storeTokenInput = "";
    private bool enabled;
    private bool saving;
    private bool hasStoredToken;
    private bool deviceRegistered;
    private int pendingCount;
    private DateTimeOffset? lastSync;
    private string? lastError;
    private string? notice;
    private bool hasError;
    private PeriodicTimer? refreshTimer;
    private CancellationTokenSource? refreshCancellation;

    protected override async Task OnInitializedAsync()
    {
        if (Configuration.GetValue<bool>("CloudWeb:Enabled")) return;
        await LoadAsync();
        refreshCancellation = new CancellationTokenSource();
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = RefreshStatusAsync(refreshCancellation.Token);
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.CloudSyncSettings.AsNoTracking().SingleOrDefaultAsync(item => item.Id == 1);
        if (settings is null) return;
        apiBaseUrl = settings.ApiBaseUrl;
        enabled = settings.Enabled;
        hasStoredToken = !string.IsNullOrWhiteSpace(settings.ProtectedStoreToken);
        deviceRegistered = settings.DeviceRegistered;
        lastSync = settings.LastSuccessfulSyncAtUtc;
        lastError = settings.LastSyncError;
        pendingCount = await db.CloudSyncOutboxEvents.CountAsync(item => item.AcknowledgedAtUtc == null);
        RuntimeState.SetEnabled(enabled);
    }

    private async Task SaveAsync()
    {
        saving = true;
        notice = null;
        hasError = false;
        try
        {
            if (!Uri.TryCreate(apiBaseUrl, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps || !string.IsNullOrEmpty(uri.UserInfo))
                throw new InvalidOperationException("Χρειάζεται έγκυρη διεύθυνση HTTPS.");
            await using var db = await DbFactory.CreateDbContextAsync();
            var settings = await db.CloudSyncSettings.SingleAsync(item => item.Id == 1);
            if (!string.IsNullOrWhiteSpace(storeTokenInput))
            {
                if (storeTokenInput.Length is < 32 or > 256)
                    throw new InvalidOperationException("Το Store API token δεν έχει έγκυρο μήκος.");
                settings.ProtectedStoreToken = CredentialProtector.Protect(storeTokenInput.Trim());
                settings.DeviceRegistered = false;
                storeTokenInput = "";
            }
            if (enabled && string.IsNullOrWhiteSpace(settings.ProtectedStoreToken))
                throw new InvalidOperationException("Πριν ενεργοποιήσεις τον συγχρονισμό, επικόλλησε το Store API token.");
            settings.ApiBaseUrl = new UriBuilder(uri) { Path = "/", Query = "", Fragment = "" }.Uri.ToString();
            settings.Enabled = enabled;
            settings.LastSyncError = null;
            db.SuppressCloudSyncCapture = true;
            await db.SaveChangesAsync();
            RuntimeState.SetEnabled(enabled);
            hasStoredToken = !string.IsNullOrWhiteSpace(settings.ProtectedStoreToken);
            deviceRegistered = settings.DeviceRegistered;
            notice = enabled ? "Η σύνδεση αποθηκεύτηκε. Η αρχική σύζευξη θα ξεκινήσει αυτόματα." : "Η σύνδεση αποθηκεύτηκε και ο συγχρονισμός απενεργοποιήθηκε.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            notice = ex.Message;
        }
        finally { saving = false; }
    }

    private async Task RefreshStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await refreshTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await using var db = await DbFactory.CreateDbContextAsync(cancellationToken);
                var settings = await db.CloudSyncSettings.AsNoTracking().SingleOrDefaultAsync(item => item.Id == 1, cancellationToken);
                if (settings is not null)
                {
                    hasStoredToken = !string.IsNullOrWhiteSpace(settings.ProtectedStoreToken);
                    deviceRegistered = settings.DeviceRegistered;
                    lastSync = settings.LastSuccessfulSyncAtUtc;
                    lastError = settings.LastSyncError;
                    pendingCount = await db.CloudSyncOutboxEvents.CountAsync(item => item.AcknowledgedAtUtc == null, cancellationToken);
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        refreshCancellation?.Cancel();
        refreshCancellation?.Dispose();
        refreshTimer?.Dispose();
    }
}
