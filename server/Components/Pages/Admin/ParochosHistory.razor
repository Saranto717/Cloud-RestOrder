@page "/admin/parochos-history"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<style>
    .provider-history { max-width:1200px; margin:20px auto; padding:0 12px 30px; }
    .provider-history-controls { display:flex; gap:8px; flex-wrap:wrap; margin:14px 0; }
    .provider-history-controls input { flex:1; min-width:220px; padding:10px; border:1px solid #cad5e6; border-radius:8px; }
    .provider-history button { border:0; padding:10px 14px; border-radius:8px; background:#1d3159; color:#fff; cursor:pointer; }
    .provider-history-list { display:grid; gap:8px; }
    .provider-history-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px; background:#fff; border:1px solid #dce5f0; border-radius:10px; }
    .provider-history-row small { display:block; margin-top:5px; overflow-wrap:anywhere; color:#52637b; }
    .provider-history-json { margin-top:16px; padding:15px; background:#fff; border-radius:12px; }
    .provider-history-json pre { max-height:420px; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; padding:12px; background:#f1f5fa; border-radius:8px; }
    @@media(max-width:600px) { .provider-history-row { align-items:stretch; flex-direction:column; } }
</style>
<div class="provider-history">
    <h2>Ιστορικό Parochos</h2>
    <p>Αιτήματα και απαντήσεις αποστολής και ελέγχου παραστατικών. Το ιστορικό αρχίζει από την εγκατάσταση αυτής της έκδοσης.</p>
    <div class="provider-history-controls">
        <input placeholder="Αναζήτηση: αναγνωριστικό, σειρά ή αριθμός" @bind="search" @bind:event="oninput" />
        <button @onclick="LoadAsync">Αναζήτηση</button>
    </div>
    @if (rows.Count == 0) { <p>Δεν βρέθηκαν καταχωρίσεις.</p> }
    <div class="provider-history-list">
        @foreach (var row in rows)
        {
            <div class="provider-history-row">
                <div>
                    <strong>@row.AttemptedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · @(row.Operation == "/api/send" ? "Αποστολή" : "Έλεγχος") · @(row.Production ? "Παραγωγή" : "Δοκιμαστικό")</strong>
                    <small>Αναγνωριστικό: @(row.ExternalSystemId ?? "—") · Process ID: @(row.ProcessId ?? "—") · HTTP @(row.HttpStatus?.ToString() ?? "—")</small>
                    @if (row.TransportError == "NotSentAuthentication") { <small>Η σύνδεση απέτυχε πριν σταλεί το αίτημα.</small> }
                    else if (row.TransportError is not null) { <small>Δεν λήφθηκε απάντηση (@row.TransportError).</small> }
                </div>
                <button @onclick="() => selected = row">Προβολή JSON</button>
            </div>
        }
    </div>
    @if (selected is not null)
    {
        <section class="provider-history-json">
            <button @onclick="() => selected = null">Κλείσιμο</button>
            <h3>Αίτημα προς Parochos</h3><pre>@Pretty(selected.RequestJson)</pre>
            <h3>Απάντηση Parochos</h3><pre>@(selected.ResponseBody is null ? "Δεν λήφθηκε απάντηση." : Pretty(selected.ResponseBody))</pre>
        </section>
    }
</div>
@code {
    private string search = "";
    private List<FiscalProviderExchange> rows = new();
    private FiscalProviderExchange? selected;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var q = db.FiscalProviderExchanges.AsNoTracking();
        var term = search.Trim();
        if (term.Length > 0) q = q.Where(x => (x.ExternalSystemId != null && x.ExternalSystemId.Contains(term)) ||
            (x.ProcessId != null && x.ProcessId.Contains(term)) || x.RequestJson.Contains(term));
        rows = await q.OrderByDescending(x => x.Id).Take(200).ToListAsync();
        selected = null;
    }
    private static string Pretty(string value)
    {
        try { using var json = System.Text.Json.JsonDocument.Parse(value); return System.Text.Json.JsonSerializer.Serialize(json.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); }
        catch (System.Text.Json.JsonException) { return value; }
    }
}
