@page "/login"
@layout RestaurantOrders.Components.Layout.MainLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<div class="userpick-wrap staff-picker-wrap">
    <div class="staff-picker-heading">
        <span class="welcome-kicker">ΔΙΑΧΕΙΡΙΣΗ</span>
        <h2>Σύνδεση διαχειριστή</h2>
        <p class="subtitle">Επίλεξε τον χρήστη σου για να συνεχίσεις</p>
    </div>

    @if (HasError)
    {
        <p class="error">Λάθος κωδικός. Δοκίμασε ξανά.</p>
    }

    @if (selectedUser is null)
    {
        <div class="user-grid">
            @foreach (var u in users)
            {
                <button class="user-tile" @onclick="() => SelectUser(u)">
                    <span class="avatar" aria-hidden="true">@Initials(u.FullName)</span>
                    <span>@u.FullName</span>
                    <small>@(u.HasCode ? "Κωδικός πρόσβασης" : "Άμεση είσοδος")</small>
                </button>
            }
        </div>
        @if (users.Count == 0 && CanBootstrapAdmin)
        {
            <div class="login-box">
                <h3>Αρχικός διαχειριστής</h3>
                <p>Δημιούργησε τον πρώτο χρήστη του καταστήματος.</p>
                <form method="post" action="/api/bootstrap-admin">
                    <label>Ονοματεπώνυμο</label>
                    <input type="text" name="fullName" autocomplete="name" maxlength="120" required />
                    <label>PIN τεσσάρων ψηφίων</label>
                    <input type="password" name="pin" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" autocomplete="new-password" required />
                    <label>Επιβεβαίωση PIN</label>
                    <input type="password" name="pinConfirmation" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" autocomplete="new-password" required />
                    <button type="submit">Δημιουργία και είσοδος</button>
                </form>
            </div>
        }
        else if (users.Count == 0)
        {
            <p class="hint">Δεν υπάρχει ακόμα κανένας διαχειριστής.</p>
        }
    }
    else
    {
        <div class="login-box">
            <h3>@selectedUser.FullName</h3>
            <form method="post" action="/api/login">
                <input type="hidden" name="userId" value="@selectedUser.Id" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                @if (selectedUser.HasCode)
                {
                    <label>Κωδικός</label>
                    <input type="password" name="password" autocomplete="current-password" autofocus required />
                }
                <button type="submit">Είσοδος</button>
            </form>
            <button class="linkbtn-plain" @onclick="() => selectedUser = null">&larr; Πίσω</button>
        </div>
    }

    <a class="admin-link nav-button" href="/">&larr; Αρχική</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool HasError => Error == "1";
    private bool CanBootstrapAdmin { get; set; }

    private List<User> users = new();
    private User? selectedUser;

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authentication.User;
        CanBootstrapAdmin = principal.Identity?.IsAuthenticated == true && principal.IsInRole("Store") &&
            string.Equals(principal.FindFirst("cloud_user_role")?.Value, Role.Admin.ToString(), StringComparison.OrdinalIgnoreCase);
        using var db = await DbFactory.CreateDbContextAsync();
        users = await db.Users.Where(u => u.IsActive && !u.IsCloudIdentity && u.Role == Role.Admin).OrderBy(u => u.FirstName).ToListAsync();
    }

    private void SelectUser(User u) => selectedUser = u;

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }
}
