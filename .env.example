# Safe defaults only. Add the required Dockhand secrets in its Environment settings.
CLOUD_IMAGE_TAG=latest
CLOUD_TRUSTED_PROXY_ADDRESSES=
POSTGRES_DB=restaurant_cloud
POSTGRES_ADMIN_USER=restaurant_cloud_admin
CLOUD_APP_USER=restaurant_cloud_app

# Required in Dockhand (do not commit actual values):
# LICENSE_MANAGER_EMAIL
# LICENSE_MANAGER_PASSWORD_SECRET
# POSTGRES_ADMIN_PASSWORD_SECRET
# CLOUD_APP_PASSWORD_SECRET
# CLOUD_WEB_SYNC_TOKEN_SECRET

# HTTPS will be routed through the existing Nginx Proxy Manager after the HTTP check.
# Set CLOUD_TRUSTED_PROXY_ADDRESSES to the proxy's source IPv4 before HTTPS login is enabled.
